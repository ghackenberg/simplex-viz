---
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_META, withBase } from '../site/url';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
  fullViewport?: boolean;
}

const {
  title = SITE_META.defaultTitle,
  description = SITE_META.defaultDescription,
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  ogImage = '/og-preview.png',
  ogImageAlt = 'SimplexViz 60-degree simplex triangulation engine with OKLab colors and hierarchical 1:4 zoom',
  publishedTime,
  jsonLd,
  fullViewport = false,
} = Astro.props;

const fullTitle =
  title === SITE_META.defaultTitle ? title : `${title} — ${SITE_META.name}`;
const canonicalUrl = new URL(canonicalPath, SITE_META.canonicalOrigin).toString();
const ogImageUrl = new URL(
  withBase(ogImage),
  SITE_META.canonicalOrigin,
).toString();

const structuredData = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: SITE_META.name,
  version: SITE_META.version,
  codeRepository: SITE_META.repoUrl,
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  url: canonicalUrl,
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_META.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/icon-192.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="SimplexViz Notes Feed"
      href={withBase('/rss.xml')}
    />
    <link
      rel="alternate"
      type="text/plain"
      title="SimplexViz LLM Documentation Index"
      href={withBase('/llms.txt')}
    />
    <meta name="theme-color" content="#F8FAFC" />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = window.localStorage.getItem('simplex-theme');
        } catch (_e) {}
        var systemDark =
          typeof window !== 'undefined' &&
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        var mode =
          stored === 'light' || stored === 'dark' || stored === 'auto'
            ? stored
            : window.__simplexThemeMode || 'auto';
        window.__simplexThemeMode = mode;
        var isDark = mode === 'dark' ? true : mode === 'light' ? false : Boolean(systemDark);
        root.classList.toggle('dark', isDark);
        root.dataset.themeMode = mode;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', isDark ? '#07090E' : '#F8FAFC');
        }
        window.__setSimplexTheme = function (nextMode) {
          window.__simplexThemeMode = nextMode;
          try {
            window.localStorage.setItem('simplex-theme', nextMode);
          } catch (_e) {}
          var mqDark =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var resolvedDark =
            nextMode === 'dark' ? true : nextMode === 'light' ? false : Boolean(mqDark);
          root.classList.toggle('dark', resolvedDark);
          root.dataset.themeMode = nextMode;
          if (meta) {
            meta.setAttribute('content', resolvedDark ? '#07090E' : '#F8FAFC');
          }
          window.dispatchEvent(
            new CustomEvent('simplex-theme-change', {
              detail: { mode: nextMode, dark: resolvedDark },
            }),
          );
        };
      })();
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <script>
      import { initPlausibleAnalytics } from '../site/analytics';
      initPlausibleAnalytics();
    </script>
  </head>
  <body
    class:list={[
      'bg-slate-50 text-slate-900 dark:bg-[#07090E] dark:text-slate-100 antialiased selection:bg-cyan-500/25 selection:text-cyan-950 dark:selection:text-cyan-100',
      fullViewport ? 'flex h-[100dvh] flex-col overflow-hidden' : 'flex min-h-screen flex-col',
    ]}
  >
    <SiteHeader currentPath={Astro.url.pathname} fullWidth={fullViewport} />
    <main class:list={[fullViewport ? 'flex min-h-0 flex-1 flex-col overflow-hidden' : 'flex-1']}>
      <slot />
    </main>
    <SiteFooter compact={fullViewport} fullWidth={fullViewport} />
  </body>
</html>
