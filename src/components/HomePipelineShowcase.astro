          <!-- Right / Bottom: Choreographed Single-Stage Editorial Pane -->
          <div class="relative flex min-h-0 flex-col justify-center overflow-hidden px-5 py-4 sm:px-8 sm:py-6 landscape:col-span-6 lg:px-10">
            <div class="grid">
              {
                STAGE_CHAPTERS.map((chapter) => (
                  <article
                    data-stage={chapter.stage}
