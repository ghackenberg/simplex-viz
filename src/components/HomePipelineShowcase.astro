---
import {
  getStrategiesByStage,
  type CanonicalStrategySpec,
} from '../site/strategies';
import { withBase } from '../site/url';

interface StageChapterMeta {
  readonly stage: 1 | 2 | 3 | 4 | 5;
  readonly num: string;
  readonly title: string;
  readonly description: string;
  readonly href: string;
  readonly strategies: readonly CanonicalStrategySpec[];
}

const STAGE_CHAPTERS: readonly StageChapterMeta[] = [
  {
    stage: 1,
    num: '01',
    title: 'Mesh Triangulation',
    description:
      'Constructs an exact 60° equilateral triangular lattice matched to viewport proportions—or locks a fixed grid—before placing any data.',
    href: withBase('/docs/stage-1-mesh'),
    strategies: getStrategiesByStage(1),
  },
  {
    stage: 2,
    num: '02',
    title: 'Simplex Projection',
    description:
      'Projects tag sets, dense embeddings, or arbitrary pairwise similarities S(a, b) into planar barycentric weights w₁ + w₂ + w₃ = 1.',
    href: withBase('/docs/stage-2-clustering'),
    strategies: getStrategiesByStage(2),
  },
  {
    stage: 3,
    num: '03',
    title: 'OKLab Color',
    description:
      'Assigns vertex hues for maximal perceptual ΔE_OK separation across edges and interpolates bridge nodes in OKLab without muddy midtones.',
    href: withBase('/docs/stage-3-color'),
    strategies: getStrategiesByStage(3),
  },
  {
    stage: 4,
    num: '04',
    title: 'Convex Layout',
    description:
      'Fans dense node clusters into open triangle territory and resolves exact convex Minimum Translation Vectors for guaranteed 0.0 px overlap.',
    href: withBase('/docs/stage-4-layout'),
    strategies: getStrategiesByStage(4),
  },
  {
    stage: 5,
    num: '05',
    title: 'Conformal Zoom',
    description:
      'Subdivides crowded triangles 1:4 along edge midpoints without flipping parent orientation, re-clusters local subspaces, or supports free camera pan & pinch.',
    href: withBase('/docs/stage-5-zoom'),
    strategies: getStrategiesByStage(5),
  },
];
---

<section
  id="architecture"
  aria-labelledby="architecture-heading"
  class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8"
>
  <!-- Clean Section Header without bottom divider rule -->
  <div class="max-w-xl">
    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
      Composable Architecture
    </p>
    <h2
      id="architecture-heading"
      class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]"
    >
      Five independent stages with named strategies
    </h2>
  </div>

  <!-- Continuous Vertical Pipeline Spine + Input, Framed Stages & Output -->
  <ol class="mt-8 sm:mt-10">
    {/* Initial Pipeline Input Medallion (Database Icon) + Compact Non-Clickable Card */}
    <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-5 lg:gap-x-6">
      <div aria-hidden="true" class="relative z-10 flex flex-col items-center">
        <div class="h-[15px] sm:h-[19px] w-[2px] bg-transparent" />

        <div class="relative flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full border border-cyan-600 bg-cyan-600 text-white shadow-[0_0_0_3px_rgba(8,145,178,0.14)] dark:border-cyan-400 dark:bg-cyan-400 dark:text-slate-950 dark:shadow-[0_0_0_3px_rgba(34,211,238,0.16)]">
          <svg
            width="18"
            height="18"
            viewBox="0 0 20 20"
            fill="none"
            class="block"
          >
            <ellipse
              cx="10"
              cy="5.5"
              rx="5.75"
              ry="2.25"
              stroke="currentColor"
              stroke-width="1.6"
            />
            <path
              d="M4.25 5.5V14.5C4.25 15.74 6.82 16.75 10 16.75C13.18 16.75 15.75 15.74 15.75 14.5V5.5"
              stroke="currentColor"
              stroke-width="1.6"
            />
            <path
              d="M4.25 10C4.25 11.24 6.82 12.25 10 12.25C13.18 12.25 15.75 11.24 15.75 10"
              stroke="currentColor"
              stroke-width="1.6"
            />
          </svg>
          <span class="pointer-events-none absolute top-1/2 left-[calc(100%+1px)] h-[1.5px] w-3 sm:w-5 lg:w-6 -translate-y-1/2 bg-gradient-to-r from-cyan-600/80 to-cyan-600/45 dark:from-cyan-400/80 dark:to-cyan-400/45" />
        </div>

        <div class="w-[2px] flex-1 bg-gradient-to-b from-cyan-600/75 to-cyan-500/65 dark:from-cyan-400/65 dark:to-cyan-400/55" />
      </div>

      <div class="min-w-0 pb-6 sm:pb-8">
        <div class="relative rounded-xl border border-dashed border-cyan-600/45 bg-gradient-to-br from-white via-cyan-50/35 to-cyan-50/80 p-5 sm:p-6 dark:border-cyan-400/40 dark:from-[#0B0F17] dark:via-cyan-950/15 dark:to-cyan-950/35">
          {/* Exact border-centered anchor pin aligned to heading vertical center */}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute top-[32px] sm:top-[38px] -left-[0.5px] z-20 h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-600 dark:bg-cyan-400"
          />

          {/* Subtle Canvas Frame + Structured Dataset Backdrop */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 overflow-hidden rounded-xl"
          >
            <div class="sv-stage-bg-mask absolute inset-y-0 right-0 flex w-[76%] sm:w-[60%] md:w-[50%] lg:w-[44%] items-center justify-end opacity-70 dark:opacity-60">
              <svg
                class="h-full w-full select-none"
                viewBox="0 0 360 180"
                preserveAspectRatio="xMaxYMid slice"
              >
                {/* Dashed Viewport Canvas Bounds + Corner Dimension Ticks */}
                <rect
                  x="114"
                  y="22"
                  width="216"
                  height="136"
                  rx="8"
                  fill="none"
                  class="stroke-cyan-700/25 dark:stroke-cyan-300/25"
                  stroke-width="1.3"
                  stroke-dasharray="4 3"
                />
                <g class="stroke-slate-400/45 dark:stroke-slate-600/45" stroke-width="1.1" fill="none">
                  <line x1="114" y1="12" x2="330" y2="12" />
                  <line x1="114" y1="8" x2="114" y2="16" />
                  <line x1="330" y1="8" x2="330" y2="16" />
                  <line x1="340" y1="22" x2="340" y2="158" />
                  <line x1="336" y1="22" x2="344" y2="22" />
                  <line x1="336" y1="158" x2="344" y2="158" />
                </g>

                {/* Dataset Records Inside Canvas */}
                <g class="stroke-cyan-700/18 dark:stroke-cyan-300/18" stroke-width="1.1" fill="none">
                  <rect x="132" y="38" width="180" height="24" rx="5" fill="#06B6D4" fill-opacity="0.05" />
                  <rect x="132" y="78" width="180" height="24" rx="5" fill="#F59E0B" fill-opacity="0.04" />
                  <rect x="132" y="118" width="180" height="24" rx="5" fill="#D946EF" fill-opacity="0.05" />
                </g>
                <circle cx="148" cy="50" r="4" fill="#06B6D4" fill-opacity="0.65" />
                <circle cx="148" cy="90" r="4" fill="#F59E0B" fill-opacity="0.65" />
                <circle cx="148" cy="130" r="4" fill="#D946EF" fill-opacity="0.65" />
                <g class="stroke-slate-400/50 dark:stroke-slate-600/50" stroke-width="2.6" stroke-linecap="round">
                  <line x1="164" y1="50" x2="222" y2="50" />
                  <line x1="234" y1="50" x2="268" y2="50" />
                  <line x1="280" y1="50" x2="298" y2="50" />
                  <line x1="164" y1="90" x2="210" y2="90" />
                  <line x1="222" y1="90" x2="254" y2="90" />
                  <line x1="164" y1="130" x2="234" y2="130" />
                  <line x1="246" y1="130" x2="268" y2="130" />
                </g>

                {/* Subtle Interaction Event: Pointer & Click Ripple */}
                <circle
                  cx="286"
                  cy="104"
                  r="10"
                  fill="none"
                  stroke="#06B6D4"
                  stroke-opacity="0.45"
                  stroke-width="1.2"
                  stroke-dasharray="2.5 2.5"
                />
                <circle
                  cx="286"
                  cy="104"
                  r="18"
                  fill="none"
                  stroke="#06B6D4"
                  stroke-opacity="0.22"
                  stroke-width="1"
                  stroke-dasharray="3 3"
                />
                <path
                  d="M286 104 L286 121 L290.5 117 L294 123.5 L296.8 122 L293.3 115.5 L298.8 115 Z"
                  class="fill-slate-700/75 stroke-white dark:fill-cyan-300/85 dark:stroke-[#0B0F17]"
                  stroke-width="1"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between gap-3 sm:gap-4">
              <h3 class="text-[15px] leading-6 sm:text-xl sm:leading-7 font-semibold tracking-tight text-slate-950 dark:text-white">
                Dataset, Canvas &amp; Events
              </h3>
              <span class="shrink-0 font-mono text-[11px] font-medium text-cyan-700/85 dark:text-cyan-300/85">
                Input
              </span>
            </div>
          </div>
        </div>
      </div>
    </li>

    {
      STAGE_CHAPTERS.map((chapter) => (
        <li class="group/row grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-5 lg:gap-x-6">
          {/* Left Continuous Directional Flow Spine & Anchor Node */}
          <div aria-hidden="true" class="relative z-10 flex flex-col items-center">
            <div class="h-[15px] sm:h-[19px] w-[2px] bg-cyan-500/65 dark:bg-cyan-400/55" />

            <div class="relative flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full border border-cyan-500/65 bg-white font-mono text-xs sm:text-[13px] font-bold text-cyan-800 transition-colors group-has-[[data-stage-card]:hover]/row:border-cyan-500 group-has-[[data-stage-card]:hover]/row:text-cyan-700 dark:border-cyan-400/60 dark:bg-[#0B0F17] dark:text-cyan-300 dark:group-has-[[data-stage-card]:hover]/row:border-cyan-400 dark:group-has-[[data-stage-card]:hover]/row:text-cyan-200 tabular-nums">
              <span>{chapter.num}</span>
              <span class="pointer-events-none absolute top-1/2 left-[calc(100%+1px)] h-[1.5px] w-3 sm:w-5 lg:w-6 -translate-y-1/2 bg-gradient-to-r from-cyan-500/75 to-slate-300/90 transition-colors group-has-[[data-stage-card]:hover]/row:from-cyan-500 group-has-[[data-stage-card]:hover]/row:to-cyan-500/80 dark:from-cyan-400/70 dark:to-slate-700 dark:group-has-[[data-stage-card]:hover]/row:from-cyan-400 dark:group-has-[[data-stage-card]:hover]/row:to-cyan-400/80" />
            </div>

            <div class="w-[2px] flex-1 bg-gradient-to-b from-cyan-500/70 via-cyan-500/35 to-cyan-500/65 dark:from-cyan-400/60 dark:via-cyan-400/30 dark:to-cyan-400/55" />
          </div>

            {/* Right Anchored Stage Card with Subtle Faded Background Visualization */}
            <div class="min-w-0 pb-6 sm:pb-8">
              <div
                data-stage-card
                class="group/stage relative rounded-xl border border-slate-200/90 bg-white p-5 sm:p-6 transition-colors hover:border-cyan-500/70 has-[h3>a:focus-visible]:ring-2 has-[h3>a:focus-visible]:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60"
              >
                {/* Exact border-centered anchor pin aligned to heading vertical center */}
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-[32px] sm:top-[38px] -left-[0.5px] z-20 h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-600 transition-transform group-hover/stage:scale-125 dark:bg-cyan-400"
                />

                {/* Clipped Right-Anchored Background Vector Backdrop */}
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 overflow-hidden rounded-xl"
                >
                  <div class="sv-stage-bg-mask absolute inset-y-0 right-0 flex w-[76%] sm:w-[60%] md:w-[50%] lg:w-[44%] items-center justify-end opacity-65 transition-opacity duration-300 group-hover/stage:opacity-95 dark:opacity-55 dark:group-hover/stage:opacity-85">
                    {chapter.stage === 1 && (
                      <svg
                        class="h-full w-full select-none"
                        viewBox="0 0 360 180"
                        preserveAspectRatio="xMaxYMid slice"
                      >
                        <g class="stroke-slate-200/95 dark:stroke-slate-800/95" stroke-width="1.15" fill="none">
                          <polygon points="104,16 56,99 152,99" />
                          <polygon points="200,16 152,99 248,99" />
                          <polygon points="296,16 248,99 344,99" />
                          <polygon points="104,16 200,16 152,99" />
                          <polygon points="200,16 296,16 248,99" />
                          <polygon points="56,99 8,182 104,182" />
                          <polygon points="152,99 104,182 200,182" />
                          <polygon points="248,99 200,182 296,182" />
                          <polygon points="344,99 296,182 392,182" />
                          <polygon points="56,99 152,99 104,182" />
                          <polygon points="248,99 344,99 296,182" />
                        </g>
                        <polygon
                          points="152,99 248,99 200,182"
                          fill="#06B6D4"
                          fill-opacity="0.06"
                          stroke="#06B6D4"
                          stroke-opacity="0.38"
                          stroke-width="1.5"
                        />
                        <polygon
                          points="200,16 152,99 248,99"
                          fill="#06B6D4"
                          fill-opacity="0.09"
                          stroke="#06B6D4"
                          stroke-opacity="0.55"
                          stroke-width="1.8"
                        />
                        <path
                          d="M 186 40 A 28 28 0 0 0 214 40"
                          fill="none"
                          stroke="#06B6D4"
                          stroke-opacity="0.6"
                          stroke-width="1.5"
                        />
                        <circle cx="200" cy="16" r="4" fill="#06B6D4" fill-opacity="0.65" />
                        <circle cx="152" cy="99" r="3.5" fill="#F59E0B" fill-opacity="0.65" />
                        <circle cx="248" cy="99" r="3.5" fill="#D946EF" fill-opacity="0.65" />
                      </svg>
                    )}

                    {chapter.stage === 2 && (
                      <svg
                        class="h-full w-full select-none"
                        viewBox="0 0 360 180"
                        preserveAspectRatio="xMaxYMid slice"
                      >
                        <polygon
                          points="226,18 134,164 318,164"
                          class="fill-cyan-500/[0.03] stroke-slate-200 dark:fill-cyan-400/[0.04] dark:stroke-slate-800"
                          stroke-width="1.6"
                        />
                        <g class="stroke-slate-300/80 dark:stroke-slate-700/80" stroke-width="1.1" stroke-dasharray="3 3" fill="none">
                          <line x1="226" y1="18" x2="226" y2="104" />
                          <line x1="134" y1="164" x2="226" y2="104" />
                          <line x1="318" y1="164" x2="226" y2="104" />
                        </g>
                        <g fill="none" stroke-width="1.4" stroke-dasharray="4 4" opacity="0.55">
                          <path d="M 30 44 C 95 44 132 76 180 91" stroke="#06B6D4" />
                          <path d="M 30 98 C 102 98 158 102 226 104" stroke="#F59E0B" />
                          <path d="M 30 148 C 122 152 204 152 282 142" stroke="#D946EF" />
                        </g>
                        <circle cx="226" cy="18" r="5" fill="#06B6D4" fill-opacity="0.55" />
                        <circle cx="134" cy="164" r="5" fill="#F59E0B" fill-opacity="0.55" />
                        <circle cx="318" cy="164" r="5" fill="#D946EF" fill-opacity="0.55" />
                        <circle cx="180" cy="91" r="4.5" fill="#14B8A6" fill-opacity="0.7" />
                        <circle cx="226" cy="104" r="5.5" fill="#F59E0B" fill-opacity="0.7" />
                        <circle cx="282" cy="142" r="4.5" fill="#D946EF" fill-opacity="0.7" />
                      </svg>
                    )}

                    {chapter.stage === 3 && (
                      <svg
                        class="h-full w-full select-none"
                        viewBox="0 0 360 180"
                        preserveAspectRatio="xMaxYMid slice"
                      >
                        <defs>
                          <clipPath id="sv-bg-s3-clip">
                            <polygon points="222,18 128,162 316,162" />
                          </clipPath>
                          <radialGradient id="sv-bg-s3-c1" cx="222" cy="18" r="165" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.28" />
                            <stop offset="72%" stop-color="#06B6D4" stop-opacity="0" />
                          </radialGradient>
                          <radialGradient id="sv-bg-s3-c2" cx="128" cy="162" r="165" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.26" />
                            <stop offset="72%" stop-color="#F59E0B" stop-opacity="0" />
                          </radialGradient>
                          <radialGradient id="sv-bg-s3-c3" cx="316" cy="162" r="165" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#D946EF" stop-opacity="0.26" />
                            <stop offset="72%" stop-color="#D946EF" stop-opacity="0" />
                          </radialGradient>
                          <linearGradient id="sv-bg-s3-e1" x1="222" y1="18" x2="128" y2="162" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#06B6D4" />
                            <stop offset="100%" stop-color="#F59E0B" />
                          </linearGradient>
                          <linearGradient id="sv-bg-s3-e2" x1="222" y1="18" x2="316" y2="162" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#06B6D4" />
                            <stop offset="100%" stop-color="#D946EF" />
                          </linearGradient>
                          <linearGradient id="sv-bg-s3-e3" x1="128" y1="162" x2="316" y2="162" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#F59E0B" />
                            <stop offset="100%" stop-color="#D946EF" />
                          </linearGradient>
                        </defs>
                        <g clip-path="url(#sv-bg-s3-clip)">
                          <rect x="120" y="10" width="204" height="160" fill="url(#sv-bg-s3-c1)" />
                          <rect x="120" y="10" width="204" height="160" fill="url(#sv-bg-s3-c2)" />
                          <rect x="120" y="10" width="204" height="160" fill="url(#sv-bg-s3-c3)" />
                        </g>
                        <g stroke-width="2" stroke-opacity="0.55" stroke-linecap="round">
                          <line x1="222" y1="18" x2="128" y2="162" stroke="url(#sv-bg-s3-e1)" />
                          <line x1="222" y1="18" x2="316" y2="162" stroke="url(#sv-bg-s3-e2)" />
                          <line x1="128" y1="162" x2="316" y2="162" stroke="url(#sv-bg-s3-e3)" />
                        </g>
                        <circle cx="222" cy="18" r="6" fill="#06B6D4" fill-opacity="0.65" />
                        <circle cx="128" cy="162" r="6" fill="#F59E0B" fill-opacity="0.65" />
                        <circle cx="316" cy="162" r="6" fill="#D946EF" fill-opacity="0.65" />
                        <circle cx="175" cy="90" r="5" fill="#10B981" fill-opacity="0.6" />
                        <circle cx="269" cy="90" r="5" fill="#8B5CF6" fill-opacity="0.6" />
                        <circle cx="222" cy="162" r="5" fill="#EC4899" fill-opacity="0.6" />
                        <circle cx="222" cy="112" r="8" fill="#14B8A6" fill-opacity="0.6" />
                      </svg>
                    )}

                    {chapter.stage === 4 && (
                      <svg
                        class="h-full w-full select-none"
                        viewBox="0 0 360 180"
                        preserveAspectRatio="xMaxYMid slice"
                      >
                        <polygon
                          points="226,16 124,164 328,164"
                          class="fill-cyan-500/[0.03] stroke-slate-200 dark:stroke-slate-800"
                          stroke-width="1.5"
                        />
                        <polygon
                          points="226,38 148,150 304,150"
                          fill="none"
                          stroke="#06B6D4"
                          stroke-opacity="0.32"
                          stroke-width="1.2"
                          stroke-dasharray="4 3"
                        />
                        <line x1="226" y1="88" x2="226" y2="144" class="stroke-emerald-500/45 dark:stroke-emerald-400/40" stroke-width="1.2" stroke-dasharray="3 3" />
                        <line x1="176" y1="116" x2="276" y2="116" class="stroke-emerald-500/45 dark:stroke-emerald-400/40" stroke-width="1.2" stroke-dasharray="3 3" />

                        <circle cx="226" cy="70" r="11" fill="#D946EF" fill-opacity="0.1" stroke="#D946EF" stroke-opacity="0.55" stroke-width="1.3" />
                        <rect x="172" y="96" width="38" height="15" rx="7.5" fill="#06B6D4" fill-opacity="0.1" stroke="#06B6D4" stroke-opacity="0.55" stroke-width="1.3" />
                        <circle cx="254" cy="103" r="10" fill="#F59E0B" fill-opacity="0.1" stroke="#F59E0B" stroke-opacity="0.55" stroke-width="1.3" />
                        <circle cx="192" cy="134" r="10" fill="#38BDF8" fill-opacity="0.1" stroke="#38BDF8" stroke-opacity="0.55" stroke-width="1.3" />
                        <rect x="236" y="124" width="42" height="16" rx="4" fill="#10B981" fill-opacity="0.1" stroke="#10B981" stroke-opacity="0.55" stroke-width="1.3" />
                      </svg>
                    )}

                    {chapter.stage === 5 && (
                      <svg
                        class="h-full w-full select-none"
                        viewBox="0 0 360 180"
                        preserveAspectRatio="xMaxYMid slice"
                      >
                        <g class="stroke-slate-300/70 dark:stroke-slate-700/70" stroke-width="1.1" fill="none">
                          <polygon points="74,58 50,98 98,98" stroke="#06B6D4" stroke-opacity="0.5" />
                          <line x1="74" y1="58" x2="226" y2="18" stroke-dasharray="4 4" />
                          <line x1="98" y1="98" x2="316" y2="162" stroke-dasharray="4 4" />
                        </g>
                        <polygon
                          points="226,18 136,162 316,162"
                          fill="#06B6D4"
                          fill-opacity="0.05"
                          stroke="#06B6D4"
                          stroke-opacity="0.5"
                          stroke-width="1.6"
                        />
                        <polygon
                          points="181,90 271,90 226,162"
                          fill="#F59E0B"
                          fill-opacity="0.06"
                          stroke="#F59E0B"
                          stroke-opacity="0.5"
                          stroke-width="1.4"
                          stroke-dasharray="4 3"
                        />
                        <circle cx="226" cy="18" r="4.5" fill="#06B6D4" fill-opacity="0.65" />
                        <circle cx="136" cy="162" r="4.5" fill="#F59E0B" fill-opacity="0.65" />
                        <circle cx="316" cy="162" r="4.5" fill="#D946EF" fill-opacity="0.65" />
                        <circle cx="226" cy="64" r="4.5" fill="#06B6D4" fill-opacity="0.65" />
                        <circle cx="181" cy="136" r="4.5" fill="#F59E0B" fill-opacity="0.65" />
                        <circle cx="271" cy="136" r="4.5" fill="#D946EF" fill-opacity="0.65" />
                        <circle cx="226" cy="112" r="5" fill="#38BDF8" fill-opacity="0.65" />
                      </svg>
                    )}
                  </div>
                </div>

                {/* Foreground Stage Typography & Interactive Badges */}
                <div class="relative z-10">
                  <div class="flex items-center justify-between gap-4">
                    <h3 class="text-base leading-6 sm:text-xl sm:leading-7 font-semibold tracking-tight text-slate-950 dark:text-white">
                      <a
                        href={chapter.href}
                        class="transition-colors group-hover/stage:text-cyan-700 dark:group-hover/stage:text-cyan-300 after:absolute after:inset-0 after:z-0 after:rounded-xl focus-visible:outline-none"
                      >
                        {chapter.title}
                      </a>
                    </h3>
                    <span
                      aria-hidden="true"
                      class="shrink-0 text-sm font-semibold text-slate-400 transition-all group-hover/stage:translate-x-0.5 group-hover/stage:text-cyan-700 dark:text-slate-500 dark:group-hover/stage:text-cyan-300"
                    >
                      →
                    </span>
                  </div>

                  <p class="mt-2 max-w-2xl text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                    {chapter.description}
                  </p>

                  <div
                    aria-label={`${chapter.title} strategies`}
                    class="relative z-10 mt-3.5 flex flex-wrap gap-1.5"
                  >
                    {chapter.strategies.map((spec) => (
                      <a
                        href={withBase(spec.strategyDocPath)}
                        title={spec.name}
                        data-default-strategy={spec.isDefault ? 'true' : 'false'}
                        class:list={[
                          'group inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 whitespace-nowrap shrink-0',
                          spec.isDefault
                            ? 'border-cyan-500/75 bg-cyan-500/[0.11] font-semibold text-cyan-900 hover:border-cyan-600 hover:bg-cyan-500/[0.18] hover:text-cyan-950 dark:border-cyan-400/60 dark:bg-cyan-400/[0.12] dark:text-cyan-200 dark:hover:border-cyan-300 dark:hover:bg-cyan-400/[0.2] dark:hover:text-white'
                            : 'border-slate-200/90 bg-slate-50/85 font-medium text-slate-700 hover:border-cyan-500/60 hover:bg-cyan-50/90 hover:text-cyan-900 dark:border-slate-800 dark:bg-[#07090E] dark:text-slate-300 dark:hover:border-cyan-400/55 dark:hover:bg-cyan-950/60 dark:hover:text-cyan-200',
                        ]}
                      >
                        <span>{spec.shortName}</span>
                        {spec.isDefault && (
                          <span class="rounded bg-cyan-600/12 px-1 py-[1px] font-mono text-[10px] font-semibold text-cyan-800 transition-colors group-hover:bg-cyan-600/20 group-hover:text-cyan-950 dark:bg-cyan-400/15 dark:text-cyan-200 dark:group-hover:bg-cyan-400/25 dark:group-hover:text-white">
                            Default
                          </span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))
    }

    {/* Terminal Pipeline Output (Visually Distinct, Non-Clickable) */}
