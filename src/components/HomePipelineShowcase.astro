                    class="sv-stage-copy relative flex flex-col justify-center"
                  >
                    <!-- Architectural Oversized Watermark Numeral -->
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute -top-2 right-0 hidden sm:block font-mono text-6xl lg:text-7xl font-bold tracking-tighter text-slate-900/[0.045] select-none dark:text-white/[0.04]"
