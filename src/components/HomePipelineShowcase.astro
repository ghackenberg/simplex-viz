---
import {
  ALL_STRATEGY_IDS,
  getStrategiesByStage,
  type CanonicalStrategySpec,
} from '../site/strategies';
import { withBase } from '../site/url';

interface StageChapterMeta {
  readonly stage: 1 | 2 | 3 | 4 | 5;
  readonly num: string;
  readonly title: string;
  readonly shortTab: string;
  readonly description: string;
  readonly href: string;
  readonly strategies: readonly CanonicalStrategySpec[];
}

const STAGE_CHAPTERS: readonly StageChapterMeta[] = [
  {
    stage: 1,
    num: '01',
    title: 'Mesh Triangulation',
    shortTab: 'Mesh',
    description:
      'Constructs an exact 60° equilateral triangular lattice matched to viewport proportions—or locks a fixed grid—before placing any data.',
    href: withBase('/docs/stage-1-mesh'),
    strategies: getStrategiesByStage(1),
  },
  {
    stage: 2,
    num: '02',
    title: 'Simplex Projection',
    shortTab: 'Project',
    description:
      'Projects tag sets, dense embeddings, or arbitrary pairwise similarities S(a, b) into planar barycentric weights w₁ + w₂ + w₃ = 1.',
    href: withBase('/docs/stage-2-clustering'),
    strategies: getStrategiesByStage(2),
  },
  {
    stage: 3,
    num: '03',
    title: 'OKLab Color',
    shortTab: 'Color',
    description:
      'Assigns vertex hues for maximal perceptual ΔE_OK separation across edges and interpolates bridge nodes in OKLab without muddy midtones.',
    href: withBase('/docs/stage-3-color'),
    strategies: getStrategiesByStage(3),
  },
  {
    stage: 4,
    num: '04',
    title: 'Convex Layout',
    shortTab: 'Layout',
    description:
      'Fans dense node clusters into open triangle territory and resolves exact convex Minimum Translation Vectors for guaranteed 0.0 px overlap.',
    href: withBase('/docs/stage-4-layout'),
    strategies: getStrategiesByStage(4),
  },
  {
    stage: 5,
    num: '05',
    title: 'Conformal Zoom',
    shortTab: 'Zoom',
    description:
      'Subdivides crowded triangles 1:4 along edge midpoints without flipping parent orientation, re-clusters local subspaces, or supports free camera pan & pinch.',
    href: withBase('/docs/stage-5-zoom'),
    strategies: getStrategiesByStage(5),
  },
];
---

<section
  id="architecture"
  data-pipeline-showcase
  data-active-stage="1"
  data-inview="false"
  aria-labelledby="architecture-heading"
  class="pt-14 pb-12 sm:pt-20 sm:pb-16"
>
  <!-- Section Header matching Examples & Latest Notes -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-xl">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Composable Architecture
        </p>
        <h2
          id="architecture-heading"
          class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]"
        >
          Five independent stages with named strategies
        </h2>
      </div>
      <a
        href={withBase('/docs/strategies')}
        class="text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap shrink-0"
      >
        Browse all {ALL_STRATEGY_IDS.length} strategies →
      </a>
    </div>
  </div>

  <!-- Scroll Runway for Pinned Studio Viewport -->
  <div
    data-pipeline-runway
    class="relative mt-6 h-[280dvh] min-h-[1450px] max-h-[2600px] sm:mt-8"
  >
    <div
      data-pipeline-sticky
      class="sticky top-14 mx-auto flex h-[min(calc(100dvh-3.5rem),43rem)] max-w-7xl flex-col px-3 py-2 sm:px-6 sm:py-3 lg:px-8"
    >
      <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-[0_24px_60px_-24px_rgba(15,23,42,0.16),inset_0_1px_0_0_rgba(255,255,255,0.7)] dark:border-slate-800/90 dark:bg-[#0B0F17] dark:shadow-[0_28px_72px_-24px_rgba(6,182,212,0.16),inset_0_1px_0_0_rgba(255,255,255,0.06)]">
        <!-- Minimal Architectural Stage Step Rail + Scroll Progress Hairline -->
        <div class="relative shrink-0 border-b border-slate-200/80 bg-slate-50/90 px-3 py-2 sm:px-5 sm:py-2.5 dark:border-slate-800/80 dark:bg-[#0E131D]/95">
          <div
            role="tablist"
            aria-label="Pipeline stages"
            class="mx-auto grid w-full max-w-xl grid-cols-5 gap-1.5"
          >
            {
              STAGE_CHAPTERS.map((item) => (
                <button
                  type="button"
                  role="tab"
                  data-stage-tab={item.stage}
                  aria-selected={item.stage === 1 ? 'true' : 'false'}
                  data-active={item.stage === 1 ? 'true' : 'false'}
                  data-completed="false"
                  class="group relative flex h-8 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-transparent px-2 text-xs font-medium text-slate-500 transition-all whitespace-nowrap shrink-0 hover:bg-white/75 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 data-[completed=true]:text-slate-700 data-[active=true]:border-slate-200/90 data-[active=true]:bg-white data-[active=true]:font-semibold data-[active=true]:text-slate-950 data-[active=true]:shadow-xs dark:text-slate-400 dark:hover:bg-slate-800/50 dark:hover:text-slate-100 dark:data-[completed=true]:text-slate-300 dark:data-[active=true]:border-cyan-400/35 dark:data-[active=true]:bg-[#0B0F17] dark:data-[active=true]:text-cyan-200"
                >
                  <span
                    class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors group-data-[completed=true]:bg-cyan-500/70 group-data-[active=true]:bg-cyan-500 dark:bg-slate-700 dark:group-data-[completed=true]:bg-cyan-400/60 dark:group-data-[active=true]:bg-cyan-400"
                    aria-hidden="true"
                  />
                  <span class="font-mono text-[11px] tabular-nums">{item.num}</span>
                  <span class="hidden sm:inline truncate">{item.shortTab}</span>
                </button>
              ))
            }
          </div>

          <!-- Precision 2px Bottom Conduit Scroll Hairline -->
          <svg
            class="pointer-events-none absolute inset-x-0 bottom-0 block h-[2px] w-full"
            viewBox="0 0 1000 2"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <rect
              data-pipeline-progress
              x="0"
              y="0"
              width="1000"
              height="2"
              transform="scale(0.06 1)"
              class="fill-cyan-600 dark:fill-cyan-400"
            />
          </svg>
        </div>

        <!-- Adaptive Orientation Stage Body: Portrait Stacked / Landscape Side-by-Side -->
        <div class="grid min-h-0 flex-1 grid-cols-1 grid-rows-[minmax(0,1fr)_auto] divide-y divide-slate-200/80 landscape:grid-cols-12 landscape:grid-rows-1 landscape:divide-x landscape:divide-y-0 dark:divide-slate-800/80">
          <!-- Left / Top: High-Craft Precision Vector Chamber -->
          <div class="relative flex min-h-0 items-center justify-center overflow-hidden bg-slate-50/75 p-2 sm:p-4 landscape:col-span-6 dark:bg-[#07090E]">
            <svg
              class="h-full w-full max-h-full select-none"
              viewBox="0 0 640 460"
              preserveAspectRatio="xMidYMid meet"
              role="img"
              aria-label="Architectural vector illustration of the active SimplexViz pipeline stage"
            >
              <defs>
                <!-- Subtle Calibrated Instrument Micro-Dot Grid -->
                <pattern id="sv-pipe-dot-matrix" width="24" height="24" patternUnits="userSpaceOnUse">
                  <circle cx="12" cy="12" r="1" class="fill-slate-300/75 dark:fill-slate-700/70" />
                </pattern>
                <radialGradient id="sv-pipe-grid-fade" cx="50%" cy="52%" r="52%">
                  <stop offset="0%" stop-color="#FFFFFF" stop-opacity="1" />
                  <stop offset="68%" stop-color="#FFFFFF" stop-opacity="0.55" />
                  <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
                </radialGradient>
                <mask id="sv-pipe-dot-mask">
                  <rect width="640" height="460" fill="url(#sv-pipe-grid-fade)" />
                </mask>

                <!-- Per-Stage Atmospheric Glows -->
                <radialGradient id="sv-glow-1" cx="50%" cy="52%" r="48%">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.16" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-2" cx="48%" cy="52%" r="50%">
                  <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.14" />
                  <stop offset="55%" stop-color="#D946EF" stop-opacity="0.06" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-3" cx="50%" cy="54%" r="50%">
                  <stop offset="0%" stop-color="#10B981" stop-opacity="0.13" />
                  <stop offset="50%" stop-color="#D946EF" stop-opacity="0.09" />
                  <stop offset="100%" stop-color="#F59E0B" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-4" cx="50%" cy="52%" r="48%">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.15" />
                  <stop offset="55%" stop-color="#10B981" stop-opacity="0.08" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-5" cx="50%" cy="52%" r="46%">
                  <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.14" />
                  <stop offset="55%" stop-color="#06B6D4" stop-opacity="0.10" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>

                <!-- Stage 3 True 3-Vertex OKLab Chromatic Field -->
                <clipPath id="sv-pipe-s3-clip">
                  <polygon points="320,84 144,388 496,388" />
                </clipPath>
                <radialGradient id="sv-oklab-v1" cx="320" cy="84" r="300" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.48" />
                  <stop offset="70%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-oklab-v2" cx="144" cy="388" r="300" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.46" />
                  <stop offset="70%" stop-color="#F59E0B" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-oklab-v3" cx="496" cy="388" r="300" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#D946EF" stop-opacity="0.46" />
                  <stop offset="70%" stop-color="#D946EF" stop-opacity="0" />
                </radialGradient>

                <linearGradient id="sv-pipe-edge-1" x1="320" y1="84" x2="144" y2="388" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" />
                  <stop offset="100%" stop-color="#F59E0B" />
                </linearGradient>
                <linearGradient id="sv-pipe-edge-2" x1="320" y1="84" x2="496" y2="388" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" />
                  <stop offset="100%" stop-color="#D946EF" />
                </linearGradient>
                <linearGradient id="sv-pipe-edge-3" x1="144" y1="388" x2="496" y2="388" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#F59E0B" />
                  <stop offset="100%" stop-color="#D946EF" />
                </linearGradient>
              </defs>

              <!-- Masked Calibrated Micro-Dot Field -->
              <rect width="640" height="460" fill="url(#sv-pipe-dot-matrix)" mask="url(#sv-pipe-dot-mask)" />

              <!-- Corner Registration Crosshairs -->
              <g class="stroke-slate-300 dark:stroke-slate-700/80" stroke-width="1.2" fill="none">
                <path d="M 32 40 L 44 40 M 38 34 L 38 46" />
                <path d="M 596 40 L 608 40 M 602 34 L 602 46" />
                <path d="M 32 420 L 44 420 M 38 414 L 38 426" />
                <path d="M 596 420 L 608 420 M 602 414 L 602 426" />
              </g>

              <!-- Per-Stage Adaptive Atmospheric Glows -->
              <circle cx="320" cy="238" r="215" fill="url(#sv-glow-1)" class="sv-stage-glow" data-glow="1" />
              <circle cx="320" cy="238" r="215" fill="url(#sv-glow-2)" class="sv-stage-glow" data-glow="2" />
              <circle cx="320" cy="242" r="215" fill="url(#sv-glow-3)" class="sv-stage-glow" data-glow="3" />
              <circle cx="320" cy="238" r="215" fill="url(#sv-glow-4)" class="sv-stage-glow" data-glow="4" />
              <circle cx="320" cy="238" r="215" fill="url(#sv-glow-5)" class="sv-stage-glow" data-glow="5" />

              <!-- Scroll-Linked Ambient Compass Rings -->
              <g data-parallax-depth="0.45">
                <g data-parallax-rotate="24" class="stroke-slate-300/65 dark:stroke-slate-800/85" stroke-width="1" fill="none">
                  <circle cx="320" cy="238" r="186" stroke-dasharray="2 8" />
                  <circle cx="320" cy="238" r="134" stroke-dasharray="4 8" />
                  <line x1="68" y1="238" x2="572" y2="238" stroke-dasharray="3 7" />
                  <line x1="320" y1="36" x2="320" y2="430" stroke-dasharray="3 7" />
                </g>
              </g>

              <!-- STAGE 1: Multi-Cell 60° Staggered Hex Lattice -->
              <g class="sv-pipeline-stage-layer" data-stage="1">
                <!-- Peripheral Staggered Hex Field -->
                <g class="stroke-slate-300/70 dark:stroke-slate-800/90" stroke-width="1.2" fill="none">
                  <polygon points="168,94 92,226 244,226" />
                  <polygon points="472,94 396,226 548,226" />
                  <polygon points="92,226 168,358 244,226" />
                  <polygon points="548,226 472,358 396,226" />
                  <polygon points="244,226 168,358 320,358" />
                  <polygon points="396,226 320,358 472,358" />
                </g>

                <!-- Hero Equilateral 60° Simplex -->
                <g class="sv-pipeline-draw" fill="none">
                  <polygon
                    points="320,94 168,358 472,358"
                    stroke="#06B6D4"
                    stroke-width="2"
                    class="fill-cyan-500/[0.06] dark:fill-cyan-400/[0.08]"
                  />
                  <polygon
                    points="244,226 396,226 320,358"
                    class="stroke-cyan-600/45 dark:stroke-cyan-400/45"
                    stroke-width="1.4"
                  />
                  <line x1="320" y1="94" x2="320" y2="358" class="stroke-slate-400/50 dark:stroke-slate-600/60" stroke-width="1.2" stroke-dasharray="4 4" />
                </g>

                <!-- Precision 60° Angle Callout -->
                <path d="M 294 140 A 46 46 0 0 0 346 140" fill="none" stroke="#06B6D4" stroke-width="2.2" stroke-linecap="round" />
                <text x="320" y="164" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" class="fill-cyan-700 dark:fill-cyan-300">60.0°</text>

                <!-- Aspect Fit Framing Brackets -->
                <path d="M 80 100 L 80 76 L 104 76 M 560 100 L 560 76 L 536 76 M 80 356 L 80 380 L 104 380 M 560 356 L 560 380 L 536 380" fill="none" class="stroke-slate-400/80 dark:stroke-slate-600" stroke-width="1.6" stroke-linecap="round" />

                <!-- Illuminated Vertex Nodes -->
                <g class="sv-pipeline-node-pop">
                  <circle cx="244" cy="226" r="5" class="fill-slate-300 dark:fill-slate-700" />
                  <circle cx="396" cy="226" r="5" class="fill-slate-300 dark:fill-slate-700" />
                  <circle cx="320" cy="358" r="5" class="fill-slate-300 dark:fill-slate-700" />

                  <circle cx="320" cy="94" r="20" fill="#06B6D4" fill-opacity="0.14" />
                  <circle cx="320" cy="94" r="13" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="2.6" />
                  <circle cx="320" cy="94" r="4.5" fill="#06B6D4" />

                  <circle cx="168" cy="358" r="20" fill="#F59E0B" fill-opacity="0.14" />
                  <circle cx="168" cy="358" r="13" class="fill-white dark:fill-[#0B0F17]" stroke="#F59E0B" stroke-width="2.6" />
                  <circle cx="168" cy="358" r="4.5" fill="#F59E0B" />

                  <circle cx="472" cy="358" r="20" fill="#D946EF" fill-opacity="0.14" />
                  <circle cx="472" cy="358" r="13" class="fill-white dark:fill-[#0B0F17]" stroke="#D946EF" stroke-width="2.6" />
                  <circle cx="472" cy="358" r="4.5" fill="#D946EF" />
                </g>
              </g>

              <!-- STAGE 2: High-D Cloud to Barycentric Simplex Projection -->
              <g class="sv-pipeline-stage-layer" data-stage="2">
                <!-- Raw Source Embedding Cloud Hulls -->
                <g class="stroke-slate-300/75 dark:stroke-slate-700/80" stroke-width="1.2" fill="none">
                  <ellipse cx="110" cy="236" rx="54" ry="86" stroke-dasharray="4 4" class="fill-slate-200/25 dark:fill-slate-900/40" />
                  <ellipse cx="110" cy="236" rx="30" ry="52" stroke-dasharray="2 4" />
                </g>

                <!-- Target Simplex with Barycentric Isolines -->
                <polygon points="366,86 206,368 526,368" class="sv-pipeline-draw fill-cyan-500/[0.04] stroke-slate-300 dark:fill-slate-900/55 dark:stroke-slate-700" stroke-width="1.8" />
                <g class="stroke-slate-300/55 dark:stroke-slate-700/55" stroke-width="1" fill="none" stroke-dasharray="3 4">
                  <line x1="286" y1="227" x2="446" y2="227" />
                  <line x1="246" y1="297" x2="486" y2="297" />
                  <line x1="366" y1="86" x2="366" y2="368" />
                </g>

                <!-- Source Scatter Nodes -->
                <g class="sv-pipeline-node-pop">
                  <circle cx="94" cy="182" r="5.5" fill="#06B6D4" fill-opacity="0.7" />
                  <circle cx="124" cy="212" r="5" fill="#F59E0B" fill-opacity="0.7" />
                  <circle cx="96" cy="252" r="6" fill="#D946EF" fill-opacity="0.7" />
                  <circle cx="124" cy="288" r="4.5" class="fill-slate-400 dark:fill-slate-600" />
                  <text x="110" y="344" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" class="fill-slate-500 dark:fill-slate-400">R^d vectors</text>
                </g>

                <!-- Continuous Projection Ribbons -->
                <g class="sv-pipeline-flow" fill="none" stroke-width="2" stroke-dasharray="6 4">
                  <path d="M 102 182 C 192 134 268 166 340 218" stroke="#06B6D4" />
                  <path d="M 132 212 C 204 218 268 256 366 266" stroke="#F59E0B" />
                  <path d="M 104 252 C 196 318 320 330 426 306" stroke="#D946EF" />
                </g>

                <!-- Projected Barycentric Interior Cluster -->
                <g class="sv-pipeline-node-pop">
                  <circle cx="366" cy="86" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="2.6" />
                  <circle cx="366" cy="86" r="4.5" fill="#06B6D4" />
                  <circle cx="206" cy="368" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#F59E0B" stroke-width="2.6" />
                  <circle cx="206" cy="368" r="4.5" fill="#F59E0B" />
                  <circle cx="526" cy="368" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#D946EF" stroke-width="2.6" />
                  <circle cx="526" cy="368" r="4.5" fill="#D946EF" />

                  <!-- Focal Item Crosshair -->
                  <circle cx="366" cy="266" r="22" fill="none" stroke="#F59E0B" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="3 3" />
                  <circle cx="340" cy="218" r="11" fill="#06B6D4" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="366" cy="266" r="13" fill="#F59E0B" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="426" cy="306" r="11" fill="#D946EF" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />

                  <rect x="292" y="388" width="148" height="26" rx="6" class="fill-white/90 stroke-slate-200 dark:fill-[#0B0F17]/90 dark:stroke-slate-800" stroke-width="1.2" />
                  <text x="366" y="405" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" class="fill-slate-700 dark:fill-slate-200">w₁ + w₂ + w₃ = 1.0</text>
                </g>
              </g>

              <!-- STAGE 3: Perceptual 3-Vertex OKLab Chromatic Field -->
              <g class="sv-pipeline-stage-layer" data-stage="3">
                <!-- True Blended 3-Corner Simplex Chromatic Fill -->
                <g clip-path="url(#sv-pipe-s3-clip)">
                  <rect x="130" y="70" width="380" height="330" fill="url(#sv-oklab-v1)" />
                  <rect x="130" y="70" width="380" height="330" fill="url(#sv-oklab-v2)" />
                  <rect x="130" y="70" width="380" height="330" fill="url(#sv-oklab-v3)" />
                </g>

                <!-- Luminance Iso-Rings -->
                <circle cx="320" cy="286" r="96" fill="none" class="stroke-white/40 dark:stroke-white/10" stroke-width="1.2" stroke-dasharray="3 5" />
                <circle cx="320" cy="286" r="52" fill="none" class="stroke-white/50 dark:stroke-white/15" stroke-width="1.2" />

                <!-- Perceptual Gradient Simplex Edges -->
                <line x1="320" y1="84" x2="144" y2="388" stroke="url(#sv-pipe-edge-1)" stroke-width="3.2" stroke-linecap="round" class="sv-pipeline-draw" />
                <line x1="320" y1="84" x2="496" y2="388" stroke="url(#sv-pipe-edge-2)" stroke-width="3.2" stroke-linecap="round" class="sv-pipeline-draw" />
                <line x1="144" y1="388" x2="496" y2="388" stroke="url(#sv-pipe-edge-3)" stroke-width="3.2" stroke-linecap="round" class="sv-pipeline-draw" />

                <!-- ΔE_OK Chromatic Mixing Nodes -->
                <g class="sv-pipeline-node-pop">
                  <circle cx="320" cy="184" r="15" fill="#06B6D4" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="242" cy="292" r="16" fill="#10B981" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="398" cy="292" r="16" fill="#A855F7" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="320" cy="264" r="22" fill="#38BDF8" class="stroke-white dark:stroke-[#07090E]" stroke-width="3" />
                  <circle cx="320" cy="342" r="15" fill="#EC4899" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />

                  <circle cx="320" cy="84" r="24" fill="#06B6D4" fill-opacity="0.18" />
                  <circle cx="320" cy="84" r="17" fill="#06B6D4" class="stroke-white dark:stroke-[#07090E]" stroke-width="3" />

                  <circle cx="144" cy="388" r="24" fill="#F59E0B" fill-opacity="0.18" />
                  <circle cx="144" cy="388" r="17" fill="#F59E0B" class="stroke-white dark:stroke-[#07090E]" stroke-width="3" />

                  <circle cx="496" cy="388" r="24" fill="#D946EF" fill-opacity="0.18" />
