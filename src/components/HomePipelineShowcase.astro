    var stageCopies = Array.prototype.slice.call(root.querySelectorAll('.sv-stage-copy'));
    var progressBar = root.querySelector('[data-pipeline-progress]');
    var parallaxLayers = Array.prototype.slice.call(
      root.querySelectorAll('[data-parallax-depth]'),
    );
    var rotateLayers = Array.prototype.slice.call(
      root.querySelectorAll('[data-parallax-rotate]'),
    );

    var currentStage = 1;
    var scrollLockUntil = 0;

    function applyStage(nextStage) {
      var stageNum = Math.max(1, Math.min(5, Number(nextStage) || 1));
      currentStage = stageNum;
      root.setAttribute('data-active-stage', String(stageNum));

      for (var t = 0; t < tabs.length; t++) {
        var tab = tabs[t];
        var tabStage = Number(tab.getAttribute('data-stage-tab'));
        var isMatch = tabStage === stageNum;
        tab.setAttribute('data-active', isMatch ? 'true' : 'false');
        tab.setAttribute('data-completed', tabStage < stageNum ? 'true' : 'false');
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      }

      for (var c = 0; c < stageCopies.length; c++) {
        var copy = stageCopies[c];
        var isCopyActive = Number(copy.getAttribute('data-stage')) === stageNum;
        copy.setAttribute('aria-hidden', isCopyActive ? 'false' : 'true');
      }
    }

    function scrollToStage(stageNum) {
      var rect = runway.getBoundingClientRect();
      var headerOffset = 56;
      var pinnedHeight = Math.max(240, stickyBox.getBoundingClientRect().height);
      var maxTravel = Math.max(1, rect.height - pinnedHeight);
      var runwayTopDoc = window.scrollY + rect.top - headerOffset;
      var fraction = (stageNum - 0.5) / 5;
      scrollLockUntil = Date.now() + 700;
      applyStage(stageNum);
      window.scrollTo({
        top: Math.max(0, runwayTopDoc + fraction * maxTravel),
        behavior: 'smooth',
      });
    }

    for (var i = 0; i < tabs.length; i++) {
      tabs[i].addEventListener('click', function (ev) {
        var targetStage = Number(ev.currentTarget.getAttribute('data-stage-tab'));
        scrollToStage(targetStage);
      });
    }

    root.addEventListener('keydown', function (ev) {
      var activeEl = document.activeElement;
      if (!activeEl || !activeEl.hasAttribute('data-stage-tab')) return;
      if (ev.key === 'ArrowRight') {
        ev.preventDefault();
        scrollToStage(currentStage >= 5 ? 1 : currentStage + 1);
      } else if (ev.key === 'ArrowLeft') {
        ev.preventDefault();
        scrollToStage(currentStage <= 1 ? 5 : currentStage - 1);
      }
    });

    var reducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var rafPending = false;

    function syncScrollToPipeline() {
      rafPending = false;
      var rect = runway.getBoundingClientRect();
      var vh = window.innerHeight || 800;
      var headerOffset = 56;

      if (rect.top < vh * 0.85 && root.getAttribute('data-inview') !== 'true') {
        root.setAttribute('data-inview', 'true');
      }

      var pinnedHeight = Math.max(240, stickyBox.getBoundingClientRect().height);
      var maxTravel = Math.max(1, rect.height - pinnedHeight);
      var rawTravel = headerOffset - rect.top;
      var t = Math.max(0, Math.min(1, rawTravel / maxTravel));

      if (progressBar) {
        var visualScale = Math.max(0.06, t);
        progressBar.setAttribute('transform', 'scale(' + visualScale.toFixed(4) + ' 1)');
      }

      if (Date.now() >= scrollLockUntil) {
        var computedStage = Math.min(5, Math.floor(t * 5) + 1);
        if (computedStage !== currentStage) {
          applyStage(computedStage);
        }
      }

      if (!reducedMotion) {
        var centered = 0.5 - t;
        var shift = centered * 14;
        for (var p = 0; p < parallaxLayers.length; p++) {
          var layer = parallaxLayers[p];
          var depth = Number(layer.getAttribute('data-parallax-depth')) || 0;
          layer.setAttribute('transform', 'translate(0 ' + (shift * depth).toFixed(2) + ')');
        }
        for (var r = 0; r < rotateLayers.length; r++) {
          var rLayer = rotateLayers[r];
          var maxDeg = Number(rLayer.getAttribute('data-parallax-rotate')) || 0;
          rLayer.setAttribute(
            'transform',
            'rotate(' + (centered * maxDeg).toFixed(2) + ' 320 238)',
          );
        }
      }
    }

    function scheduleScrollSync() {
      if (rafPending) return;
      rafPending = true;
      window.requestAnimationFrame(syncScrollToPipeline);
    }

    window.addEventListener('scroll', scheduleScrollSync, { passive: true });
    window.addEventListener('resize', scheduleScrollSync, { passive: true });
    syncScrollToPipeline();
    applyStage(1);
  })();
</script>
