                  <polygon points="368,216 442,216 448,229 442,242 368,242 362,229" class="fill-white dark:fill-[#0B0F17]" stroke="#E879F9" stroke-width="1.8" />
                  <text x="405" y="233" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" class="fill-slate-800 dark:fill-slate-200">A1 ↔ A3</text>

                  <polygon points="283,363 357,363 363,376 357,389 283,389 277,376" class="fill-white dark:fill-[#0B0F17]" stroke="#FBBF24" stroke-width="1.8" />
                  <text x="320" y="380" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" class="fill-slate-800 dark:fill-slate-200">A2 ↔ A3</text>
                </g>
