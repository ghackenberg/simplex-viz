---
import {
  ALL_STRATEGY_IDS,
  getStrategiesByStage,
  type CanonicalStrategySpec,
} from '../site/strategies';
import { withBase } from '../site/url';

interface StageChapterMeta {
  readonly stage: 1 | 2 | 3 | 4 | 5;
  readonly num: string;
  readonly title: string;
  readonly shortTab: string;
  readonly description: string;
  readonly href: string;
  readonly strategies: readonly CanonicalStrategySpec[];
}

const STAGE_CHAPTERS: readonly StageChapterMeta[] = [
  {
    stage: 1,
    num: '01',
    title: 'Mesh Triangulation',
    shortTab: 'Mesh',
    description:
      'Constructs an exact 60° equilateral triangular lattice matched to viewport proportions—or locks a fixed grid—before placing any data.',
    href: withBase('/docs/stage-1-mesh'),
    strategies: getStrategiesByStage(1),
  },
  {
    stage: 2,
    num: '02',
    title: 'Simplex Projection',
    shortTab: 'Project',
    description:
      'Projects tag sets, dense embeddings, or arbitrary pairwise similarities S(a, b) into planar barycentric weights w₁ + w₂ + w₃ = 1.',
    href: withBase('/docs/stage-2-clustering'),
    strategies: getStrategiesByStage(2),
  },
  {
    stage: 3,
    num: '03',
    title: 'OKLab Color',
    shortTab: 'Color',
    description:
      'Assigns vertex hues for maximal perceptual ΔE_OK separation across edges and interpolates bridge nodes in OKLab without muddy midtones.',
    href: withBase('/docs/stage-3-color'),
    strategies: getStrategiesByStage(3),
  },
  {
    stage: 4,
    num: '04',
    title: 'Convex Layout',
    shortTab: 'Layout',
    description:
      'Fans dense node clusters into open triangle territory and resolves exact convex Minimum Translation Vectors for guaranteed 0.0 px overlap.',
    href: withBase('/docs/stage-4-layout'),
    strategies: getStrategiesByStage(4),
  },
  {
    stage: 5,
    num: '05',
    title: 'Conformal Zoom',
    shortTab: 'Zoom',
    description:
      'Subdivides crowded triangles 1:4 along edge midpoints without flipping parent orientation, re-clusters local subspaces, or supports free camera pan & pinch.',
    href: withBase('/docs/stage-5-zoom'),
    strategies: getStrategiesByStage(5),
  },
];
---

<section
  id="architecture"
  data-pipeline-showcase
  data-active-stage="1"
  data-inview="false"
  aria-labelledby="architecture-heading"
  class="pt-14 pb-12 sm:pt-20 sm:pb-16"
>
  <!-- Consistent Section Header matching Examples & Latest Notes -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-xl">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Composable Architecture
        </p>
        <h2
          id="architecture-heading"
          class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]"
        >
          Five independent stages with named strategies
        </h2>
      </div>
      <a
        href={withBase('/docs/strategies')}
        class="text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap shrink-0"
      >
        Browse all {ALL_STRATEGY_IDS.length} strategies →
      </a>
    </div>
  </div>

  <!-- Scroll Runway for Pinned Full-Viewport Stage Card -->
  <div
    data-pipeline-runway
    class="relative mt-6 h-[280dvh] min-h-[1450px] max-h-[2600px] sm:mt-8"
  >
    <div
      data-pipeline-sticky
      class="sticky top-14 mx-auto flex h-[min(calc(100dvh-3.5rem),43rem)] max-w-7xl flex-col px-3 py-2 sm:px-6 sm:py-3 lg:px-8"
    >
      <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-[0_14px_44px_-22px_rgba(15,23,42,0.14)] dark:border-slate-800/90 dark:bg-[#0B0F17] dark:shadow-[0_20px_50px_-24px_rgba(6,182,212,0.14)]">
        <!-- Top Scroll Progress Hairline -->
        <svg
          class="block h-[3px] w-full shrink-0 bg-slate-100 dark:bg-slate-900"
          viewBox="0 0 1000 3"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <rect
            data-pipeline-progress
            x="0"
            y="0"
            width="1000"
            height="3"
            transform="scale(0.06 1)"
            class="fill-cyan-600 dark:fill-cyan-400"
          />
        </svg>

        <!-- Minimal Centered Stage Tab Bar -->
        <div class="flex shrink-0 items-center justify-center border-b border-slate-200/80 bg-slate-50/90 px-3 py-1.5 sm:px-5 sm:py-2 dark:border-slate-800/80 dark:bg-[#0E131D]">
          <div
            role="tablist"
            aria-label="Pipeline stages"
            class="grid w-full max-w-lg grid-cols-5 gap-1"
          >
            {
              STAGE_CHAPTERS.map((item) => (
                <button
                  type="button"
                  role="tab"
                  data-stage-tab={item.stage}
                  aria-selected={item.stage === 1 ? 'true' : 'false'}
                  data-active={item.stage === 1 ? 'true' : 'false'}
                  class="flex h-7 sm:h-8 cursor-pointer items-center justify-center gap-1 rounded-lg px-1.5 text-xs font-medium text-slate-600 transition-colors whitespace-nowrap shrink-0 hover:bg-white/80 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 data-[active=true]:bg-white data-[active=true]:font-semibold data-[active=true]:text-slate-950 data-[active=true]:shadow-xs dark:text-slate-400 dark:hover:bg-slate-800/60 dark:hover:text-slate-100 dark:data-[active=true]:bg-[#0B0F17] dark:data-[active=true]:text-cyan-300"
                >
                  <span class="font-mono text-[11px] tabular-nums">{item.num}</span>
                  <span class="hidden sm:inline truncate">{item.shortTab}</span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Adaptive Orientation Body: Portrait Stacked / Landscape Side-by-Side -->
        <div class="grid min-h-0 flex-1 grid-cols-1 grid-rows-[minmax(0,1fr)_auto] divide-y divide-slate-200/80 landscape:grid-cols-12 landscape:grid-rows-1 landscape:divide-x landscape:divide-y-0 dark:divide-slate-800/80">
          <!-- Illustration Viewport -->
          <div class="relative flex min-h-0 items-center justify-center overflow-hidden bg-slate-50/75 p-2 sm:p-5 landscape:col-span-6 dark:bg-[#07090E]">
            <svg
              class="h-full w-full max-h-full select-none"
              viewBox="0 0 640 460"
              preserveAspectRatio="xMidYMid meet"
              role="img"
              aria-label="Illustration of the active SimplexViz pipeline stage"
            >
              <defs>
                <radialGradient id="sv-pipe-glow-cyan" cx="50%" cy="50%" r="55%">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.16" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="sv-pipe-edge-1" x1="320" y1="88" x2="148" y2="384" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" />
                  <stop offset="100%" stop-color="#F59E0B" />
                </linearGradient>
                <linearGradient id="sv-pipe-edge-2" x1="320" y1="88" x2="492" y2="384" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" />
                  <stop offset="100%" stop-color="#D946EF" />
                </linearGradient>
                <linearGradient id="sv-pipe-edge-3" x1="148" y1="384" x2="492" y2="384" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#F59E0B" />
                  <stop offset="100%" stop-color="#D946EF" />
                </linearGradient>
              </defs>

              <!-- Scroll-Linked Ambient Coordinate Rings -->
              <g data-parallax-depth="0.45">
                <circle cx="320" cy="242" r="190" fill="url(#sv-pipe-glow-cyan)" />
                <g data-parallax-rotate="24" class="stroke-slate-300/70 dark:stroke-slate-800/80" stroke-width="1" fill="none">
                  <circle cx="320" cy="242" r="168" stroke-dasharray="3 7" />
                  <circle cx="320" cy="242" r="118" stroke-dasharray="2 8" />
                  <line x1="72" y1="242" x2="568" y2="242" stroke-dasharray="4 6" />
                  <line x1="320" y1="54" x2="320" y2="418" stroke-dasharray="4 6" />
                </g>
              </g>

              <!-- STAGE 1: Mesh Triangulation -->
              <g class="sv-pipeline-stage-layer" data-stage="1">
                <g class="sv-pipeline-draw stroke-slate-300 dark:stroke-slate-700" stroke-width="1.8" fill="none">
                  <polygon points="320,92 162,366 478,366" class="fill-cyan-500/[0.06] dark:fill-cyan-400/[0.08]" />
                  <polygon points="162,184 320,92 162,366" />
                  <polygon points="478,184 320,92 478,366" />
                  <line x1="241" y1="229" x2="399" y2="229" />
                </g>
                <path d="M 294 136 A 44 44 0 0 0 346 136" fill="none" stroke="#06B6D4" stroke-width="2.2" />
                <text x="320" y="158" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" class="fill-cyan-700 dark:fill-cyan-300">60°</text>
                <path d="M 96 102 L 96 80 L 118 80 M 544 102 L 544 80 L 522 80 M 96 356 L 96 378 L 118 378 M 544 356 L 544 378 L 522 378" fill="none" class="stroke-slate-400 dark:stroke-slate-600" stroke-width="1.8" stroke-linecap="round" />

                <g class="sv-pipeline-node-pop">
                  <circle cx="320" cy="92" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="3" />
                  <circle cx="320" cy="92" r="5" fill="#06B6D4" />
                  <circle cx="162" cy="366" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#F59E0B" stroke-width="3" />
                  <circle cx="162" cy="366" r="5" fill="#F59E0B" />
                  <circle cx="478" cy="366" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#D946EF" stroke-width="3" />
                  <circle cx="478" cy="366" r="5" fill="#D946EF" />
                </g>
              </g>

              <!-- STAGE 2: Simplex Projection -->
              <g class="sv-pipeline-stage-layer" data-stage="2">
                <polygon points="354,90 192,372 516,372" class="sv-pipeline-draw fill-slate-200/40 stroke-slate-300 dark:fill-slate-900/50 dark:stroke-slate-700" stroke-width="1.8" />

                <g class="sv-pipeline-node-pop">
                  <circle cx="96" cy="176" r="6" class="fill-slate-400 dark:fill-slate-600" />
                  <circle cx="122" cy="208" r="5" class="fill-slate-400 dark:fill-slate-600" />
                  <circle cx="104" cy="244" r="6.5" class="fill-slate-400 dark:fill-slate-600" />
                  <circle cx="132" cy="280" r="5" class="fill-slate-400 dark:fill-slate-600" />
                </g>

                <g class="sv-pipeline-flow" fill="none" stroke-width="2" stroke-dasharray="6 4">
                  <path d="M 104 176 C 186 138 252 172 318 224" stroke="#06B6D4" />
                  <path d="M 128 210 C 194 214 256 258 354 270" stroke="#F59E0B" />
                  <path d="M 110 244 C 192 310 318 326 414 304" stroke="#D946EF" />
                </g>

                <g class="sv-pipeline-node-pop">
                  <circle cx="354" cy="90" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="3" />
                  <circle cx="192" cy="372" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#F59E0B" stroke-width="3" />
                  <circle cx="516" cy="372" r="14" class="fill-white dark:fill-[#0B0F17]" stroke="#D946EF" stroke-width="3" />

                  <circle cx="320" cy="226" r="12" fill="#06B6D4" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="354" cy="270" r="14" fill="#F59E0B" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="416" cy="306" r="12" fill="#D946EF" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <text x="354" y="344" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" class="fill-slate-600 dark:fill-slate-300">w₁ + w₂ + w₃ = 1.0</text>
                </g>
              </g>

              <!-- STAGE 3: OKLab Perceptual Color -->
              <g class="sv-pipeline-stage-layer" data-stage="3">
                <polygon points="320,88 148,384 492,384" fill="#06B6D4" fill-opacity="0.06" />
                <line x1="320" y1="88" x2="148" y2="384" stroke="url(#sv-pipe-edge-1)" stroke-width="3.2" stroke-linecap="round" class="sv-pipeline-draw" />
                <line x1="320" y1="88" x2="492" y2="384" stroke="url(#sv-pipe-edge-2)" stroke-width="3.2" stroke-linecap="round" class="sv-pipeline-draw" />
                <line x1="148" y1="384" x2="492" y2="384" stroke="url(#sv-pipe-edge-3)" stroke-width="3.2" stroke-linecap="round" class="sv-pipeline-draw" />

                <g class="sv-pipeline-node-pop">
                  <circle cx="320" cy="190" r="16" fill="#06B6D4" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="244" cy="292" r="16" fill="#10B981" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="396" cy="292" r="16" fill="#A855F7" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />
                  <circle cx="320" cy="262" r="20" fill="#38BDF8" class="stroke-white dark:stroke-[#07090E]" stroke-width="3" />
                  <circle cx="320" cy="338" r="15" fill="#EC4899" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />

                  <circle cx="320" cy="88" r="17" fill="#06B6D4" class="stroke-white dark:stroke-[#07090E]" stroke-width="3" />
                  <circle cx="148" cy="384" r="17" fill="#F59E0B" class="stroke-white dark:stroke-[#07090E]" stroke-width="3" />
                  <circle cx="492" cy="384" r="17" fill="#D946EF" class="stroke-white dark:stroke-[#07090E]" stroke-width="3" />
                </g>
              </g>

              <!-- STAGE 4: Convex SAT Layout -->
              <g class="sv-pipeline-stage-layer" data-stage="4">
                <polygon points="320,84 144,386 496,386" class="sv-pipeline-draw fill-cyan-500/[0.04] stroke-slate-300 dark:stroke-slate-700" stroke-width="1.8" />
                <polygon points="320,132 186,362 454,362" fill="none" stroke="#22D3EE" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="5 4" />

                <g class="sv-pipeline-flow" stroke="#06B6D4" stroke-width="1.8" fill="none" stroke-dasharray="6 4">
                  <line x1="320" y1="246" x2="262" y2="204" />
                  <line x1="320" y1="246" x2="380" y2="206" />
                  <line x1="320" y1="246" x2="264" y2="314" />
                  <line x1="320" y1="246" x2="378" y2="314" />
                </g>

                <g class="sv-pipeline-node-pop">
                  <g transform="translate(248, 198)">
                    <rect x="-44" y="-19" width="88" height="38" rx="19" fill="none" stroke="#06B6D4" stroke-opacity="0.4" stroke-width="1.4" stroke-dasharray="3 3" />
                    <rect x="-38" y="-14" width="76" height="28" rx="14" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="2.2" />
                    <circle cx="-21" cy="0" r="5" fill="#06B6D4" />
                    <line x1="-10" y1="0" x2="22" y2="0" class="stroke-slate-400 dark:stroke-slate-500" stroke-width="3" stroke-linecap="round" />
                  </g>

                  <g transform="translate(392, 200)">
                    <circle cx="0" cy="0" r="29" fill="none" stroke="#D946EF" stroke-opacity="0.4" stroke-width="1.4" stroke-dasharray="3 3" />
                    <circle cx="0" cy="0" r="23" class="fill-white dark:fill-[#0B0F17]" stroke="#D946EF" stroke-width="2.2" />
                    <circle cx="0" cy="0" r="8.5" fill="#D946EF" />
                  </g>

                  <g transform="translate(256, 316)">
                    <circle cx="0" cy="0" r="27" fill="none" stroke="#F59E0B" stroke-opacity="0.4" stroke-width="1.4" stroke-dasharray="3 3" />
                    <circle cx="0" cy="0" r="21" class="fill-white dark:fill-[#0B0F17]" stroke="#F59E0B" stroke-width="2.2" />
                    <circle cx="0" cy="0" r="8" fill="#F59E0B" />
                  </g>

                  <g transform="translate(384, 316)">
                    <rect x="-44" y="-19" width="88" height="38" rx="8" fill="none" stroke="#10B981" stroke-opacity="0.4" stroke-width="1.4" stroke-dasharray="3 3" />
                    <rect x="-38" y="-14" width="76" height="28" rx="6" class="fill-white dark:fill-[#0B0F17]" stroke="#10B981" stroke-width="2.2" />
                    <rect x="-26" y="-5" width="10" height="10" rx="2" fill="#10B981" />
                    <line x1="-10" y1="0" x2="22" y2="0" class="stroke-slate-400 dark:stroke-slate-500" stroke-width="3" stroke-linecap="round" />
                  </g>

                  <text x="320" y="414" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" class="fill-cyan-700 dark:fill-cyan-300">maxPenetrationPx === 0.0</text>
                </g>
              </g>

              <!-- STAGE 5: Conformal 1:4 Zoom -->
              <g class="sv-pipeline-stage-layer" data-stage="5">
                <polygon points="320,82 152,374 488,374" fill="#06B6D4" fill-opacity="0.06" stroke="#22D3EE" stroke-width="2.2" class="sv-pipeline-draw" />
                <polygon points="236,228 404,228 320,374" fill="#F59E0B" fill-opacity="0.08" stroke="#FBBF24" stroke-width="2" stroke-dasharray="5 4" class="sv-pipeline-flow" />

                <g class="sv-pipeline-node-pop">
                  <circle cx="320" cy="172" r="10" fill="#06B6D4" />
                  <circle cx="238" cy="322" r="10" fill="#F59E0B" />
                  <circle cx="402" cy="322" r="10" fill="#D946EF" />
                  <circle cx="320" cy="274" r="11" fill="#38BDF8" class="stroke-white dark:stroke-[#07090E]" stroke-width="2.5" />

                  <rect x="288" y="64" width="64" height="28" rx="14" fill="#0E7490" stroke="#22D3EE" stroke-width="1.8" />
                  <text x="320" y="82" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="700" fill="#FFFFFF">A1</text>

                  <rect x="120" y="360" width="64" height="28" rx="14" fill="#B45309" stroke="#FBBF24" stroke-width="1.8" />
                  <text x="152" y="378" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="700" fill="#FFFFFF">A2</text>

                  <rect x="456" y="360" width="64" height="28" rx="14" fill="#86198F" stroke="#E879F9" stroke-width="1.8" />
                  <text x="488" y="378" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="700" fill="#FFFFFF">A3</text>

                  <polygon points="199,215 273,215 279,228 273,241 199,241 193,228" class="fill-white dark:fill-[#0B0F17]" stroke="#38BDF8" stroke-width="1.8" />
                  <text x="236" y="232" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" class="fill-slate-800 dark:fill-slate-200">A1 ↔ A2</text>

                  <polygon points="367,215 441,215 447,228 441,241 367,241 361,228" class="fill-white dark:fill-[#0B0F17]" stroke="#E879F9" stroke-width="1.8" />
                  <text x="404" y="232" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" class="fill-slate-800 dark:fill-slate-200">A1 ↔ A3</text>

                  <polygon points="283,361 357,361 363,374 357,387 283,387 277,374" class="fill-white dark:fill-[#0B0F17]" stroke="#FBBF24" stroke-width="1.8" />
                  <text x="320" y="378" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" class="fill-slate-800 dark:fill-slate-200">A2 ↔ A3</text>
                </g>
              </g>
            </svg>
          </div>

          <!-- Reduced Single-Stage Explanation Pane: Stage Number, Heading, Description, Docs Link -->
          <div class="flex min-h-0 flex-col justify-center px-5 py-4 sm:px-8 sm:py-6 landscape:col-span-6 lg:px-10">
            <div class="grid">
              {
                STAGE_CHAPTERS.map((chapter) => (
                  <article
                    data-stage={chapter.stage}
                    aria-hidden={chapter.stage === 1 ? 'false' : 'true'}
                    class="sv-stage-copy flex flex-col justify-center"
                  >
                    <p class="font-mono text-xs font-semibold text-cyan-700 dark:text-cyan-400 tabular-nums">
                      Stage {chapter.num}
                    </p>

                    <h3 class="mt-1.5 text-xl sm:text-2xl lg:text-[1.75rem] font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
                      {chapter.title}
                    </h3>

                    <p class="mt-2.5 max-w-md text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                      {chapter.description}
                    </p>

                    <div
                      aria-label={`${chapter.title} strategies`}
                      class="mt-3 sm:mt-4 flex flex-wrap gap-1.5"
                    >
                      {chapter.strategies.map((spec) => (
                        <a
                          href={withBase(spec.strategyDocPath)}
                          title={spec.name}
                          data-default-strategy={spec.isDefault ? 'true' : 'false'}
                          class:list={[
                            'group inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 text-[11px] sm:text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 whitespace-nowrap shrink-0',
                            spec.isDefault
                              ? 'border-cyan-500/75 bg-cyan-50/90 font-semibold text-cyan-800 hover:border-cyan-600 hover:bg-cyan-100 hover:text-cyan-950 dark:border-cyan-400/60 dark:bg-cyan-950/60 dark:text-cyan-200 dark:hover:border-cyan-300 dark:hover:bg-cyan-900/65 dark:hover:text-white'
                              : 'border-slate-200/90 bg-slate-50 font-medium text-slate-700 hover:border-cyan-500/60 hover:bg-cyan-50/60 hover:text-cyan-900 dark:border-slate-800 dark:bg-[#07090E] dark:text-slate-300 dark:hover:border-cyan-400/55 dark:hover:bg-cyan-950/45 dark:hover:text-cyan-200',
                          ]}
                        >
                          <span>{spec.shortName}</span>
                          {spec.isDefault && (
                            <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-cyan-700 transition-colors group-hover:text-cyan-900 dark:text-cyan-300 dark:group-hover:text-cyan-100">
                              Default
                            </span>
                          )}
                        </a>
                      ))}
                    </div>

                    <div class="mt-4 sm:mt-5">
                      <a
                        href={chapter.href}
                        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap"
                      >
                        <span>Stage documentation</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-pipeline-showcase]');
    if (!root) return;

    var runway = root.querySelector('[data-pipeline-runway]');
    var stickyBox = root.querySelector('[data-pipeline-sticky]');
    if (!runway || !stickyBox) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-stage-tab]'));
    var stageCopies = Array.prototype.slice.call(root.querySelectorAll('.sv-stage-copy'));
    var progressBar = root.querySelector('[data-pipeline-progress]');
    var parallaxLayers = Array.prototype.slice.call(
      root.querySelectorAll('[data-parallax-depth]'),
    );
    var rotateLayers = Array.prototype.slice.call(
      root.querySelectorAll('[data-parallax-rotate]'),
    );

    var currentStage = 1;
    var scrollLockUntil = 0;

    function applyStage(nextStage) {
      var stageNum = Math.max(1, Math.min(5, Number(nextStage) || 1));
      currentStage = stageNum;
      root.setAttribute('data-active-stage', String(stageNum));

      for (var t = 0; t < tabs.length; t++) {
        var tab = tabs[t];
        var isMatch = Number(tab.getAttribute('data-stage-tab')) === stageNum;
        tab.setAttribute('data-active', isMatch ? 'true' : 'false');
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      }

      for (var c = 0; c < stageCopies.length; c++) {
        var copy = stageCopies[c];
        var isCopyActive = Number(copy.getAttribute('data-stage')) === stageNum;
        copy.setAttribute('aria-hidden', isCopyActive ? 'false' : 'true');
      }
    }

    function scrollToStage(stageNum) {
      var rect = runway.getBoundingClientRect();
      var headerOffset = 56;
      var pinnedHeight = Math.max(240, stickyBox.getBoundingClientRect().height);
      var maxTravel = Math.max(1, rect.height - pinnedHeight);
      var runwayTopDoc = window.scrollY + rect.top - headerOffset;
      var fraction = (stageNum - 0.5) / 5;
      scrollLockUntil = Date.now() + 700;
      applyStage(stageNum);
      window.scrollTo({
        top: Math.max(0, runwayTopDoc + fraction * maxTravel),
        behavior: 'smooth',
      });
    }

    for (var i = 0; i < tabs.length; i++) {
      tabs[i].addEventListener('click', function (ev) {
        var targetStage = Number(ev.currentTarget.getAttribute('data-stage-tab'));
        scrollToStage(targetStage);
      });
    }

    root.addEventListener('keydown', function (ev) {
      var activeEl = document.activeElement;
      if (!activeEl || !activeEl.hasAttribute('data-stage-tab')) return;
      if (ev.key === 'ArrowRight') {
        ev.preventDefault();
        scrollToStage(currentStage >= 5 ? 1 : currentStage + 1);
      } else if (ev.key === 'ArrowLeft') {
        ev.preventDefault();
        scrollToStage(currentStage <= 1 ? 5 : currentStage - 1);
      }
    });

    var reducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var rafPending = false;

    function syncScrollToPipeline() {
      rafPending = false;
      var rect = runway.getBoundingClientRect();
      var vh = window.innerHeight || 800;
      var headerOffset = 56;

      if (rect.top < vh * 0.85 && root.getAttribute('data-inview') !== 'true') {
        root.setAttribute('data-inview', 'true');
      }

      var pinnedHeight = Math.max(240, stickyBox.getBoundingClientRect().height);
      var maxTravel = Math.max(1, rect.height - pinnedHeight);
      var rawTravel = headerOffset - rect.top;
      var t = Math.max(0, Math.min(1, rawTravel / maxTravel));

      if (progressBar) {
        var visualScale = Math.max(0.06, t);
        progressBar.setAttribute('transform', 'scale(' + visualScale.toFixed(4) + ' 1)');
      }

      if (Date.now() >= scrollLockUntil) {
        var computedStage = Math.min(5, Math.floor(t * 5) + 1);
        if (computedStage !== currentStage) {
          applyStage(computedStage);
        }
      }

      if (!reducedMotion) {
        var centered = 0.5 - t;
        var shift = centered * 14;
        for (var p = 0; p < parallaxLayers.length; p++) {
          var layer = parallaxLayers[p];
          var depth = Number(layer.getAttribute('data-parallax-depth')) || 0;
          layer.setAttribute('transform', 'translate(0 ' + (shift * depth).toFixed(2) + ')');
        }
        for (var r = 0; r < rotateLayers.length; r++) {
          var rLayer = rotateLayers[r];
          var maxDeg = Number(rLayer.getAttribute('data-parallax-rotate')) || 0;
          rLayer.setAttribute(
            'transform',
            'rotate(' + (centered * maxDeg).toFixed(2) + ' 320 242)',
          );
        }
      }
    }

    function scheduleScrollSync() {
      if (rafPending) return;
      rafPending = true;
      window.requestAnimationFrame(syncScrollToPipeline);
    }

    window.addEventListener('scroll', scheduleScrollSync, { passive: true });
    window.addEventListener('resize', scheduleScrollSync, { passive: true });
    syncScrollToPipeline();
    applyStage(1);
  })();
</script>
