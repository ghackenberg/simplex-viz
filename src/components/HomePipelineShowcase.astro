---
import {
  ALL_STRATEGY_IDS,
  getStrategiesByStage,
  type CanonicalStrategySpec,
} from '../site/strategies';
import { withBase } from '../site/url';

interface StageChapterMeta {
  readonly stage: 1 | 2 | 3 | 4 | 5;
  readonly num: string;
  readonly title: string;
  readonly shortTab: string;
  readonly description: string;
  readonly href: string;
  readonly strategies: readonly CanonicalStrategySpec[];
}

const STAGE_CHAPTERS: readonly StageChapterMeta[] = [
  {
    stage: 1,
    num: '01',
    title: 'Mesh Triangulation',
    shortTab: 'Mesh',
    description:
      'Constructs an exact 60° equilateral triangular lattice matched to viewport proportions—or locks a fixed grid—before placing any data.',
    href: withBase('/docs/stage-1-mesh'),
    strategies: getStrategiesByStage(1),
  },
  {
    stage: 2,
    num: '02',
    title: 'Simplex Projection',
    shortTab: 'Project',
    description:
      'Projects tag sets, dense embeddings, or arbitrary pairwise similarities S(a, b) into planar barycentric weights w₁ + w₂ + w₃ = 1.',
    href: withBase('/docs/stage-2-clustering'),
    strategies: getStrategiesByStage(2),
  },
  {
    stage: 3,
    num: '03',
    title: 'OKLab Color',
    shortTab: 'Color',
    description:
      'Assigns vertex hues for maximal perceptual ΔE_OK separation across edges and interpolates bridge nodes in OKLab without muddy midtones.',
    href: withBase('/docs/stage-3-color'),
    strategies: getStrategiesByStage(3),
  },
  {
    stage: 4,
    num: '04',
    title: 'Convex Layout',
    shortTab: 'Layout',
    description:
      'Fans dense node clusters into open triangle territory and resolves exact convex Minimum Translation Vectors for guaranteed 0.0 px overlap.',
    href: withBase('/docs/stage-4-layout'),
    strategies: getStrategiesByStage(4),
  },
  {
    stage: 5,
    num: '05',
    title: 'Conformal Zoom',
    shortTab: 'Zoom',
    description:
      'Subdivides crowded triangles 1:4 along edge midpoints without flipping parent orientation, re-clusters local subspaces, or supports free camera pan & pinch.',
    href: withBase('/docs/stage-5-zoom'),
    strategies: getStrategiesByStage(5),
  },
];
---

<section
  id="architecture"
  data-pipeline-showcase
  data-active-stage="1"
  data-inview="false"
  aria-labelledby="architecture-heading"
  class="pt-14 pb-12 sm:pt-20 sm:pb-16"
>
  <!-- Section Header matching Examples & Latest Notes -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-xl">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Composable Architecture
        </p>
        <h2
          id="architecture-heading"
          class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]"
        >
          Five independent stages with named strategies
        </h2>
      </div>
      <a
        href={withBase('/docs/strategies')}
        class="text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap shrink-0"
      >
        Browse all {ALL_STRATEGY_IDS.length} strategies →
      </a>
    </div>
  </div>

  <!-- Scroll Runway for Pinned Studio Viewport -->
  <div
    data-pipeline-runway
    class="relative mt-6 h-[280dvh] min-h-[1450px] max-h-[2600px] sm:mt-8"
  >
    <div
      data-pipeline-sticky
      class="sticky top-14 mx-auto flex h-[min(calc(100dvh-3.5rem),43rem)] max-w-7xl flex-col px-3 py-2 sm:px-6 sm:py-3 lg:px-8"
    >
      <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-[0_24px_60px_-24px_rgba(15,23,42,0.16),inset_0_1px_0_0_rgba(255,255,255,0.7)] dark:border-slate-800/90 dark:bg-[#0B0F17] dark:shadow-[0_28px_72px_-24px_rgba(6,182,212,0.16),inset_0_1px_0_0_rgba(255,255,255,0.06)]">
        <!-- Minimal Architectural Stage Step Rail + Scroll Progress Hairline -->
        <div class="relative shrink-0 border-b border-slate-200/80 bg-slate-50/90 px-3 py-2 sm:px-5 sm:py-2.5 dark:border-slate-800/80 dark:bg-[#0E131D]/95">
          <div
            role="tablist"
            aria-label="Pipeline stages"
            class="mx-auto grid w-full max-w-xl grid-cols-5 gap-1.5"
          >
            {
              STAGE_CHAPTERS.map((item) => (
                <button
                  type="button"
                  role="tab"
                  data-stage-tab={item.stage}
                  aria-selected={item.stage === 1 ? 'true' : 'false'}
                  data-active={item.stage === 1 ? 'true' : 'false'}
                  data-completed="false"
                  class="group relative flex h-8 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-transparent px-2 text-xs font-medium text-slate-500 transition-all whitespace-nowrap shrink-0 hover:bg-white/75 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 data-[completed=true]:text-slate-700 data-[active=true]:border-slate-200/90 data-[active=true]:bg-white data-[active=true]:font-semibold data-[active=true]:text-slate-950 data-[active=true]:shadow-xs dark:text-slate-400 dark:hover:bg-slate-800/50 dark:hover:text-slate-100 dark:data-[completed=true]:text-slate-300 dark:data-[active=true]:border-cyan-400/35 dark:data-[active=true]:bg-[#0B0F17] dark:data-[active=true]:text-cyan-200"
                >
                  <span
                    class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors group-data-[completed=true]:bg-cyan-500/70 group-data-[active=true]:bg-cyan-500 dark:bg-slate-700 dark:group-data-[completed=true]:bg-cyan-400/60 dark:group-data-[active=true]:bg-cyan-400"
                    aria-hidden="true"
                  />
                  <span class="font-mono text-[11px] tabular-nums">{item.num}</span>
                  <span class="hidden sm:inline truncate">{item.shortTab}</span>
                </button>
              ))
            }
          </div>

          <!-- Precision 2px Bottom Conduit Scroll Hairline -->
          <svg
            class="pointer-events-none absolute inset-x-0 bottom-0 block h-[2px] w-full"
            viewBox="0 0 1000 2"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <rect
              data-pipeline-progress
              x="0"
              y="0"
              width="1000"
              height="2"
              transform="scale(0.06 1)"
              class="fill-cyan-600 dark:fill-cyan-400"
            />
          </svg>
        </div>

        <!-- Adaptive Orientation Stage Body: Portrait Stacked / Landscape Side-by-Side -->
        <div class="grid min-h-0 flex-1 grid-cols-1 grid-rows-[minmax(0,1fr)_auto] divide-y divide-slate-200/80 landscape:grid-cols-12 landscape:grid-rows-1 landscape:divide-x landscape:divide-y-0 dark:divide-slate-800/80">
          <!-- Left / Top: High-Craft Precision Vector Chamber -->
          <div class="relative flex min-h-0 items-center justify-center overflow-hidden bg-slate-50/75 p-2 sm:p-4 landscape:col-span-6 dark:bg-[#07090E]">
            <svg
              class="h-full w-full max-h-full select-none"
              viewBox="0 0 640 460"
              preserveAspectRatio="xMidYMid meet"
              role="img"
              aria-label="Architectural vector illustration explaining the active SimplexViz pipeline stage"
            >
              <defs>
                <!-- Subtle Calibrated Instrument Micro-Dot Grid -->
                <pattern id="sv-pipe-dot-matrix" width="24" height="24" patternUnits="userSpaceOnUse">
                  <circle cx="12" cy="12" r="1" class="fill-slate-300/75 dark:fill-slate-700/70" />
                </pattern>
                <radialGradient id="sv-pipe-grid-fade" cx="50%" cy="50%" r="54%">
                  <stop offset="0%" stop-color="#FFFFFF" stop-opacity="1" />
                  <stop offset="70%" stop-color="#FFFFFF" stop-opacity="0.55" />
                  <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
                </radialGradient>
                <mask id="sv-pipe-dot-mask">
                  <rect width="640" height="460" fill="url(#sv-pipe-grid-fade)" />
                </mask>

                <!-- Per-Stage Atmospheric Glows -->
                <radialGradient id="sv-glow-1" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.16" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-2" cx="62%" cy="50%" r="48%">
                  <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.15" />
                  <stop offset="55%" stop-color="#D946EF" stop-opacity="0.06" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-3" cx="44%" cy="54%" r="48%">
                  <stop offset="0%" stop-color="#10B981" stop-opacity="0.13" />
                  <stop offset="50%" stop-color="#D946EF" stop-opacity="0.09" />
                  <stop offset="100%" stop-color="#F59E0B" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-4" cx="56%" cy="52%" r="48%">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.15" />
                  <stop offset="55%" stop-color="#10B981" stop-opacity="0.08" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-glow-5" cx="58%" cy="52%" r="46%">
                  <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.14" />
                  <stop offset="55%" stop-color="#06B6D4" stop-opacity="0.10" />
                  <stop offset="100%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>

                <!-- Stage 3 True 3-Vertex OKLab Chromatic Field -->
                <clipPath id="sv-pipe-s3-clip">
                  <polygon points="274,84 114,362 434,362" />
                </clipPath>
                <radialGradient id="sv-oklab-v1" cx="274" cy="84" r="285" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.50" />
                  <stop offset="72%" stop-color="#06B6D4" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-oklab-v2" cx="114" cy="362" r="285" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.48" />
                  <stop offset="72%" stop-color="#F59E0B" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="sv-oklab-v3" cx="434" cy="362" r="285" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#D946EF" stop-opacity="0.48" />
                  <stop offset="72%" stop-color="#D946EF" stop-opacity="0" />
                </radialGradient>

                <linearGradient id="sv-pipe-edge-1" x1="274" y1="84" x2="114" y2="362" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" />
                  <stop offset="100%" stop-color="#F59E0B" />
                </linearGradient>
                <linearGradient id="sv-pipe-edge-2" x1="274" y1="84" x2="434" y2="362" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#06B6D4" />
                  <stop offset="100%" stop-color="#D946EF" />
                </linearGradient>
                <linearGradient id="sv-pipe-edge-3" x1="114" y1="362" x2="434" y2="362" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#F59E0B" />
                  <stop offset="100%" stop-color="#D946EF" />
                </linearGradient>
              </defs>

              <!-- Masked Calibrated Micro-Dot Field -->
              <rect width="640" height="460" fill="url(#sv-pipe-dot-matrix)" mask="url(#sv-pipe-dot-mask)" />

              <!-- Corner Registration Crosshairs -->
              <g class="stroke-slate-300 dark:stroke-slate-700/80" stroke-width="1.2" fill="none">
                <path d="M 28 34 L 40 34 M 34 28 L 34 40" />
                <path d="M 600 34 L 612 34 M 606 28 L 606 40" />
                <path d="M 28 426 L 40 426 M 34 420 L 34 432" />
                <path d="M 600 426 L 612 426 M 606 420 L 606 432" />
              </g>

              <!-- Per-Stage Adaptive Atmospheric Glows -->
              <circle cx="320" cy="230" r="215" fill="url(#sv-glow-1)" class="sv-stage-glow" data-glow="1" />
              <circle cx="390" cy="230" r="215" fill="url(#sv-glow-2)" class="sv-stage-glow" data-glow="2" />
              <circle cx="280" cy="240" r="215" fill="url(#sv-glow-3)" class="sv-stage-glow" data-glow="3" />
              <circle cx="360" cy="236" r="215" fill="url(#sv-glow-4)" class="sv-stage-glow" data-glow="4" />
              <circle cx="384" cy="236" r="215" fill="url(#sv-glow-5)" class="sv-stage-glow" data-glow="5" />

              <!-- Subtle Scroll-Linked Compass Ring Backdrop -->
              <g data-parallax-depth="0.4">
                <g data-parallax-rotate="20" class="stroke-slate-300/45 dark:stroke-slate-800/65" stroke-width="1" fill="none">
                  <circle cx="320" cy="230" r="196" stroke-dasharray="2 9" />
                  <circle cx="320" cy="230" r="142" stroke-dasharray="4 9" />
                </g>
              </g>

              <!-- =========================================================
                   STAGE 1: Viewport (W × H) -> Equilateral 60° Hex Lattice
                   ========================================================= -->
              <g class="sv-pipeline-stage-layer" data-stage="1">
                <!-- Viewport Container Box & Dimension Bars -->
                <rect x="86" y="74" width="468" height="302" rx="12" class="fill-white/55 stroke-slate-300/90 dark:fill-[#0B0F17]/55 dark:stroke-slate-700/85" stroke-width="1.4" stroke-dasharray="5 4" />
                <g class="stroke-slate-400/75 dark:stroke-slate-600" stroke-width="1.2" fill="none">
                  <line x1="86" y1="54" x2="554" y2="54" />
                  <line x1="86" y1="48" x2="86" y2="60" />
                  <line x1="554" y1="48" x2="554" y2="60" />
                  <line x1="572" y1="74" x2="572" y2="376" />
                  <line x1="566" y1="74" x2="578" y2="74" />
                  <line x1="566" y1="376" x2="578" y2="376" />
                </g>
                <rect x="274" y="42" width="92" height="22" rx="6" class="fill-white stroke-slate-200 dark:fill-[#0B0F17] dark:stroke-slate-800" stroke-width="1.2" />
                <text x="320" y="57" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" class="fill-slate-600 dark:fill-slate-300">Canvas W</text>
                <rect x="556" y="213" width="32" height="24" rx="6" class="fill-white stroke-slate-200 dark:fill-[#0B0F17] dark:stroke-slate-800" stroke-width="1.2" />
                <text x="572" y="229" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" class="fill-slate-600 dark:fill-slate-300">H</text>

                <!-- Staggered Equilateral 60° Lattice Cells (Side = 136px, Height = 118px) -->
                <g class="stroke-slate-300/85 dark:stroke-slate-700/90" stroke-width="1.3" fill="none">
                  <polygon points="184,108 116,226 252,226" />
                  <polygon points="456,108 388,226 524,226" />
                  <polygon points="184,108 320,108 252,226" />
                  <polygon points="320,108 456,108 388,226" />
                  <polygon points="116,226 252,226 184,344" />
                  <polygon points="388,226 524,226 456,344" />
                  <polygon points="252,226 184,344 320,344" />
                  <polygon points="388,226 320,344 456,344" />
                </g>

                <!-- Primary Highlighted 60° Triangle Pair (Up + Down) -->
                <g class="sv-pipeline-draw" fill="none">
                  <polygon
                    points="320,108 252,226 388,226"
                    stroke="#06B6D4"
                    stroke-width="2.2"
                    class="fill-cyan-500/[0.11] dark:fill-cyan-400/[0.14]"
                  />
                  <polygon
                    points="252,226 388,226 320,344"
                    stroke="#06B6D4"
                    stroke-opacity="0.6"
                    stroke-width="1.7"
                    class="fill-cyan-500/[0.04] dark:fill-cyan-400/[0.05]"
                  />
                </g>

                <!-- 60° Vertex Angle Gauge inside Hero Cell -->
                <path d="M 302 139 A 36 36 0 0 0 338 139" fill="none" stroke="#06B6D4" stroke-width="2.2" stroke-linecap="round" />
                <text x="320" y="160" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="700" class="fill-cyan-700 dark:fill-cyan-300">60°</text>

                <!-- Lattice Anchor Nodes -->
                <g class="sv-pipeline-node-pop">
                  <!-- Peripheral Lattice Nodes -->
                  <circle cx="184" cy="108" r="5" class="fill-slate-300 dark:fill-slate-600" />
                  <circle cx="456" cy="108" r="5" class="fill-slate-300 dark:fill-slate-600" />
                  <circle cx="116" cy="226" r="5" class="fill-slate-300 dark:fill-slate-600" />
                  <circle cx="524" cy="226" r="5" class="fill-slate-300 dark:fill-slate-600" />
                  <circle cx="184" cy="344" r="5" class="fill-slate-300 dark:fill-slate-600" />
                  <circle cx="456" cy="344" r="5" class="fill-slate-300 dark:fill-slate-600" />
                  <circle cx="320" cy="344" r="6" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="2" />

                  <!-- Featured Triangle Anchor Vertices V1, V2, V3 -->
                  <circle cx="320" cy="108" r="14" fill="#06B6D4" fill-opacity="0.16" />
                  <circle cx="320" cy="108" r="8" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="2.5" />
                  <circle cx="320" cy="108" r="3" fill="#06B6D4" />

                  <circle cx="252" cy="226" r="14" fill="#F59E0B" fill-opacity="0.16" />
                  <circle cx="252" cy="226" r="8" class="fill-white dark:fill-[#0B0F17]" stroke="#F59E0B" stroke-width="2.5" />
                  <circle cx="252" cy="226" r="3" fill="#F59E0B" />

                  <circle cx="388" cy="226" r="14" fill="#D946EF" fill-opacity="0.16" />
                  <circle cx="388" cy="226" r="8" class="fill-white dark:fill-[#0B0F17]" stroke="#D946EF" stroke-width="2.5" />
                  <circle cx="388" cy="226" r="3" fill="#D946EF" />

                  <!-- Bottom Summary Plaque -->
                  <rect x="176" y="396" width="288" height="28" rx="7" class="fill-white/95 stroke-slate-200 dark:fill-[#0B0F17]/95 dark:stroke-slate-800" stroke-width="1.2" />
                  <text x="320" y="414" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" class="fill-slate-700 dark:fill-slate-200">Uniform 60° triangles · equal aspect spacing</text>
                </g>
              </g>

              <!-- =========================================================
                   STAGE 2: Tagged / Embedded Items -> Barycentric Triangle
                   ========================================================= -->
              <g class="sv-pipeline-stage-layer" data-stage="2">
                <!-- Left Input Cards: Concrete Examples for Newcomers -->
                <g class="sv-pipeline-node-pop">
                  <!-- Card alpha: Shared tags A + B -> Edge midpoint -->
                  <rect x="42" y="108" width="152" height="52" rx="9" class="fill-white stroke-slate-200 dark:fill-[#0B0F17] dark:stroke-slate-800" stroke-width="1.4" />
                  <text x="56" y="128" font-family="Plus Jakarta Sans, sans-serif" font-size="11.5" font-weight="700" class="fill-slate-900 dark:fill-white">Item α</text>
                  <rect x="56" y="136" width="38" height="16" rx="4" fill="#06B6D4" fill-opacity="0.14" stroke="#06B6D4" stroke-opacity="0.55" stroke-width="1" />
                  <text x="75" y="147" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" class="fill-cyan-700 dark:fill-cyan-300">Tag A</text>
                  <rect x="100" y="136" width="38" height="16" rx="4" fill="#F59E0B" fill-opacity="0.14" stroke="#F59E0B" stroke-opacity="0.55" stroke-width="1" />
                  <text x="119" y="147" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" class="fill-amber-700 dark:fill-amber-300">Tag B</text>

                  <!-- Card beta: 3-way mix -> Interior -->
                  <rect x="42" y="196" width="152" height="54" rx="9" class="fill-white stroke-slate-200 dark:fill-[#0B0F17] dark:stroke-slate-800" stroke-width="1.4" />
                  <text x="56" y="216" font-family="Plus Jakarta Sans, sans-serif" font-size="11.5" font-weight="700" class="fill-slate-900 dark:fill-white">Item β</text>
                  <text x="56" y="236" font-family="IBM Plex Mono, monospace" font-size="10" class="fill-slate-500 dark:fill-slate-400">0.4 A · 0.3 B · 0.3 C</text>

                  <!-- Card gamma: Single cluster C -> Near Vertex C -->
                  <rect x="42" y="286" width="152" height="52" rx="9" class="fill-white stroke-slate-200 dark:fill-[#0B0F17] dark:stroke-slate-800" stroke-width="1.4" />
                  <text x="56" y="306" font-family="Plus Jakarta Sans, sans-serif" font-size="11.5" font-weight="700" class="fill-slate-900 dark:fill-white">Item γ</text>
                  <rect x="56" y="314" width="42" height="16" rx="4" fill="#D946EF" fill-opacity="0.14" stroke="#D946EF" stroke-opacity="0.55" stroke-width="1" />
                  <text x="77" y="325" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" class="fill-fuchsia-700 dark:fill-fuchsia-300">Tag C</text>
                </g>

                <!-- Target Simplex Triangle -->
                <polygon points="434,92 292,338 576,338" class="sv-pipeline-draw fill-cyan-500/[0.04] stroke-slate-300 dark:fill-slate-900/55 dark:stroke-slate-700" stroke-width="1.8" />

                <!-- Barycentric Weight Coordinate Rays to Item beta -->
                <g class="stroke-slate-400/55 dark:stroke-slate-600/70" stroke-width="1.2" stroke-dasharray="3 3" fill="none">
                  <line x1="434" y1="92" x2="434" y2="236" />
                  <line x1="292" y1="338" x2="434" y2="236" />
                  <line x1="576" y1="338" x2="434" y2="236" />
                </g>

                <!-- Flowing Projection Paths from Input Cards to Simplex Coordinates -->
                <g class="sv-pipeline-flow" fill="none" stroke-width="2" stroke-dasharray="6 4">
                  <path d="M 196 134 C 254 126 306 168 358 206" stroke="#06B6D4" />
                  <path d="M 196 223 C 268 220 338 232 424 236" stroke="#F59E0B" />
                  <path d="M 196 312 C 282 320 408 326 518 308" stroke="#D946EF" />
                </g>

                <!-- Anchor Vertices & Landed Data Dots -->
                <g class="sv-pipeline-node-pop">
                  <circle cx="434" cy="92" r="13" class="fill-white dark:fill-[#0B0F17]" stroke="#06B6D4" stroke-width="2.6" />
                  <circle cx="434" cy="92" r="4.5" fill="#06B6D4" />
                  <text x="434" y="68" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="700" class="fill-cyan-700 dark:fill-cyan-300">Anchor A</text>

                  <circle cx="292" cy="338" r="13" class="fill-white dark:fill-[#0B0F17]" stroke="#F59E0B" stroke-width="2.6" />
                  <circle cx="292" cy="338" r="4.5" fill="#F59E0B" />
