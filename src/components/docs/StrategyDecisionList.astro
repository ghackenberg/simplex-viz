---
import { getStrategySpec, type CanonicalStrategyId } from '../../site/strategies';
import { withBase } from '../../site/url';

export interface StrategyDecisionRow {
  readonly strategyId: CanonicalStrategyId;
  readonly callExample?: string;
  readonly modalityOrProfile: string;
  readonly description: string;
}

interface Props {
  rows: readonly StrategyDecisionRow[];
}

const { rows } = Astro.props;
---

<div class="not-prose my-6 divide-y divide-slate-200/80 rounded-xl border border-slate-200/90 bg-white dark:divide-slate-800/80 dark:border-slate-800/90 dark:bg-[#0B0F17]">
  {
    rows.map((row) => {
      const spec = getStrategySpec(row.strategyId);
      const invocation = row.callExample ?? `${spec.factoryName}()`;
      return (
        <div class="p-4 sm:p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <div class="flex flex-wrap items-baseline gap-2">
              <a
                href={withBase(spec.strategyDocPath)}
                class="text-sm font-semibold text-slate-950 hover:text-cyan-700 hover:underline dark:text-white dark:hover:text-cyan-300 transition-colors"
              >
                {spec.name}
              </a>
              {spec.isDefault && (
                <span class="font-mono text-[11px] font-medium text-emerald-700 dark:text-emerald-400">
                  · Default
                </span>
              )}
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">
              {row.modalityOrProfile}
            </span>
          </div>

          <p class="mt-2 font-mono text-xs text-cyan-700 dark:text-cyan-300 break-words">
            {invocation}
          </p>

          <p class="mt-2 text-xs sm:text-[13px] leading-relaxed text-slate-600 dark:text-slate-300">
            {row.description}
          </p>
        </div>
      );
    })
  }
</div>
