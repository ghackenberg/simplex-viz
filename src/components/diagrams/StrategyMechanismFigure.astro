---
import type { CanonicalStrategyId } from '../../site/strategies';

interface Props {
  strategyId: CanonicalStrategyId;
}

const { strategyId } = Astro.props;

const CAPTIONS: Record<CanonicalStrategyId, string> = {
  'adaptive-hex-mesh':
    'Evaluates horizontal vs. vertical axis orientations and staggered 60° row parity (wideFirst) to maximize equilateral triangle side length s inside viewport (W × H).',
  'fixed-grid-mesh':
    'Locks an exact (cols × rows) vertex grid topology across viewport aspect changes, scaling equilateral edge length s uniformly without adding or dropping vertices.',
  'soft-simplex-tags':
    'Spreads 2- and 3-cluster tagged items continuously across planar triangle interiors (triangleSpread) while leaving single-cluster items unconstrained in a 360° vertex halo.',
  'jaccard-qap-tags':
    'Partitions tags via regularized Jaccard similarity, embeds related clusters on adjacent mesh vertices via QAP Simulated Annealing, and snaps shared items onto planar edges and centroids.',
  'incremental-anchor-tags':
    'Freezes existing vertex cluster anchors and OKLab colors across live update() calls, attaching newly arriving tags and items locally without global topic reshuffling.',
  'soft-simplex-embeddings':
    'Combines 1 to M weighted vector modalities via Spherical/L2 k-Means++ and load-balanced QAP, projecting embeddings smoothly across planar 2-simplex interiors.',
  'nnls-simplex-embeddings':
    'Evaluates candidate planar triangles τ = (μ₁, μ₂, μ₃) and solves exact Non-Negative Least Squares (wᵢ ≥ 0, ∑ wᵢ = 1) to anchor each vector with minimal reconstruction residual.',
  'pam-medoid-similarity':
    'Operates directly on arbitrary pairwise similarity kernels S(a, b) ∈ [0, 1] without coordinates—selecting real exemplar medoids via PAM swaps and embedding them onto the 60° mesh.',
  'oklab-edge-contrast':
    'Optimizes vertex hue assignment via 1-hop edge swaps to maximize minimum ΔE_OK, then interpolates multi-cluster items in OKLab with chroma restoration.',
  'theme-adaptive-oklab':
    'Adapts perceptual lightness L and chroma C automatically to canvas polarity (L ≈ 0.56 on crisp light backgrounds vs. L ≈ 0.74 on dark obsidian surfaces) while preserving hue identity.',
  'custom-brand-palette':
    'Maps design-system hex swatches onto the simplex mesh using edge-contrast graph coloring while mixing bridge items in perceptual OKLab space.',
  'collision-local-layout':
    'Preserves full 1.00x leaf scale in sparse triangles and shrinks only locally colliding node pockets via iterative SAT separation until 0.0 px overlap is achieved.',
  'pbd-uniform-layout':
    'Seeds co-located nodes on a golden-angle Vogel spiral (137.5°) and binary-searches a single global scale α across the entire atlas so quantitative size ratios remain exact.',
  'warm-start-pbd-layout':
    'Carries settled world coordinates (x, y) from frame t into frame t + 1 during live item mutations so existing nodes settle locally with minimal displacement.',
  'density-adaptive-layout':
    'Estimates smooth local crowd density within radius R prior to final convex SAT relaxation, producing gradual spatial scale transitions from dense cores to outer halos.',
  'subspace-recluster-zoom':
    'Projects out zero-variance parent traits (σ_local = 0), re-clusters covered items over high-variance local features, and aligns 6 labeled sub-clusters onto the 1:4 sub-mesh via exact 6! QAP search.',
  'barycentric-subdivision-zoom':
    'Splits any equilateral triangle along its 3 edge midpoints into 4 conformal sub-triangles (3▲ + 1▼) and applies Adaptive Contrast Stretch to spread tightly bunched items.',
  'semantic-tag-split-zoom':
    'Discovers the most discriminative sub-tags inside a focused triangle and promotes them onto the 3 edge midpoints, re-partitioning items across all 6 sub-vertices.',
  'free-camera-zoom':
    'Applies a continuous 2D affine camera transform (cursor-centered wheel zoom k, pointer pan, and two-finger touch pinch) over fixed world coordinates without re-solving sub-meshes.',
};
---

<figure class="not-prose my-6 rounded-xl border border-slate-200/90 bg-white p-4 sm:p-6 dark:border-slate-800/90 dark:bg-[#0B0F17]">
  <div class="overflow-hidden rounded-lg border border-slate-200/70 bg-slate-50/70 px-3 py-4 sm:px-5 dark:border-slate-800/80 dark:bg-[#07090E]">
    {
      strategyId === 'adaptive-hex-mesh' && (
        <svg viewBox="0 0 640 200" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Adaptive Hex Lattice mechanism">
          <rect x="20" y="24" width="256" height="152" rx="8" fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-dasharray="4 3" />
          <text x="32" y="42" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">Wide Viewport (horizontal, wideFirst: true)</text>
          <g stroke="#06B6D4" stroke-opacity="0.55" stroke-width="1.5" fill="#06B6D4" fill-opacity="0.06">
            <polygon points="66,68 148,68 107,139" />
            <polygon points="148,68 230,68 189,139" />
            <polygon points="107,139 148,68 189,139" />
          </g>
          <line x1="66" y1="56" x2="148" y2="56" stroke="#F59E0B" stroke-width="1.6" />
          <text x="107" y="51" text-anchor="middle" fill="#F59E0B" class="font-mono text-[9.5px] font-semibold">max s (60°)</text>
          {[[66,68],[148,68],[230,68],[107,139],[189,139]].map(([x,y]) => (
            <circle cx={x} cy={y} r="6.5" fill="#06B6D4" />
          ))}

          <path d="M 298 100 L 342 100" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
          <polygon points="342,100 335,96 335,104" fill="currentColor" fill-opacity="0.45" />
          <text x="320" y="90" text-anchor="middle" class="fill-slate-500 font-mono text-[9px]">resize</text>

          <rect x="368" y="16" width="244" height="168" rx="8" fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-dasharray="4 3" />
          <text x="380" y="34" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">Tall Aspect → vertical orientation</text>
          <g stroke="#10B981" stroke-opacity="0.55" stroke-width="1.5" fill="#10B981" fill-opacity="0.06">
            <polygon points="452,52 524,93 452,134" />
            <polygon points="452,134 524,93 524,175" />
            <polygon points="524,93 596,52 596,134" />
          </g>
          {[[452,52],[524,93],[452,134],[524,175],[596,52],[596,134]].map(([x,y]) => (
            <circle cx={x} cy={y} r="6.5" fill="#10B981" />
          ))}
        </svg>
      )
    }

    {
      strategyId === 'fixed-grid-mesh' && (
        <svg viewBox="0 0 640 200" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Fixed Grid Lattice mechanism">
          <text x="24" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">Pinned Grid: cols = 3, rows = 2 (K = 6 invariant)</text>
          <g stroke="#F59E0B" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="4 3" fill="#F59E0B" fill-opacity="0.05">
            <polygon points="56,64 146,64 101,142" />
            <polygon points="146,64 236,64 191,142" />
            <polygon points="101,142 146,64 191,142" />
            <polygon points="236,64 281,142 191,142" />
          </g>
          {[[56,64,'0,0'],[146,64,'0,1'],[236,64,'0,2'],[101,142,'1,0'],[191,142,'1,1'],[281,142,'1,2']].map(([x,y,lbl]) => (
            <g>
              <circle cx={x} cy={y} r="12" fill="#F59E0B" fill-opacity="0.2" stroke="#F59E0B" stroke-width="1.5" />
              <text x={x} y={Number(y)+3} text-anchor="middle" class="fill-current font-mono text-[8.5px] font-semibold">{lbl}</text>
            </g>
          ))}

          <path d="M 308 104 L 352 104" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
          <polygon points="352,104 345,100 345,108" fill="currentColor" fill-opacity="0.45" />
          <text x="330" y="94" text-anchor="middle" class="fill-slate-500 font-mono text-[9px]">compact</text>

          <text x="376" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">Same (r, c) indices · scaled side s&apos;</text>
          <g stroke="#06B6D4" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="4 3" fill="#06B6D4" fill-opacity="0.05">
            <polygon points="396,74 462,74 429,131" />
            <polygon points="462,74 528,74 495,131" />
            <polygon points="429,131 462,74 495,131" />
            <polygon points="528,74 561,131 495,131" />
          </g>
          {[[396,74,'0,0'],[462,74,'0,1'],[528,74,'0,2'],[429,131,'1,0'],[495,131,'1,1'],[561,131,'1,2']].map(([x,y,lbl]) => (
            <g>
              <circle cx={x} cy={y} r="10.5" fill="#06B6D4" fill-opacity="0.2" stroke="#06B6D4" stroke-width="1.5" />
              <text x={x} y={Number(y)+3} text-anchor="middle" class="fill-current font-mono text-[8px] font-semibold">{lbl}</text>
            </g>
          ))}
        </svg>
      )
    }

    {
      strategyId === 'soft-simplex-tags' && (
        <svg viewBox="0 0 640 205" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Soft-Simplex Tag Clustering mechanism">
          <text x="28" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">1. Multi-Tag Corpus</text>
          <rect x="28" y="42" width="166" height="34" rx="6" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.2" />
          <text x="38" y="63" class="fill-current font-mono text-[10px]">Item A: [#cg, #gr, #ml]</text>
          <rect x="28" y="86" width="166" height="34" rx="6" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.2" />
          <text x="38" y="107" class="fill-current font-mono text-[10px]">Item B: [#cg, #gr]</text>
          <rect x="28" y="130" width="166" height="34" rx="6" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.2" />
          <text x="38" y="151" class="fill-current font-mono text-[10px]">Item C: [#cg] (1-tag)</text>

          <path d="M 214 104 L 268 104" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
          <polygon points="268,104 261,100 261,108" fill="currentColor" fill-opacity="0.45" />
          <text x="241" y="93" text-anchor="middle" class="fill-cyan-600 dark:fill-cyan-400 font-mono text-[9px]">spread 0.45</text>

          <text x="296" y="24" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">2. Interior Simplex Spread + 360° Halo</text>
          <circle cx="445" cy="52" r="32" fill="none" stroke="#06B6D4" stroke-opacity="0.45" stroke-dasharray="3 3" stroke-width="1.4" />
          <polygon points="445,52 345,182 545,182" fill="#06B6D4" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 3" />
          <circle cx="445" cy="52" r="13" fill="#06B6D4" />
          <circle cx="345" cy="182" r="13" fill="#F59E0B" />
          <circle cx="545" cy="182" r="13" fill="#D946EF" />
          <text x="445" y="56" text-anchor="middle" fill="#fff" class="font-mono text-[9px] font-bold">#cg</text>
          <text x="345" y="186" text-anchor="middle" fill="#fff" class="font-mono text-[9px] font-bold">#gr</text>
          <text x="545" y="186" text-anchor="middle" fill="#fff" class="font-mono text-[9px] font-bold">#ml</text>

          <circle cx="416" cy="36" r="5.5" fill="#06B6D4" />
          <circle cx="474" cy="37" r="5.5" fill="#06B6D4" />
          <circle cx="445" cy="21" r="5.5" fill="#06B6D4" />
          <text x="515" y="34" class="fill-cyan-600 dark:fill-cyan-400 font-mono text-[9px]">360° halo (C)</text>

          <circle cx="395" cy="117" r="6" fill="#52C280" />
          <circle cx="430" cy="122" r="6" fill="#4BA8B8" />
          <circle cx="462" cy="134" r="6.5" fill="#9D8AC7" />
          <circle cx="442" cy="154" r="6" fill="#B58E92" />
          <circle cx="486" cy="152" r="5.5" fill="#BA7AC8" />
        </svg>
      )
    }

    {
      strategyId === 'jaccard-qap-tags' && (
        <svg viewBox="0 0 640 205" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Jaccard QAP Annealing mechanism">
          <text x="24" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">1. QAP Simulated Annealing</text>
          <line x1="70" y1="75" x2="175" y2="75" stroke="#06B6D4" stroke-width="2.5" />
          <line x1="70" y1="75" x2="122" y2="158" stroke="#10B981" stroke-width="2.5" />
          <line x1="175" y1="75" x2="122" y2="158" stroke="#F59E0B" stroke-width="1.4" stroke-dasharray="3 3" />
          <circle cx="70" cy="75" r="14" fill="#06B6D4" />
          <circle cx="175" cy="75" r="14" fill="#F59E0B" />
          <circle cx="122" cy="158" r="14" fill="#D946EF" />
          <text x="122" y="65" text-anchor="middle" class="fill-current font-mono text-[9px]">high Jaccard → 1-hop edge</text>

          <path d="M 235 108 L 295 108" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
          <polygon points="295,108 288,104 288,112" fill="currentColor" fill-opacity="0.45" />
          <text x="265" y="96" text-anchor="middle" class="fill-slate-500 font-mono text-[9px]">anchor</text>

          <text x="328" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">2. Crisp Vertex / Edge / Centroid Snapping</text>
          <polygon points="465,42 368,178 562,178" fill="currentColor" fill-opacity="0.03" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 3" />
          <circle cx="465" cy="42" r="13" fill="#06B6D4" />
          <circle cx="368" cy="178" r="13" fill="#F59E0B" />
          <circle cx="562" cy="178" r="13" fill="#D946EF" />
          <circle cx="416.5" cy="110" r="7" fill="#5DC479" stroke="#fff" stroke-width="1.2" />
          <circle cx="513.5" cy="110" r="7" fill="#709CE1" stroke="#fff" stroke-width="1.2" />
          <circle cx="465" cy="178" r="7" fill="#E67A83" stroke="#fff" stroke-width="1.2" />
          <circle cx="465" cy="132" r="7.5" fill="#A58EB8" stroke="#fff" stroke-width="1.2" />
          <text x="465" y="152" text-anchor="middle" class="fill-slate-500 dark:fill-slate-400 font-mono text-[9px]">w = (⅓, ⅓, ⅓)</text>
        </svg>
      )
    }

    {
      strategyId === 'incremental-anchor-tags' && (
        <svg viewBox="0 0 640 200" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Incremental Tag Anchoring mechanism">
          <text x="24" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">Frame t (Frozen Vertex Anchors &amp; UIDs)</text>
          <polygon points="125,46 52,166 198,166" fill="none" stroke="currentColor" stroke-opacity="0.32" stroke-width="1.5" stroke-dasharray="4 3" />
          <circle cx="125" cy="46" r="13" fill="#06B6D4" />
          <circle cx="52" cy="166" r="13" fill="#F59E0B" />
          <circle cx="198" cy="166" r="13" fill="#D946EF" />
          <text x="125" y="50" text-anchor="middle" fill="#fff" class="font-mono text-[8.5px] font-bold">C1🔒</text>
          <text x="52" y="170" text-anchor="middle" fill="#fff" class="font-mono text-[8.5px] font-bold">C2🔒</text>
          <text x="198" y="170" text-anchor="middle" fill="#fff" class="font-mono text-[8.5px] font-bold">C3🔒</text>

          <path d="M 248 106 L 328 106" stroke="#06B6D4" stroke-width="1.6" />
          <polygon points="328,106 320,102 320,110" fill="#06B6D4" />
          <text x="288" y="94" text-anchor="middle" class="fill-cyan-600 dark:fill-cyan-400 font-mono text-[9.5px]">+ addItems()</text>

          <text x="364" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">Frame t+1 (Zero Global Reshuffle)</text>
          <polygon points="475,46 402,166 548,166" fill="none" stroke="currentColor" stroke-opacity="0.32" stroke-width="1.5" stroke-dasharray="4 3" />
          <circle cx="475" cy="46" r="13" fill="#06B6D4" />
          <circle cx="402" cy="166" r="13" fill="#F59E0B" />
          <circle cx="548" cy="166" r="13" fill="#D946EF" />
          <circle cx="514" cy="106" r="7.5" fill="#10B981" stroke="#fff" stroke-width="1.5" />
          <circle cx="514" cy="106" r="13" fill="none" stroke="#10B981" stroke-dasharray="2 2" />
          <text x="572" y="109" class="fill-emerald-600 dark:fill-emerald-400 font-mono text-[9.5px] font-semibold">new tag tethered</text>
        </svg>
      )
    }

    {
      strategyId === 'soft-simplex-embeddings' && (
        <svg viewBox="0 0 640 205" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Soft-Simplex Embedding Projection mechanism">
          <text x="24" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">1. Multi-Modal Vector Sources</text>
          <rect x="24" y="46" width="176" height="44" rx="7" fill="#06B6D4" fill-opacity="0.08" stroke="#06B6D4" stroke-opacity="0.5" />
          <text x="36" y="65" class="fill-current font-mono text-[9.5px] font-semibold">v_scene ∈ ℝ^d (w = 0.65)</text>
          <text x="36" y="80" class="fill-slate-500 font-mono text-[9px]">[0.91, 0.14, 0.62, ...]</text>

          <rect x="24" y="106" width="176" height="44" rx="7" fill="#F59E0B" fill-opacity="0.08" stroke="#F59E0B" stroke-opacity="0.5" />
          <text x="36" y="125" class="fill-current font-mono text-[9.5px] font-semibold">v_style ∈ ℝ^m (w = 0.35)</text>
          <text x="36" y="140" class="fill-slate-500 font-mono text-[9px]">[0.28, 0.88, 0.41, ...]</text>

          <path d="M 220 100 L 292 100" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
          <polygon points="292,100 285,96 285,104" fill="currentColor" fill-opacity="0.45" />
          <text x="256" y="88" text-anchor="middle" class="fill-slate-500 font-mono text-[9px]">k-Means++ &amp; QAP</text>

          <text x="326" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">2. Smooth Interior 2-Simplex Projection</text>
          <polygon points="468,42 372,178 564,178" fill="#06B6D4" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 3" />
          <circle cx="468" cy="42" r="13" fill="#06B6D4" />
          <circle cx="372" cy="178" r="13" fill="#F59E0B" />
          <circle cx="564" cy="178" r="13" fill="#D946EF" />
          {[[448,96,'#23B9B5'],[484,106,'#6B9BE4'],[432,134,'#7FB576'],[468,128,'#9B94BF'],[502,144,'#BC7EC6'],[456,158,'#C8897E']].map(([x,y,c]) => (
            <circle cx={x} cy={y} r="6" fill={String(c)} />
          ))}
        </svg>
      )
    }

    {
      strategyId === 'nnls-simplex-embeddings' && (
        <svg viewBox="0 0 640 205" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Planar NNLS Embedding Projection mechanism">
          <text x="28" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">Orthogonal Projection onto Planar 2-Simplex Δ²</text>
          <polygon points="195,58 85,172 315,162" fill="#06B6D4" fill-opacity="0.08" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
          <circle cx="195" cy="58" r="10" fill="#06B6D4" />
          <circle cx="85" cy="172" r="10" fill="#F59E0B" />
          <circle cx="315" cy="162" r="10" fill="#D946EF" />
          <text x="195" y="43" text-anchor="middle" class="fill-current font-mono text-[10px]">μ₁</text>
          <text x="68" y="176" text-anchor="middle" class="fill-current font-mono text-[10px]">μ₂</text>
          <text x="334" y="166" text-anchor="middle" class="fill-current font-mono text-[10px]">μ₃</text>

          <circle cx="242" cy="48" r="6.5" fill="#10B981" />
          <text x="262" y="51" class="fill-emerald-600 dark:fill-emerald-400 font-mono text-[10px] font-semibold">x ∈ ℝ^d</text>
          <line x1="242" y1="48" x2="204" y2="128" stroke="#10B981" stroke-width="1.6" stroke-dasharray="4 3" />
          <circle cx="204" cy="128" r="7" fill="#10B981" stroke="#fff" stroke-width="1.5" />
          <text x="204" y="148" text-anchor="middle" class="fill-current font-mono text-[9.5px] font-semibold">x̂ = ∑ wᵢμᵢ</text>

          <rect x="372" y="56" width="242" height="96" rx="8" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-opacity="0.18" />
          <text x="388" y="82" class="fill-current font-mono text-[10.5px] font-semibold">Closed-Form Planar NNLS:</text>
          <text x="388" y="106" class="fill-cyan-700 dark:fill-cyan-300 font-mono text-[10px]">min ‖x − (w₁μ₁ + w₂μ₂ + w₃μ₃)‖₂²</text>
          <text x="388" y="128" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">s.t. wᵢ ≥ 0,  w₁ + w₂ + w₃ = 1</text>
        </svg>
      )
    }

    {
      strategyId === 'pam-medoid-similarity' && (
        <svg viewBox="0 0 640 205" class="w-full h-auto text-slate-800 dark:text-slate-200" role="img" aria-label="Pairwise k-Medoids Projection mechanism">
          <text x="28" y="28" class="fill-slate-500 dark:fill-slate-400 font-mono text-[10px]">1. Kernel Matrix S(a, b) ∈ [0, 1]</text>
          {[0,1,2,3,4].map((r) =>
            [0,1,2,3,4].map((c) => {
              const diag = r === c;
              const hi = (r + c) % 3 === 0;
              return (
                <rect
                  x={36 + c * 28}
                  y={44 + r * 26}
                  width="24"
                  height="22"
                  rx="3"
                  fill={diag ? '#06B6D4' : hi ? '#06B6D4' : '#64748B'}
                  fill-opacity={diag ? '0.85' : hi ? '0.42' : '0.15'}
                />
              );
            })
          )}

          <path d="M 206 108 L 282 108" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
