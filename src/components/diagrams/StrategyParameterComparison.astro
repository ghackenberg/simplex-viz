---
interface Props {
  kind: 'clustering' | 'layout' | 'zoom';
  caption?: string;
}

const { kind, caption } = Astro.props;
---

<figure class="not-prose my-8 rounded-xl border border-slate-200/90 bg-white p-4 sm:p-6 dark:border-slate-800/80 dark:bg-[#0B0F17]">
  {
    kind === 'clustering' && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:divide-x md:divide-slate-200/80 dark:md:divide-slate-800/80">
        <div>
          <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-100">
            triangleSpread: 0.00
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Crisp snapping onto vertices, edge midpoints &amp; centroid
          </p>
          <svg
            viewBox="0 0 240 175"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Discrete snapping at triangleSpread 0.00"
          >
            <polygon
              points="120,24 44,152 196,152"
              fill="currentColor"
              fill-opacity="0.03"
              stroke="currentColor"
              stroke-opacity="0.32"
              stroke-width="1.4"
              stroke-dasharray="4 3"
            />
            <circle cx="120" cy="24" r="10.5" fill="#06B6D4" />
            <circle cx="44" cy="152" r="10.5" fill="#F59E0B" />
            <circle cx="196" cy="152" r="10.5" fill="#D946EF" />
            <text x="120" y="27.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C1</text>
            <text x="44" y="155.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C2</text>
            <text x="196" y="155.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C3</text>

            {/* Stacked / tight discrete midpoints */}
            <circle cx="82" cy="88" r="5" fill="#52C280" stroke="#fff" stroke-width="1.1" />
            <circle cx="88" cy="78" r="5" fill="#18C1A8" stroke="#fff" stroke-width="1.1" />
            <circle cx="158" cy="88" r="5" fill="#709CE1" stroke="#fff" stroke-width="1.1" />
            <circle cx="120" cy="152" r="5" fill="#E67A83" stroke="#fff" stroke-width="1.1" />
            <circle cx="120" cy="109" r="5.5" fill="#A58EB8" stroke="#fff" stroke-width="1.1" />
            <circle cx="111" cy="115" r="5" fill="#9B96BE" stroke="#fff" stroke-width="1.1" />
            <circle cx="129" cy="115" r="5" fill="#B58E92" stroke="#fff" stroke-width="1.1" />

            {/* Single-tag nodes close to C1 */}
            <circle cx="101" cy="17" r="4.5" fill="#06B6D4" />
            <circle cx="139" cy="17" r="4.5" fill="#06B6D4" />
          </svg>
        </div>

        <div class="md:pl-5">
          <p class="font-mono text-xs font-semibold text-cyan-700 dark:text-cyan-300">
            triangleSpread: 0.45 (Default)
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Balanced interior area + free 360° single-tag halo
          </p>
          <svg
            viewBox="0 0 240 175"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Balanced interior spread at triangleSpread 0.45"
          >
            <circle
              cx="120"
              cy="30"
              r="22"
              fill="none"
              stroke="#06B6D4"
              stroke-opacity="0.38"
              stroke-dasharray="3 3"
              stroke-width="1.2"
            />
            <polygon
              points="120,30 44,154 196,154"
              fill="#06B6D4"
              fill-opacity="0.05"
              stroke="currentColor"
              stroke-opacity="0.32"
              stroke-width="1.4"
              stroke-dasharray="4 3"
            />
            <circle cx="120" cy="30" r="10.5" fill="#06B6D4" />
            <circle cx="44" cy="154" r="10.5" fill="#F59E0B" />
            <circle cx="196" cy="154" r="10.5" fill="#D946EF" />
            <text x="120" y="33.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C1</text>
            <text x="44" y="157.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C2</text>
            <text x="196" y="157.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C3</text>

            {/* Unconstrained 360° halo */}
            <circle cx="96" cy="20" r="4.5" fill="#06B6D4" />
            <circle cx="144" cy="20" r="4.5" fill="#06B6D4" />
            <circle cx="120" cy="8" r="4.5" fill="#06B6D4" />

            {/* Balanced triangle interior */}
            <circle cx="102" cy="86" r="5" fill="#23B9B5" />
            <circle cx="136" cy="92" r="5" fill="#6F9CE8" />
            <circle cx="118" cy="108" r="5" fill="#9B96BE" />
            <circle cx="92" cy="122" r="5" fill="#B9A45A" />
            <circle cx="146" cy="124" r="5" fill="#BD79C9" />
            <circle cx="120" cy="136" r="5" fill="#C97F8F" />
          </svg>
        </div>

        <div class="md:pl-5">
          <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-100">
            triangleSpread: 0.90
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Broad diffusion toward central triangle barycenter
          </p>
          <svg
            viewBox="0 0 240 175"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Broad diffusion at triangleSpread 0.90"
          >
            <circle
              cx="120"
              cy="30"
              r="22"
              fill="none"
              stroke="#06B6D4"
              stroke-opacity="0.38"
              stroke-dasharray="3 3"
              stroke-width="1.2"
            />
            <polygon
              points="120,30 44,154 196,154"
              fill="#06B6D4"
              fill-opacity="0.06"
              stroke="currentColor"
              stroke-opacity="0.32"
              stroke-width="1.4"
              stroke-dasharray="4 3"
            />
            <circle cx="120" cy="30" r="10.5" fill="#06B6D4" />
            <circle cx="44" cy="154" r="10.5" fill="#F59E0B" />
            <circle cx="196" cy="154" r="10.5" fill="#D946EF" />
            <text x="120" y="33.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C1</text>
            <text x="44" y="157.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C2</text>
            <text x="196" y="157.5" text-anchor="middle" fill="#fff" class="font-mono text-[8px] font-bold">C3</text>

            {/* Unconstrained 360° halo remains free */}
            <circle cx="96" cy="20" r="4.5" fill="#06B6D4" />
            <circle cx="144" cy="20" r="4.5" fill="#06B6D4" />
            <circle cx="120" cy="8" r="4.5" fill="#06B6D4" />

            {/* Broad diffusion across full interior */}
            <circle cx="116" cy="68" r="5" fill="#4EB6B2" />
            <circle cx="102" cy="100" r="5" fill="#7CA895" />
            <circle cx="138" cy="102" r="5" fill="#8D8EC6" />
            <circle cx="120" cy="112" r="5.5" fill="#9E92A8" />
            <circle cx="82" cy="134" r="5" fill="#BA9E66" />
            <circle cx="154" cy="134" r="5" fill="#B97EB8" />
          </svg>
        </div>
      </div>
    )
  }

  {
    kind === 'layout' && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:divide-x md:divide-slate-200/80 dark:md:divide-slate-800/80">
        <div>
          <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-100">
            Uniform PBD
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Global scale α = 0.50 everywhere preserves exact size ratios
          </p>
          <svg
            viewBox="0 0 240 165"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Uniform PBD global scaling comparison"
          >
            <polygon points="74,22 22,126 126,126" fill="#06B6D4" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />
            <polygon points="126,126 74,22 178,22" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />
            <polygon points="178,22 126,126 230,126" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />

            {[
              [64, 72], [82, 70], [74, 86], [92, 84], [54, 92],
              [70, 102], [88, 100], [56, 114], [74, 116], [92, 114], [108, 114],
            ].map(([cx, cy]) => (
              <circle cx={cx} cy={cy} r="4.5" fill="#06B6D4" />
            ))}
            <circle cx="172" cy="92" r="4.5" fill="#D946EF" />
            <circle cx="192" cy="108" r="4.5" fill="#D946EF" />

            <text x="74" y="148" text-anchor="middle" class="fill-slate-500 dark:fill-slate-400 font-mono text-[9px]">α = 0.50</text>
            <text x="178" y="148" text-anchor="middle" class="fill-slate-500 dark:fill-slate-400 font-mono text-[9px]">α = 0.50 (uniform)</text>
          </svg>
        </div>

        <div class="md:pl-5">
          <p class="font-mono text-xs font-semibold text-cyan-700 dark:text-cyan-300">
            Collision-Local Pocket
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Only colliding pockets shrink; sparse triangles stay at 1.00x
          </p>
          <svg
            viewBox="0 0 240 165"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Collision-Local Pocket scaling comparison"
          >
            <polygon points="74,22 22,126 126,126" fill="#06B6D4" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />
            <polygon points="126,126 74,22 178,22" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />
            <polygon points="178,22 126,126 230,126" fill="#D946EF" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />

            {[
              [64, 72], [82, 70], [74, 86], [92, 84], [54, 92],
              [70, 102], [88, 100], [56, 114], [74, 116], [92, 114], [108, 114],
            ].map(([cx, cy]) => (
              <circle cx={cx} cy={cy} r="4.5" fill="#06B6D4" />
            ))}
            <circle cx="166" cy="86" r="9.5" fill="#D946EF" />
            <circle cx="192" cy="108" r="9.5" fill="#D946EF" />

            <text x="74" y="148" text-anchor="middle" class="fill-cyan-600 dark:fill-cyan-400 font-mono text-[9px] font-semibold">α = 0.50 (drillable)</text>
            <text x="178" y="148" text-anchor="middle" class="fill-fuchsia-600 dark:fill-fuchsia-400 font-mono text-[9px] font-semibold">α = 1.00 (leaf)</text>
          </svg>
        </div>

        <div class="md:pl-5">
          <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-100">
            Density-Adaptive
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Smooth radial crowd kernel R transitions core → fringe size
          </p>
          <svg
            viewBox="0 0 240 165"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Density-Adaptive radial kernel comparison"
          >
            <polygon points="74,22 22,126 126,126" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />
            <polygon points="126,126 74,22 178,22" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />
            <polygon points="178,22 126,126 230,126" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="4 3" stroke-width="1.3" />
            <circle cx="74" cy="96" r="34" fill="#06B6D4" fill-opacity="0.08" stroke="#06B6D4" stroke-opacity="0.45" stroke-dasharray="3 3" stroke-width="1.2" />

            {[
              [65, 82, 4.5], [82, 82, 4.5], [74, 96, 4.2], [58, 98, 5.2], [90, 98, 5.2],
              [64, 112, 5.6], [84, 112, 5.6], [108, 108, 7.2],
            ].map(([cx, cy, r]) => (
              <circle cx={cx} cy={cy} r={r} fill="#06B6D4" />
            ))}
            <circle cx="166" cy="86" r="9.5" fill="#D946EF" />
            <circle cx="192" cy="108" r="9.5" fill="#D946EF" />

            <text x="120" y="148" text-anchor="middle" class="fill-slate-500 dark:fill-slate-400 font-mono text-[9px]">Smooth R = 76 px size gradient</text>
          </svg>
        </div>
      </div>
    )
  }

  {
    kind === 'zoom' && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:divide-x md:divide-slate-200/80 dark:md:divide-slate-800/80">
        <div>
          <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-100">
            Barycentric 1:4
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Pure coordinate stretch + explicit A ↔ B midpoint bridges
          </p>
          <svg
            viewBox="0 0 240 175"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Barycentric 1:4 drill-down result"
          >
            <polygon points="120,26 42,154 198,154" fill="#06B6D4" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" />
            <polygon points="81,90 159,90 120,154" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="4 3" stroke-width="1.3" />

            <circle cx="120" cy="26" r="9.5" fill="#06B6D4" />
            <circle cx="42" cy="154" r="9.5" fill="#F59E0B" />
            <circle cx="198" cy="154" r="9.5" fill="#D946EF" />
            <circle cx="81" cy="90" r="7.5" fill="#5DC479" />
            <circle cx="159" cy="90" r="7.5" fill="#709CE1" />
            <circle cx="120" cy="154" r="7.5" fill="#E67A83" />

            <text x="120" y="12" text-anchor="middle" class="fill-current font-mono text-[8.5px]">Physics</text>
            <text x="70" y="83" text-anchor="end" class="fill-slate-500 dark:fill-slate-400 font-mono text-[8px]">Phy↔Math</text>
            <text x="170" y="83" class="fill-slate-500 dark:fill-slate-400 font-mono text-[8px]">Phy↔CS</text>
            <text x="120" y="170" text-anchor="middle" class="fill-slate-500 dark:fill-slate-400 font-mono text-[8px]">Math ↔ CS</text>
          </svg>
        </div>

        <div class="md:pl-5">
          <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-100">
            Semantic 3→6 Tags
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Promotes discriminative sub-tags onto the 3 edge midpoints
          </p>
          <svg
            viewBox="0 0 240 175"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Semantic 3 to 6 tag promotion result"
          >
            <polygon points="120,26 42,154 198,154" fill="#10B981" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" />
            <polygon points="81,90 159,90 120,154" fill="#F59E0B" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="4 3" stroke-width="1.3" />

            <circle cx="120" cy="26" r="9.5" fill="#06B6D4" />
            <circle cx="42" cy="154" r="9.5" fill="#F59E0B" />
            <circle cx="198" cy="154" r="9.5" fill="#D946EF" />
            <circle cx="81" cy="90" r="8.5" fill="#10B981" />
            <circle cx="159" cy="90" r="8.5" fill="#6366F1" />
            <circle cx="120" cy="154" r="8.5" fill="#EC4899" />

            <text x="120" y="12" text-anchor="middle" class="fill-current font-mono text-[8.5px]">Physics</text>
            <text x="68" y="84" text-anchor="end" class="fill-emerald-600 dark:fill-emerald-400 font-mono text-[8.5px] font-semibold">#optics</text>
            <text x="172" y="84" class="fill-indigo-600 dark:fill-indigo-400 font-mono text-[8.5px] font-semibold">#mesh</text>
            <text x="120" y="170" text-anchor="middle" class="fill-pink-600 dark:fill-pink-400 font-mono text-[8.5px] font-semibold">#graphs</text>
          </svg>
        </div>

        <div class="md:pl-5">
          <p class="font-mono text-xs font-semibold text-cyan-700 dark:text-cyan-300">
            Subspace Re-Cluster
          </p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
            Filters zero-variance traits &amp; re-clusters all 6 sub-vertices
          </p>
          <svg
            viewBox="0 0 240 175"
            class="mt-2.5 w-full h-auto text-slate-800 dark:text-slate-200"
            role="img"
            aria-label="Subspace Re-Clustering drill-down result"
          >
            <polygon points="120,26 42,154 198,154" fill="#06B6D4" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" />
            <polygon points="81,90 159,90 120,154" fill="#06B6D4" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="4 3" stroke-width="1.3" />

            <circle cx="120" cy="26" r="9.5" fill="#06B6D4" />
            <circle cx="42" cy="154" r="9.5" fill="#F59E0B" />
            <circle cx="198" cy="154" r="9.5" fill="#D946EF" />
            <circle cx="81" cy="90" r="8.5" fill="#10B981" />
            <circle cx="159" cy="90" r="8.5" fill="#6366F1" />
            <circle cx="120" cy="154" r="8.5" fill="#EC4899" />

            <text x="120" y="12" text-anchor="middle" class="fill-cyan-700 dark:fill-cyan-300 font-mono text-[8px] font-semibold">Phy · High-σ₁</text>
            <text x="68" y="84" text-anchor="end" class="fill-emerald-600 dark:fill-emerald-400 font-mono text-[8px] font-semibold">Aquatic</text>
            <text x="172" y="84" class="fill-indigo-600 dark:fill-indigo-400 font-mono text-[8px] font-semibold">Recent</text>
            <text x="120" y="170" text-anchor="middle" class="fill-pink-600 dark:fill-pink-400 font-mono text-[8px] font-semibold">Small-Scale</text>
          </svg>
        </div>
      </div>
    )
  }

  {
    caption && (
      <figcaption class="mt-4 border-t border-slate-200/70 pt-3 text-xs leading-relaxed text-slate-500 dark:border-slate-800/80 dark:text-slate-400">
        {caption}
      </figcaption>
    )
  }
</figure>
