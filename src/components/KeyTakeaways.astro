---
interface Props {
  points: readonly string[];
  title?: string;
}

const { points, title = 'Key Takeaways' } = Astro.props;
---

{
  points.length > 0 && (
    <section
      aria-label={title}
      class="not-prose rounded-xl border border-slate-200/90 bg-white p-5 sm:p-6 dark:border-slate-800/85 dark:bg-[#0B0F17]"
    >
      <h2 class="text-base font-semibold tracking-tight text-slate-950 dark:text-white">
        {title}
      </h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-[15.5px] leading-[1.7] text-slate-700 dark:text-slate-300">
        {points.map((pt) => (
          <li>{pt}</li>
        ))}
      </ul>
    </section>
  )
}
