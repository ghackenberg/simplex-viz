---
export type PageMetaIcon =
  | 'author'
  | 'calendar'
  | 'clock'
  | 'layers'
  | 'package'
  | 'check'
  | 'tag';

export interface PageMetaItem {
  readonly icon: PageMetaIcon;
  readonly label: string;
  readonly href?: string;
  readonly external?: boolean;
  readonly mono?: boolean;
  readonly tone?: 'default' | 'emerald';
}

interface Props {
  items: readonly PageMetaItem[];
  showCopyLink?: boolean;
  align?: 'left' | 'center';
}

const { items, showCopyLink = false, align = 'left' } = Astro.props;
const isCentered = align === 'center';
---

{
  (items.length > 0 || showCopyLink) && (
    <div
      class:list={[
        'mt-6 flex flex-wrap items-center gap-x-5 gap-y-2.5 border-y border-slate-200/90 py-3 text-xs dark:border-slate-800/90',
        isCentered ? 'justify-center' : 'justify-between',
      ]}
    >
      <ul
        class:list={[
          'flex flex-wrap items-center gap-x-5 gap-y-2 tabular-nums',
          isCentered && 'justify-center',
        ]}
      >
        {items.map((item) => {
          const isEmerald = item.tone === 'emerald';
          const iconColorClass = isEmerald
            ? 'text-emerald-600 dark:text-emerald-400'
            : 'text-cyan-600 dark:text-cyan-400';
          const textClasses = [
            item.mono ? 'font-mono' : 'font-medium',
            isEmerald
              ? 'font-medium text-emerald-700 dark:text-emerald-400'
              : 'text-slate-700 dark:text-slate-200',
          ];

          return (
            <li class="inline-flex min-w-0 items-center gap-1.5">
              {item.icon === 'author' && (
                <svg
                  class:list={['h-3.5 w-3.5 shrink-0', iconColorClass]}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="8" cy="5.25" r="2.5" />
                  <path d="M3.25 13.25c.65-2.3 2.55-3.5 4.75-3.5s4.1 1.2 4.75 3.5" />
                </svg>
              )}
              {item.icon === 'calendar' && (
                <svg
                  class:list={['h-3.5 w-3.5 shrink-0', iconColorClass]}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="2.5" y="3.25" width="11" height="10.25" rx="1.75" />
                  <path d="M5.25 2v2.25M10.75 2v2.25M2.5 6.5h11" />
                </svg>
              )}
              {item.icon === 'clock' && (
                <svg
                  class:list={['h-3.5 w-3.5 shrink-0', iconColorClass]}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="8" cy="8" r="5.5" />
                  <path d="M8 5v3.25l2.25 1.25" />
                </svg>
              )}
              {item.icon === 'layers' && (
                <svg
                  class:list={['h-3.5 w-3.5 shrink-0', iconColorClass]}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polygon points="8,2.25 13.75,5.25 8,8.25 2.25,5.25" />
                  <path d="M2.25 8.25 8 11.25l5.75-3" />
                  <path d="M2.25 11 8 14l5.75-3" />
                </svg>
              )}
              {item.icon === 'package' && (
                <svg
                  class:list={['h-3.5 w-3.5 shrink-0', iconColorClass]}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M8 2 13.25 5v6L8 14 2.75 11V5L8 2Z" />
                  <path d="M2.75 5 8 8l5.25-3M8 8v6" />
                </svg>
              )}
              {item.icon === 'check' && (
                <svg
                  class:list={['h-3.5 w-3.5 shrink-0', iconColorClass]}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="8" cy="8" r="5.5" />
                  <path d="m5.6 8.1 1.6 1.6 3.3-3.4" />
                </svg>
              )}
              {item.icon === 'tag' && (
                <svg
                  class:list={['h-3.5 w-3.5 shrink-0', iconColorClass]}
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M2.5 8.4V3.5a1 1 0 0 1 1-1h4.9l5.1 5.1a1.2 1.2 0 0 1 0 1.7l-4.2 4.2a1.2 1.2 0 0 1-1.7 0L2.5 8.4Z" />
                  <circle cx="5.5" cy="5.5" r="0.85" fill="currentColor" />
                </svg>
              )}

              {item.href ? (
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  class:list={[
                    ...textClasses,
                    'truncate font-semibold text-slate-900 hover:text-cyan-700 hover:underline dark:text-slate-100 dark:hover:text-cyan-300 transition-colors',
                  ]}
                >
                  {item.label}
                </a>
              ) : (
                <span class:list={[...textClasses, 'truncate']}>{item.label}</span>
              )}
            </li>
          );
        })}
      </ul>

      {showCopyLink && isCentered && items.length > 0 && (
        <span
          aria-hidden="true"
          class="hidden sm:inline-block h-3.5 w-px bg-slate-200 dark:bg-slate-800"
        />
      )}

      {showCopyLink && (
        <button
          type="button"
          data-copy-page-url
          class:list={[
            'inline-flex cursor-pointer items-center gap-1.5 rounded-md px-2 py-1 -my-1 text-xs font-semibold text-cyan-700 transition-colors hover:bg-slate-200/60 hover:text-cyan-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:text-cyan-300 dark:hover:bg-slate-800/70 dark:hover:text-cyan-200 whitespace-nowrap',
            !isCentered && 'ml-auto',
          ]}
        >
          <svg
            class="h-3.5 w-3.5 shrink-0"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6.75 9.25a3.18 3.18 0 0 0 4.5 0l2-2a3.18 3.18 0 0 0-4.5-4.5l-1.1 1.1" />
            <path d="M9.25 6.75a3.18 3.18 0 0 0-4.5 0l-2 2a3.18 3.18 0 0 0 4.5 4.5l1.1-1.1" />
          </svg>
          <span data-copy-page-label>Copy link</span>
        </button>
      )}
    </div>
  )
}

<script is:inline>
  (function () {
    if (window.__svCopyPageUrlBound) return;
    window.__svCopyPageUrlBound = true;
    document.addEventListener('click', function (ev) {
      var btn =
        ev.target && ev.target.closest
          ? ev.target.closest('[data-copy-page-url]')
          : null;
      if (!btn || !navigator.clipboard) return;
      var labelEl = btn.querySelector('[data-copy-page-label]');
      navigator.clipboard.writeText(window.location.href).then(function () {
        if (!labelEl) return;
        var orig = labelEl.getAttribute('data-orig-label') || labelEl.textContent;
        labelEl.setAttribute('data-orig-label', orig || 'Copy link');
        labelEl.textContent = 'Link copied';
        setTimeout(function () {
          labelEl.textContent = orig || 'Copy link';
        }, 1500);
      });
    });
  })();
</script>
