---
import { withBase } from '../site/url';

export interface BreadcrumbItem {
  readonly label: string;
  readonly href?: string;
}

interface Props {
  items: readonly BreadcrumbItem[];
  align?: 'left' | 'center';
}

const { items, align = 'left' } = Astro.props;
const trail: BreadcrumbItem[] = [
  { label: 'Home', href: withBase('/') },
  ...items.map((item) => ({
    label: item.label,
    href: item.href ? withBase(item.href) : undefined,
  })),
];
---

<nav
  aria-label="Breadcrumb"
  class:list={['mb-4 flex', align === 'center' ? 'justify-center' : 'justify-start']}
>
  <ol
    class:list={[
      'inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-normal',
      align === 'center' && 'justify-center',
    ]}
  >
    {
      trail.map((item, idx) => {
        const isFirst = idx === 0;
        const isLast = idx === trail.length - 1;
        return (
          <li class="inline-flex min-w-0 items-center gap-2">
            {idx > 0 && (
              <span
                aria-hidden="true"
                class="font-mono text-[11px] text-slate-300 dark:text-slate-700 select-none"
              >
                /
              </span>
            )}
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 font-medium text-slate-500 hover:text-cyan-700 hover:underline underline-offset-4 dark:text-slate-400 dark:hover:text-cyan-300 transition-colors whitespace-nowrap"
              >
                {isFirst && (
                  <svg
                    class="h-3.5 w-3.5 shrink-0 opacity-85"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M2.25 7.25 8 2.5l5.75 4.75" />
                    <path d="M4 6.25v6.5a.75.75 0 0 0 .75.75h6.5a.75.75 0 0 0 .75-.75v-6.5" />
                  </svg>
                )}
                <span>{item.label}</span>
              </a>
            ) : (
              <span
                aria-current="page"
                class="max-w-[220px] sm:max-w-[420px] truncate font-medium text-slate-900 dark:text-slate-100"
              >
                {item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
