---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_META, withBase } from '../site/url';
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy (Datenschutzerklärung) for the SimplexViz documentation and project website by Dr. Georg Hackenberg pursuant to GDPR and TKG 2021."
>
  <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
    <header>
      <Breadcrumbs items={[{ label: 'Privacy Policy' }]} />
      <h1 class="text-2xl sm:text-3xl leading-[1.18] font-bold tracking-tight text-slate-950 dark:text-white">
        Privacy Policy
      </h1>
      <p class="mt-3.5 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
        Data protection information pursuant to the EU General Data Protection Regulation (GDPR / <em>DSGVO</em>) and the Austrian Telecommunications Act (TKG 2021).
      </p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="sv-prose lg:col-span-8">
        <h2>1. Controller (<em>Verantwortlicher</em>)</h2>
        <p>
          The controller responsible for data processing on this website within the meaning of Art. 4(7) of the EU General Data Protection Regulation (GDPR / <em>DSGVO</em>) is:
        </p>
        <p>
          <strong>Dr. Georg Hackenberg</strong><br />
          Edthof 13a, 4645 Grünau im Almtal, Austria<br />
          Email: <a href="mailto:georg.hackenberg@fh-wels.at">georg.hackenberg@fh-wels.at</a><br />
          Phone: <a href="tel:+436648048444066">+43 664 80484 44066</a><br />
          Website:{' '}
          <a href="https://hackenberg.tech" target="_blank" rel="noreferrer">
            https://hackenberg.tech
          </a>
        </p>

        <h2>2. Privacy by Design: Zero Cookies &amp; Self-Hosted Assets</h2>
        <p>
          This project website and documentation portal is pre-rendered as static HTML and operates without HTTP cookies or third-party CDN dependencies:
        </p>
        <ul>
          <li>
            <strong>No Tracking Cookies:</strong> This website sets zero HTTP cookies.
          </li>
          <li>
            <strong>Self-Hosted Web Fonts &amp; Media Thumbnails:</strong> All typography (<em>Plus Jakarta Sans</em> and <em>IBM Plex Mono</em>) as well as all example dataset preview thumbnails (including Wikimedia Commons film posters and zoological photographs) are bundled locally and served from the same origin—your browser makes zero automatic external requests to Google Fonts, Wikimedia servers, or third-party CDNs when viewing pages.
          </li>
          <li>
            <strong>Client-Side Interactive Demos:</strong> All interactive SimplexViz examples (including Web Audio vowel synthesis) execute purely locally inside your browser memory; no user data is transmitted to external APIs.
          </li>
        </ul>

        <h2 id="analytics-opt-out">3. Cookieless Web Analytics (Plausible) &amp; Opt-Out</h2>
        <p>
          To understand how documentation guides, interactive examples, and engineering notes are used without profiling individual visitors, this website uses the open-source{' '}
          <a href="https://plausible.io" target="_blank" rel="noreferrer">Plausible Analytics</a>{' '}
          tracker (<code>@plausible-analytics/tracker</code>), configured for the site identifier{' '}
          <code>hackenberg.tech/simplex-viz</code> and sending events exclusively to our self-hosted Plausible instance at{' '}
          <code>https://analytics.mentawise.com</code> (operated by Dr. Georg Hackenberg / Mentawise).
        </p>
        <ul>
          <li>
            <strong>No Cookies &amp; No Personal Profiles:</strong> Plausible sets zero cookies, performs no cross-site tracking or browser fingerprinting, and stores no persistent user identifiers. Page views and aggregated outbound link clicks send only the visited URL path, HTTP referrer, browser/OS family, viewport class, and coarse country/region derived transiently from the IP address using a daily rotating cryptographic salt.
          </li>
          <li>
            <strong>Legal Basis:</strong> Processing is based on our legitimate interest in privacy-preserving statistical evaluation and improving technical documentation (Art. 6(1)(f) GDPR) and operates strictly without accessing non-essential terminal device storage unless you actively opt out (§ 165(3) TKG 2021).
          </li>
          <li>
            <strong>Right to Object (Art. 21 GDPR):</strong> You can exclude your browser from measurement at any time using the control below. Activating the opt-out writes <code>plausible_ignore=true</code> to your browser&rsquo;s <code>localStorage</code> for this origin, immediately preventing any pageview or event requests to <code>analytics.mentawise.com</code>.
          </li>
        </ul>

        <section
          aria-labelledby="sv-analytics-optout-heading"
          class="not-prose my-6 rounded-xl border border-slate-200/90 bg-white p-5 sm:p-6 dark:border-slate-800/90 dark:bg-[#0B0F17]"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <h3
                id="sv-analytics-optout-heading"
                class="text-sm font-semibold tracking-tight text-slate-950 dark:text-white"
              >
                Analytics Preference for This Browser
              </h3>
              <p
                id="sv-analytics-status"
                aria-live="polite"
                class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-300"
              >
                Status: Checking browser preference…
              </p>
            </div>

            <button
              id="sv-analytics-optout-btn"
              type="button"
              class="inline-flex min-h-[44px] shrink-0 items-center justify-center rounded-lg border border-slate-300 bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 disabled:opacity-50 dark:border-slate-700 dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-white whitespace-nowrap"
            >
              Opt out of analytics
            </button>
          </div>
          <p class="mt-3 border-t border-slate-200/80 pt-3 text-[11px] leading-relaxed text-slate-500 dark:border-slate-800/80 dark:text-slate-400">
            Opting out stores <code>plausible_ignore=true</code> locally in <code>window.localStorage</code> for this origin only. Clearing site data in your browser removes the opt-out flag.
          </p>
        </section>

        <h2>4. Local Browser Storage (<code>localStorage</code>)</h2>
        <p>
          Local browser storage (<code>window.localStorage</code>) is used strictly for explicit user-initiated preferences and never transmitted over the network (§ 165(3) TKG 2021 / Art. 6(1)(f) GDPR):
        </p>
        <ul>
          <li>
            <code>simplex-theme</code>: Written only when you actively switch the color theme (<em>Light</em>, <em>Dark</em>, or <em>System</em>) in the site header.
          </li>
          <li>
            <code>plausible_ignore</code>: Written only when you click <em>Opt out of analytics</em> above so that future visits suppress all Plausible Analytics tracking requests.
          </li>
        </ul>

        <h2>5. Server Log Files &amp; Static Hosting</h2>
        <p>
          When accessing pages of this static website (hosted via <code>hackenberg.tech</code> / GitHub Pages infrastructure), the delivering web server automatically processes technical HTTP request metadata required to establish a secure TLS connection and transmit static assets:
        </p>
        <ul>
          <li>IP address of the requesting device</li>
          <li>Date, timestamp, and requested URL path</li>
          <li>HTTP status code and transferred byte volume</li>
          <li>Browser user-agent string and referrer URL (if sent by your browser)</li>
        </ul>
        <p>
          Processing is carried out on the legal basis of Art. 6(1)(f) GDPR (legitimate interest in secure, reliable, and abuse-resistant technical provision of the online documentation). Log data is not merged with other data sources and is automatically rotated and deleted in accordance with hosting retention schedules.
        </p>

        <h2>6. Direct Contact via Email or Phone</h2>
        <p>
          If you contact us by email or telephone, the contact details and message content you provide are processed exclusively for handling your inquiry and any follow-up questions (Art. 6(1)(b) GDPR for pre-contractual/contractual communication or Art. 6(1)(f) GDPR for general technical/open-source inquiries). We do not share this information with third parties without your consent.
        </p>

        <h2>7. External Links</h2>
        <p>
          This website contains outgoing reference and attribution links to external third-party platforms—including the{' '}
          <a href={SITE_META.repoUrl} target="_blank" rel="noreferrer">GitHub repository</a>,{' '}
          <a href={SITE_META.npmUrl} target="_blank" rel="noreferrer">npmjs package registry</a>,{' '}
          <code>arxiv.org</code>, <code>wikipedia.org</code>, <code>commons.wikimedia.org</code>, and <code>creativecommons.org</code>. No personal data or IP address is transferred to those providers until you actively click an external link, after which the privacy policies of the respective platform operator apply.
        </p>

        <h2>8. Your Rights under GDPR &amp; Supervisory Authority</h2>
        <p>
          Under Art. 15–21 GDPR, you have the right at any time to request access to your personal data, rectification, erasure, restriction of processing, data portability, and to object to processing based on Art. 6(1)(f) GDPR.
        </p>
        <p>
          If you believe that the processing of your personal data infringes data protection law, you also have the right to lodge a complaint with a supervisory authority—in Austria:
        </p>
        <p>
          <strong>Austrian Data Protection Authority (<em>Österreichische Datenschutzbehörde</em>)</strong><br />
          Barichgasse 40–42, 1030 Vienna, Austria<br />
          Website:{' '}
          <a href="https://www.dsb.gv.at" target="_blank" rel="noreferrer">
            https://www.dsb.gv.at
          </a>
        </p>
      </div>

      <!-- Side Summary Card -->
      <aside class="space-y-6 lg:col-span-4">
        <section class="rounded-xl border border-slate-200/90 bg-white p-5 text-xs dark:border-slate-800/90 dark:bg-[#0B0F17]">
          <p class="font-semibold text-slate-900 dark:text-slate-100">
            Technical Privacy Summary
          </p>
          <ul class="mt-3 space-y-2 border-t border-slate-200/80 pt-3 text-slate-600 dark:border-slate-800/80 dark:text-slate-400">
            <li>Cookies set: <strong class="font-mono text-slate-900 dark:text-slate-100">0</strong></li>
            <li>Analytics: <strong class="font-mono text-slate-900 dark:text-slate-100">Plausible (cookieless)</strong></li>
            <li>Analytics host: <code class="font-mono">analytics.mentawise.com</code></li>
            <li>External font / media CDNs: <strong class="font-mono text-slate-900 dark:text-slate-100">None (self-hosted)</strong></li>
            <li>Local storage: <code class="font-mono">simplex-theme</code>, <code class="font-mono">plausible_ignore</code> (opt-out)</li>
          </ul>
          <div class="mt-4 flex flex-col gap-2 border-t border-slate-200/80 pt-3 dark:border-slate-800/80">
            <a
              href="#analytics-opt-out"
              class="font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
            >
              Manage analytics opt-out ↓
            </a>
            <a
              href={withBase('/imprint')}
              class="font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
            >
              Imprint &amp; Legal Disclosure →
            </a>
            <a
              href={SITE_META.authorUrl}
              target="_blank"
              rel="noreferrer"
              class="text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors"
            >
              Visit hackenberg.tech ↗
            </a>
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { isPlausibleOptedOut, setPlausibleOptOut } from '../site/analytics';

  function bindAnalyticsOptOutUi() {
    const statusEl = document.getElementById('sv-analytics-status');
    const buttonEl = document.getElementById('sv-analytics-optout-btn');
    if (!statusEl || !(buttonEl instanceof HTMLButtonElement)) return;

    const renderState = (optedOut: boolean) => {
      if (optedOut) {
        statusEl.textContent =
          'Status: Opted out — Plausible Analytics is disabled in this browser (plausible_ignore=true).';
        buttonEl.textContent = 'Re-enable analytics';
        buttonEl.setAttribute('aria-pressed', 'true');
      } else {
        statusEl.textContent =
          'Status: Active — Cookieless pageview measurement is enabled for hackenberg.tech/simplex-viz.';
        buttonEl.textContent = 'Opt out of analytics';
        buttonEl.setAttribute('aria-pressed', 'false');
      }
    };

    renderState(isPlausibleOptedOut());

    buttonEl.addEventListener('click', () => {
      const nextOptOut = !isPlausibleOptedOut();
      const updated = setPlausibleOptOut(nextOptOut);
      renderState(updated);
    });

    window.addEventListener('simplex-analytics-change', () => {
      renderState(isPlausibleOptedOut());
    });
  }

  bindAnalyticsOptOutUi();
</script>
