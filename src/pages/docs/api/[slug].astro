---
import { getCollection, render } from 'astro:content';
import DocsShellLayout from '../../../layouts/DocsShellLayout.astro';
import { SITE_META } from '../../../site/url';

export async function getStaticPaths() {
  const entries = await getCollection('api');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: entry.data.packageName,
  version: entry.data.version,
  codeRepository: SITE_META.repoUrl,
  programmingLanguage: 'TypeScript',
  description: entry.data.description,
};
---

<DocsShellLayout
  title={entry.data.title}
  description={entry.data.description}
  kicker="API Reference"
  metaItems={[
    {
      icon: 'package',
      label: `${entry.data.packageName} v${entry.data.version}`,
      mono: true,
    },
    { icon: 'layers', label: entry.data.layerLabel },
  ]}
  showCopyLink
  breadcrumbs={[
    { label: 'Docs', href: '/docs' },
    { label: 'API Reference', href: '/docs/api' },
    { label: entry.data.packageName },
  ]}
  headings={[
    { depth: 2, slug: 'primary-exports', text: 'Primary Exports' },
    ...headings,
  ]}
  activeSlug={entry.id}
  activeGroup="api"
  jsonLd={jsonLd}
>
  <div class="not-prose mb-8 flex items-center justify-between gap-3 rounded-xl border border-slate-200/90 bg-white px-4 py-3 font-mono text-xs text-slate-800 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:text-slate-200">
    <span class="truncate">{entry.data.installCommand}</span>
    <button
      type="button"
      data-copy-api-cmd={entry.data.installCommand}
      class="cursor-pointer rounded px-2 py-0.5 font-sans text-xs font-semibold text-cyan-700 hover:bg-slate-100 dark:text-cyan-300 dark:hover:bg-slate-800 transition-colors whitespace-nowrap shrink-0"
    >
      Copy
    </button>
  </div>

  <h2 id="primary-exports">Primary Exports</h2>
  <div class="not-prose my-5 divide-y divide-slate-200/80 rounded-xl border border-slate-200/90 bg-white dark:divide-slate-800/80 dark:border-slate-800/90 dark:bg-[#0B0F17]">
    {
      entry.data.exportsTable.map((row) => (
        <div class="p-4 sm:p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <span class="font-mono text-sm font-semibold text-cyan-700 dark:text-cyan-300 break-all sm:break-normal">
              {row.symbol}
            </span>
            <span class="font-mono text-[11px] font-medium uppercase tracking-wider text-slate-400 dark:text-slate-500 whitespace-nowrap">
              {row.kind}
            </span>
          </div>

          <pre class="mt-2.5 whitespace-pre-wrap break-words rounded-lg border border-slate-200/80 bg-slate-50 px-3.5 py-2.5 font-mono text-[11.5px] leading-relaxed text-slate-800 dark:border-slate-800/90 dark:bg-[#07090E] dark:text-slate-200"><code>{row.signature}</code></pre>

          <p class="mt-2.5 text-xs sm:text-[13px] leading-relaxed text-slate-600 dark:text-slate-300">
            {row.summary}
          </p>
        </div>
      ))
    }
  </div>

  <Content />
</DocsShellLayout>

<script is:inline>
  (function () {
    document.addEventListener('click', function (ev) {
      var btn =
        ev.target && ev.target.closest ? ev.target.closest('[data-copy-api-cmd]') : null;
      if (!btn) return;
      var cmd = btn.getAttribute('data-copy-api-cmd');
      if (!cmd || !navigator.clipboard) return;
      navigator.clipboard.writeText(cmd).then(function () {
        var orig = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () {
          btn.textContent = orig;
        }, 1400);
      });
    });
  })();
</script>
