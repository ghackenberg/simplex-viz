---
import { getCollection } from 'astro:content';
import DocsShellLayout from '../../../layouts/DocsShellLayout.astro';
import { SITE_META, withBase } from '../../../site/url';

const apiPackages = (await getCollection('api')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<DocsShellLayout
  title="TypeScript API Reference"
  description="Package-by-package API documentation for @simplex-viz/core, @simplex-viz/svg, and @simplex-viz/react."
  kicker="API Reference"
  metaLine={`v${SITE_META.version} · 3 Monorepo Packages`}
  activeSlug="index"
  activeGroup="api"
>
  <div class="not-prose space-y-5">
    {
      apiPackages.map((pkg) => (
        <a
          href={withBase(`/docs/api/${pkg.id}`)}
          class="group block rounded-xl border border-slate-200/90 bg-white p-6 hover:border-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60 transition-colors"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-mono text-lg font-bold text-slate-950 group-hover:text-cyan-700 dark:text-cyan-300">
              {pkg.data.packageName}
            </h2>
            <p class="font-mono text-xs text-slate-500 dark:text-slate-400 tabular-nums">
              v{pkg.data.version} · {pkg.data.layerLabel}
            </p>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            {pkg.data.description}
          </p>
          <p class="mt-4 font-mono text-xs text-slate-500 dark:text-slate-400">
            {pkg.data.installCommand}
          </p>
        </a>
      ))
    }
  </div>
</DocsShellLayout>
