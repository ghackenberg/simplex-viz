---
import { getCollection, render } from 'astro:content';
import DocsShellLayout from '../../layouts/DocsShellLayout.astro';
import { ALL_STRATEGY_IDS, getStrategiesByStage } from '../../site/strategies';
import { SITE_META, withBase } from '../../site/url';

export async function getStaticPaths() {
  const allDocs = (await getCollection('docs')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return allDocs.map((entry, idx) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevEntry: idx > 0 ? allDocs[idx - 1] : null,
      nextEntry: idx < allDocs.length - 1 ? allDocs[idx + 1] : null,
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
const stageStrategies = entry.data.stageNumber
  ? getStrategiesByStage(entry.data.stageNumber)
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updatedDate,
  author: {
    '@type': 'Person',
    name: SITE_META.authorName,
    url: SITE_META.authorUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_META.name,
  },
};
---

<DocsShellLayout
  title={entry.data.title}
  description={entry.data.description}
  kicker={entry.data.section}
  metaItems={[
    { icon: 'layers', label: entry.data.section },
    { icon: 'clock', label: `${entry.data.readingMinutes} min read`, mono: true },
    { icon: 'calendar', label: `Updated ${entry.data.updatedDate}`, mono: true },
  ]}
  showCopyLink
  breadcrumbs={[
    { label: 'Docs', href: '/docs' },
    { label: entry.data.shortTitle },
  ]}
  headings={headings}
  activeSlug={entry.id}
  activeGroup="docs"
  summaryPoints={entry.data.summaryPoints}
  jsonLd={jsonLd}
>
  {
    stageStrategies.length > 0 && (
      <section class="not-prose mb-10 rounded-xl border border-slate-200/90 bg-slate-50/70 p-5 dark:border-slate-800/90 dark:bg-[#0B0F17]">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
          <div>
            <p class="font-mono text-[11px] font-medium uppercase tracking-wider text-cyan-700 dark:text-cyan-400">
              Stage 0{entry.data.stageNumber} Strategy Sub-Pages
            </p>
            <h2 class="mt-1 text-base font-semibold tracking-tight text-slate-950 dark:text-white">
              Built-in strategies in this pipeline stage
            </h2>
          </div>
          <a
            href={withBase('/docs/strategies')}
            class="text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-400"
          >
            All {ALL_STRATEGY_IDS.length} strategies →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {stageStrategies.map((spec) => (
            <a
              href={withBase(spec.strategyDocPath)}
              class="group flex flex-col justify-between rounded-lg border border-slate-200/90 bg-white p-4 transition-colors hover:border-cyan-500/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0F1522] dark:hover:border-cyan-400/60"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-semibold text-slate-950 group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-300 transition-colors">
                    {spec.name}
                  </span>
                  {spec.isDefault && (
                    <span class="font-mono text-[10px] font-medium uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
                      Default
                    </span>
                  )}
                </div>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                  {spec.summary}
                </p>
              </div>
              <p class="mt-3 border-t border-slate-100 pt-2 font-mono text-[11px] text-slate-500 dark:border-slate-800/80 dark:text-slate-400 break-words">
                {spec.factoryName}()
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <Content />

  <nav
    aria-label="Chapter pagination"
    class="not-prose mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2"
  >
    {
      prevEntry ? (
        <a
          href={withBase(`/docs/${prevEntry.id}`)}
          class="group rounded-lg border border-slate-200/90 bg-white p-4 transition-colors hover:border-cyan-500/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60"
        >
          <span class="block text-xs text-slate-500 dark:text-slate-400">Previous</span>
          <span class="mt-1 block text-sm font-semibold text-slate-950 group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-300 transition-colors">
            ← {prevEntry.data.shortTitle}
          </span>
        </a>
      ) : (
        <div />
      )
    }

    {
      nextEntry && (
        <a
          href={withBase(`/docs/${nextEntry.id}`)}
          class="group rounded-lg border border-slate-200/90 bg-white p-4 text-right transition-colors hover:border-cyan-500/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60"
        >
          <span class="block text-xs text-slate-500 dark:text-slate-400">Next</span>
          <span class="mt-1 block text-sm font-semibold text-slate-950 group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-300 transition-colors">
            {nextEntry.data.shortTitle} →
          </span>
        </a>
      )
    }
  </nav>
</DocsShellLayout>
