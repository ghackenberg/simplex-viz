---
import { getCollection, render } from 'astro:content';
import DocsShellLayout from '../../layouts/DocsShellLayout.astro';
import { getDocReadingMinutes } from '../../site/readingTime';
import { SITE_META } from '../../site/url';

export async function getStaticPaths() {
  const allDocs = (await getCollection('docs')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return allDocs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updatedDate,
  author: {
    '@type': 'Person',
    name: SITE_META.authorName,
    url: SITE_META.authorUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_META.name,
  },
};
---

<DocsShellLayout
  title={entry.data.title}
  description={entry.data.description}
  kicker={entry.data.section}
  metaItems={[
    { icon: 'layers', label: entry.data.section },
    { icon: 'clock', label: `${getDocReadingMinutes(entry)} min read`, mono: true },
    { icon: 'calendar', label: `Updated ${entry.data.updatedDate}`, mono: true },
  ]}
  showCopyLink
  breadcrumbs={[
    { label: 'Docs', href: '/docs' },
    { label: entry.data.shortTitle },
  ]}
  headings={headings}
  activeSlug={entry.id}
  activeGroup="docs"
  summaryPoints={entry.data.summaryPoints}
  jsonLd={jsonLd}
>
  <Content />
</DocsShellLayout>
