---
import DocsShellLayout from '../../../layouts/DocsShellLayout.astro';
import { ALL_STRATEGY_IDS, getStrategiesByStage } from '../../../site/strategies';
import { withBase } from '../../../site/url';

const stageGroups = [
  { stage: 1 as const, title: '01. Mesh Triangulation', stageHref: '/docs/stage-1-mesh' },
  { stage: 2 as const, title: '02. Clustering & Projection', stageHref: '/docs/stage-2-clustering' },
  { stage: 3 as const, title: '03. OKLab Color Science', stageHref: '/docs/stage-3-color' },
  { stage: 4 as const, title: '04. Composable Convex Layout', stageHref: '/docs/stage-4-layout' },
  { stage: 5 as const, title: '05. Conformal 1:4 Zoom', stageHref: '/docs/stage-5-zoom' },
];
---

<DocsShellLayout
  title="Built-In Strategy Catalog"
  description={`Complete reference index of all ${ALL_STRATEGY_IDS.length} canonical SimplexViz strategies across the 5 pluggable pipeline stages—each with its own dedicated configuration and algorithm page.`}
  kicker="Strategies"
  metaLine={`5 Pipeline Stages · ${ALL_STRATEGY_IDS.length} Named Strategies`}
  breadcrumbs={[
    { label: 'Docs', href: '/docs' },
    { label: 'Strategies' },
  ]}
  activeSlug="index"
  activeGroup="strategies"
>
  <div class="not-prose space-y-10">
    {
      stageGroups.map((group) => {
        const specs = getStrategiesByStage(group.stage);
        return (
          <section>
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="text-lg font-semibold text-slate-950 dark:text-white">
                {group.title}
              </h2>
              <a
                href={withBase(group.stageHref)}
                class="text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap"
              >
                Stage overview &amp; diagram →
              </a>
            </div>

            <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
              {specs.map((spec) => (
                <a
                  href={withBase(spec.strategyDocPath)}
                  class="group flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-5 transition-colors hover:border-cyan-500/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60"
                >
                  <div>
                    <p class="font-mono text-xs text-slate-500 dark:text-slate-400 tabular-nums">
                      {spec.factoryName}()
                      {spec.isDefault ? ' · Default' : ''}
                      {spec.requiresTags === true
                        ? ' · Tagged'
                        : spec.requiresTags === false
                          ? ' · Tag-Free'
                          : ''}
                    </p>
                    <h3 class="mt-1.5 text-base font-semibold text-slate-950 group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-300 transition-colors">
                      {spec.name}
                    </h3>
                    <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                      {spec.summary}
                    </p>
                  </div>

                  <p class="mt-4 text-xs font-semibold text-cyan-700 group-hover:underline dark:text-cyan-300">
                    Open strategy reference →
                  </p>
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</DocsShellLayout>
