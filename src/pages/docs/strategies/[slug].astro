---
import { getCollection, render } from 'astro:content';
import StrategyMechanismFigure from '../../../components/diagrams/StrategyMechanismFigure.astro';
import DocsShellLayout from '../../../layouts/DocsShellLayout.astro';
import { getStrategiesByStage, getStrategySpec } from '../../../site/strategies';
import { SITE_META, withBase } from '../../../site/url';

export async function getStaticPaths() {
  const allEntries = (await getCollection('strategies')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return allEntries.map((entry, idx) => ({
    params: { slug: entry.data.strategyId },
    props: {
      entry,
      prevEntry: idx > 0 ? allEntries[idx - 1] : null,
      nextEntry: idx < allEntries.length - 1 ? allEntries[idx + 1] : null,
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
const spec = getStrategySpec(entry.data.strategyId);
const siblings = getStrategiesByStage(spec.stage).filter((s) => s.id !== spec.id);

const prevSpec = prevEntry ? getStrategySpec(prevEntry.data.strategyId) : null;
const nextSpec = nextEntry ? getStrategySpec(nextEntry.data.strategyId) : null;

const metaParts = [
  `Stage 0${spec.stage}: ${spec.stageLabel}`,
  spec.isDefault ? 'Stage Default' : 'Built-In Preset',
  `${entry.data.readingMinutes} min read`,
];
if (spec.requiresTags === true) metaParts.push('requiresTags: true');
if (spec.requiresTags === false) metaParts.push('requiresTags: false');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${spec.name} (${spec.factoryName})`,
  description: spec.summary,
  dateModified: entry.data.updatedDate,
  publisher: {
    '@type': 'Organization',
    name: SITE_META.name,
  },
};
---

<DocsShellLayout
  title={spec.name}
  description={spec.summary}
  kicker={`Stage 0${spec.stage} Strategy`}
  metaLine={metaParts.join(' · ')}
  headings={[
    { depth: 2, slug: 'visual-mechanism', text: 'Visual Mechanism' },
    { depth: 2, slug: 'factory-signature', text: 'Factory Signature' },
    { depth: 2, slug: 'options-reference', text: 'Options & Defaults' },
    ...headings,
  ]}
  activeSlug={spec.id}
  activeGroup="strategies"
  activeStage={spec.stage}
  summaryPoints={entry.data.whenToUse}
  jsonLd={jsonLd}
>
  <h2 id="visual-mechanism">Visual Mechanism</h2>
  <StrategyMechanismFigure strategyId={spec.id} />

  <h2 id="factory-signature">Factory Signature</h2>
  <div class="not-prose my-4 rounded-xl border border-slate-200/90 bg-slate-50 p-4 dark:border-slate-800/90 dark:bg-[#0B0F17]">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span>
        Re-exported from <code class="font-mono text-slate-800 dark:text-slate-200">@simplex-viz/core</code>,{' '}
        <code class="font-mono text-slate-800 dark:text-slate-200">@simplex-viz/svg</code>, and{' '}
        <code class="font-mono text-slate-800 dark:text-slate-200">@simplex-viz/react</code>
      </span>
      <a
        href={withBase(`/docs/${spec.docSlug}`)}
        class="font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap"
      >
        Stage 0{spec.stage} Overview →
      </a>
    </div>
    <pre class="mt-3 whitespace-pre-wrap break-words rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 font-mono text-xs leading-relaxed text-slate-900 dark:border-slate-800 dark:bg-[#07090E] dark:text-cyan-300"><code>{entry.data.signature}</code></pre>
  </div>

  <h2 id="options-reference">Options &amp; Defaults</h2>
  {
    entry.data.optionsTable.length > 0 ? (
      <div class="not-prose my-5 divide-y divide-slate-200/80 rounded-xl border border-slate-200/90 bg-white dark:divide-slate-800/80 dark:border-slate-800/90 dark:bg-[#0B0F17]">
        {entry.data.optionsTable.map((opt) => (
          <div class="p-4 sm:px-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <span class="font-mono text-sm font-semibold text-cyan-700 dark:text-cyan-300">
                {opt.name}
              </span>
              <span class="font-mono text-[11px] text-slate-500 dark:text-slate-400">
                Default: <span class="text-slate-800 dark:text-slate-200">{opt.defaultValue}</span>
              </span>
            </div>
            <p class="mt-1.5 font-mono text-[11.5px] text-slate-700 dark:text-slate-300 break-words">
              {opt.type}
            </p>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
              {opt.description}
            </p>
          </div>
        ))}
      </div>
    ) : (
      <p>
        This preset strategy requires zero configuration parameters—invoke{' '}
        <code>{spec.factoryName}()</code> directly, or compose custom building blocks via{' '}
        <code>createComposedLayoutStrategy(...)</code>.
      </p>
    )
  }

  <Content />

  {
    siblings.length > 0 && (
      <section class="not-prose mt-10 rounded-xl border border-slate-200/90 bg-white p-5 dark:border-slate-800/90 dark:bg-[#0B0F17]">
        <p class="text-xs font-semibold text-slate-900 dark:text-slate-100">
          Other Strategies in Stage 0{spec.stage} ({spec.stageLabel})
        </p>
        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {siblings.map((sib) => (
            <a
              href={withBase(sib.strategyDocPath)}
              class="rounded-lg border border-slate-200/80 bg-slate-50/70 p-3.5 hover:border-cyan-500/70 dark:border-slate-800 dark:bg-[#07090E] dark:hover:border-cyan-400/60 transition-colors"
            >
              <span class="block text-xs font-semibold text-slate-900 dark:text-white">
                {sib.name}
              </span>
              <span class="mt-0.5 block font-mono text-[11px] text-slate-500 dark:text-slate-400">
                {sib.factoryName}()
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <nav
    aria-label="Strategy pagination"
    class="not-prose mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2"
  >
    {
      prevSpec ? (
        <a
          href={withBase(prevSpec.strategyDocPath)}
          class="rounded-lg border border-slate-200/90 bg-white p-4 hover:border-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60 transition-colors"
        >
          <span class="block text-xs text-slate-500 dark:text-slate-400">
            Previous Strategy (Stage 0{prevSpec.stage})
          </span>
          <span class="mt-1 block text-sm font-semibold text-slate-950 dark:text-white">
            ← {prevSpec.name}
          </span>
        </a>
      ) : (
        <div />
      )
    }

    {
      nextSpec && (
        <a
          href={withBase(nextSpec.strategyDocPath)}
          class="rounded-lg border border-slate-200/90 bg-white p-4 text-right hover:border-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60 transition-colors"
        >
          <span class="block text-xs text-slate-500 dark:text-slate-400">
            Next Strategy (Stage 0{nextSpec.stage})
          </span>
          <span class="mt-1 block text-sm font-semibold text-slate-950 dark:text-white">
            {nextSpec.name} →
          </span>
        </a>
      )
    }
  </nav>
</DocsShellLayout>
