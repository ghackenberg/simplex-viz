---
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import { UseCaseMiniAtlas } from '../../components/islands/UseCaseMiniAtlas';
import { buildCommonsThumbManifest } from '../../demo/commonsThumbs.server';
import {
  getDatasetItemCount,
  getDatasetSourceInfo,
} from '../../demo/data/multimodalCatalog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStrategySpec } from '../../site/strategies';
import { SITE_META, withBase } from '../../site/url';

export async function getStaticPaths() {
  const entries = (await getCollection('datasets')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const itemCount = getDatasetItemCount(entry.data.datasetId);
const sourceInfo = getDatasetSourceInfo(entry.data.datasetId);
const thumbManifest = await buildCommonsThumbManifest([entry.data.datasetId]);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const activePipeline = [
  { role: 'Mesh', spec: getStrategySpec(entry.data.meshStrategy) },
  { role: 'Clustering', spec: getStrategySpec(entry.data.clusteringStrategy) },
  { role: 'Color', spec: getStrategySpec(entry.data.colorStrategy) },
  { role: 'Layout', spec: getStrategySpec(entry.data.layoutStrategy) },
  { role: 'Zoom', spec: getStrategySpec(entry.data.zoomStrategy) },
];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs
      items={[
        { label: 'Examples', href: '/examples' },
        { label: entry.data.title },
      ]}
    />

    <header>
      <p class="text-xs text-slate-500 dark:text-slate-400 tabular-nums">
        {entry.data.domainLabel} · {entry.data.representationLabel} · {itemCount} items ·{' '}
        {sourceInfo.sourceShort} ({sourceInfo.license})
      </p>
      <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
        {entry.data.title}
      </h1>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
        {entry.data.description}
      </p>
    </header>

    <!-- Optimal Hardcoded 5-Stage Strategy Pipeline -->
    <dl class="mt-6 grid grid-cols-1 gap-3 rounded-xl border border-slate-200/90 bg-white p-4 sm:grid-cols-2 lg:grid-cols-5 text-xs dark:border-slate-800/90 dark:bg-[#0B0F17]">
      {
        activePipeline.map(({ role, spec }) => (
          <div class="flex flex-col justify-between gap-1 border-b border-slate-100 pb-2.5 last:border-b-0 last:pb-0 sm:border-b-0 sm:pb-0 dark:border-slate-800/70">
            <dt class="font-mono text-[11px] text-slate-500 dark:text-slate-400">
              0{spec.stage} · {role}
            </dt>
            <dd class="font-semibold text-slate-900 dark:text-slate-100">
              <a
                href={withBase(spec.strategyDocPath)}
                class="hover:text-cyan-700 hover:underline dark:hover:text-cyan-300 transition-colors"
              >
                {spec.name}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>

    <!-- Full-Width Interactive Atlas with Curated Pipeline -->
    <UseCaseMiniAtlas
      datasetId={entry.data.datasetId}
      meshStrategy={entry.data.meshStrategy}
      clusteringStrategy={entry.data.clusteringStrategy}
      colorStrategy={entry.data.colorStrategy}
      layoutStrategy={entry.data.layoutStrategy}
      zoomStrategy={entry.data.zoomStrategy}
      nodeView={entry.data.nodeView}
      thumbManifest={thumbManifest}
      client:load
    />

    <!-- Constrained Editorial Prose Grid Below Canvas (Author/Source Left · Prose Center · ToC Right) -->
    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Left Metadata Sidebar -->
      <aside class="space-y-5 lg:col-span-3">
        <div class="lg:sticky lg:top-24 space-y-5">
          <div class="rounded-xl border border-slate-200/90 bg-white p-5 dark:border-slate-800/90 dark:bg-[#0B0F17]">
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Author</p>
            <p class="mt-1.5 text-sm font-semibold text-slate-950 dark:text-white">
              <a
                href={SITE_META.authorUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-cyan-700 hover:underline dark:hover:text-cyan-300 transition-colors"
              >
                {SITE_META.authorName}
              </a>
            </p>
            <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              Professor of Industrial Informatics, FH OÖ Campus Wels
            </p>

            <dl class="mt-4 space-y-2 border-t border-slate-200/70 pt-3.5 text-xs dark:border-slate-800/80 tabular-nums">
              <div class="flex items-baseline justify-between gap-2">
                <dt class="text-slate-500 dark:text-slate-400">Published</dt>
                <dd class="font-mono text-slate-900 dark:text-slate-200">
                  {entry.data.publishedDate}
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <dt class="text-slate-500 dark:text-slate-400">Reading Time</dt>
                <dd class="font-mono text-slate-900 dark:text-slate-200">
                  {entry.data.readingMinutes} min
                </dd>
              </div>
            </dl>
          </div>

          <div class="rounded-xl border border-slate-200/90 bg-slate-50/70 p-5 dark:border-slate-800/90 dark:bg-[#0B0F17]">
            <p class="text-xs font-semibold text-slate-900 dark:text-slate-100">
              Open Dataset Provenance
            </p>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              {sourceInfo.attribution}
            </p>
            <dl class="mt-3.5 space-y-2 border-t border-slate-200/70 pt-3 text-xs dark:border-slate-800/80 tabular-nums">
              <div class="flex items-baseline justify-between gap-2">
                <dt class="text-slate-500 dark:text-slate-400">Records</dt>
                <dd class="font-mono font-semibold text-slate-900 dark:text-slate-100">
                  {itemCount} items
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <dt class="text-slate-500 dark:text-slate-400">License</dt>
                <dd class="font-mono text-slate-800 dark:text-slate-200">
                  {sourceInfo.license}
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-2">
                <dt class="text-slate-500 dark:text-slate-400">Tags Required</dt>
                <dd class="font-mono text-slate-800 dark:text-slate-200">
                  {entry.data.requiresTags ? 'true' : 'false'}
                </dd>
              </div>
            </dl>
            <a
              href={sourceInfo.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-block text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
            >
              Dataset Source ({sourceInfo.sourceShort}) ↗
            </a>
          </div>
        </div>
      </aside>

      <!-- Center Constrained Prose -->
      <article class="min-w-0 lg:col-span-6">
        <div class="sv-prose">
          <Content />
        </div>

        <div class="mt-10 border-t border-slate-200/80 pt-6 flex flex-wrap items-center justify-between gap-4 text-xs dark:border-slate-800/80">
          <a
            href={withBase('/examples')}
            class="font-semibold text-slate-700 hover:text-cyan-700 hover:underline dark:text-slate-300 dark:hover:text-cyan-300 transition-colors"
          >
            ← Back to All Examples
          </a>
          <a
            href={withBase('/playground')}
            class="font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
          >
            Build or Import Your Own Dataset in Playground →
          </a>
        </div>
      </article>

      <!-- Right Sticky Table of Contents -->
      <aside class="lg:col-span-3">
        {
          tocHeadings.length > 0 && (
            <div class="lg:sticky lg:top-24">
              <OnThisPage headings={tocHeadings} framed />
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
