---
import { Code } from 'astro:components';
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageMeta from '../../components/PageMeta.astro';
import { LargeScaleCanvasWorkerAtlas } from '../../components/islands/LargeScaleCanvasWorkerAtlas';
import { UseCaseMiniAtlas } from '../../components/islands/UseCaseMiniAtlas';
import { buildCommonsThumbManifest } from '../../demo/commonsThumbs.server';
import {
  buildDemoCatalog,
  getDatasetItemCount,
  getDatasetSourceInfo,
  type DemoEntity,
} from '../../demo/data/multimodalCatalog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDatasetPreviewSvg } from '../../site/datasetPreviews';
import { EXAMPLE_CODE_SNIPPETS } from '../../site/exampleSnippets';
import { SITE_META, withBase } from '../../site/url';

export async function getStaticPaths() {
  const entries = (await getCollection('datasets')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return entries.map((entry) => {
    getDatasetPreviewSvg(entry.id);
    return {
      params: { slug: entry.id },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const datasetId = entry.data.datasetId;
const itemCount = getDatasetItemCount(datasetId);
const sourceInfo = getDatasetSourceInfo(datasetId);
const catalogItems = buildDemoCatalog(datasetId);
const thumbManifest = await buildCommonsThumbManifest([datasetId]);
const codeSnippet = EXAMPLE_CODE_SNIPPETS[datasetId];

function formatDatasetRecord(entity: DemoEntity): Record<string, unknown> {
  if (entity.kind === 'knowledge') {
    if (entity.entry.repoName) {
      return {
        id: entity.id,
        repository: entity.entry.headline,
        language: entity.entry.repoLanguage,
        stars: entity.entry.repoStars,
        topics: entity.entry.hashtags,
      };
    }
    return {
      slug: entity.id,
      title: entity.entry.headline,
      primaryAuthor: entity.entry.primaryAuthor,
      publishedYear: entity.entry.publishedYear,
      arxivId: entity.entry.arxivId,
      hashtags: entity.entry.hashtags,
    };
  }
  if (entity.kind === 'media') {
    return {
      id: entity.media.id,
      title: entity.media.title,
      genre: entity.media.genre,
      releaseYear: entity.media.releaseYear,
      imdbRating: entity.media.imdbRating,
      rottenTomatoes: entity.media.rottenTomatoes,
      budgetMusd: entity.media.budgetMusd,
      worldwideGrossMusd: entity.media.worldwideGrossMusd,
      receptionVector: entity.media.semanticEmbedding.map((v) => Number(v.toFixed(3))),
      productionVector: entity.media.styleEmbedding.map((v) => Number(v.toFixed(3))),
    };
  }
  if (entity.kind === 'voice') {
    return {
      id: entity.voice.id,
      ipaSymbol: entity.voice.language,
      exampleWord: entity.voice.exampleWord,
      speakerName: entity.voice.speakerName,
      speakerSex: entity.voice.speakerSex,
      pitchHz: entity.voice.pitchHz,
      lpcVector: entity.voice.voiceEmbedding.map((v) => Number(v.toFixed(3))),
    };
  }
  if (entity.kind === 'zoo-species') {
    return {
      id: entity.zoo.id,
      species: entity.zoo.title,
      taxonomicGroup: entity.zoo.taxonomicGroup,
      legs: entity.zoo.legs,
      aquatic: entity.zoo.aquatic,
      predator: entity.zoo.predator,
      traits16D: entity.zoo.traits,
    };
  }
  if (entity.kind === 'stellar') {
    const s = entity.star;
    return {
      id: s.id,
      catalogId: s.catalogId,
      name: s.name,
      constellation: s.constellation,
      spectralType: s.spectralType,
      population: s.populationLabel,
      tempK: s.tempK,
      luminositySolar: s.luminositySolar,
      radiusSolar: s.radiusSolar,
      massSolar: s.massSolar,
      bvColor: s.bvColor,
      metallicityFeH: s.metallicityFeH,
      distancePc: s.distancePc,
      ageGyr: s.ageGyr,
      logG: s.logG,
      embedding8D: Array.from(s.embedding, (v) => Number(v.toFixed(3))),
    };
  }
  return {
    id: entity.body.id,
    specimen: entity.body.title,
    species: entity.body.species,
    island: entity.body.island,
    sex: entity.body.sex,
    billLengthMm: entity.body.billLengthMm,
    billDepthMm: entity.body.billDepthMm,
    flipperLengthMm: entity.body.flipperLengthMm,
    bodyMassG: entity.body.bodyMassG,
    morphVector: entity.body.shapeEmbedding.map((v) => Number(v.toFixed(3))),
  };
}

const isLargeCanvasWorkerExample = datasetId === 'stellar-atlas';
const jsonPreviewItems =
  catalogItems.length > 80 ? catalogItems.slice(0, 40) : catalogItems;
const rawDatasetPayload =
  catalogItems.length > 80
    ? {
        totalRecords: catalogItems.length,
        previewRecordsShown: jsonPreviewItems.length,
        note: 'First 40 deterministic records shown here; the live Preview tab solves 1,000, 2,000, or 3,500 stars off-thread in a Web Worker.',
        records: jsonPreviewItems.map(formatDatasetRecord),
      }
    : jsonPreviewItems.map(formatDatasetRecord);

const datasetJson = JSON.stringify(rawDatasetPayload, null, 2).replace(
  /\[\n\s+([-\d.,\s\n]+?)\n\s+\]/g,
  (_, inner: string) => {
    return `[${inner.replace(/\s+/g, ' ').trim()}]`;
  },
);

const examplePreviewPath = `/examples/${entry.id}.png`;
const examplePreviewUrl = new URL(
  withBase(examplePreviewPath),
  SITE_META.canonicalOrigin,
).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: entry.data.title,
  description: entry.data.description,
  image: examplePreviewUrl,
  license: sourceInfo.license,
  isBasedOn: sourceInfo.sourceUrl,
  creator: {
    '@type': 'Organization',
    name: sourceInfo.sourceName,
    url: sourceInfo.sourceUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_META.name,
  },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={examplePreviewPath}
  ogImageAlt={`${entry.data.title} — SimplexViz Interactive Example`}
  jsonLd={jsonLd}
>
  <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
    <!-- Centered Showcase Header -->
    <header class="mx-auto max-w-3xl text-center">
      <Breadcrumbs
        align="center"
        items={[
          { label: 'Examples', href: '/examples' },
          { label: entry.data.title },
        ]}
      />

      <h1 class="text-3xl sm:text-4xl leading-[1.15] font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
        {entry.data.title}
      </h1>
      <p class="mx-auto mt-3.5 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
        {entry.data.description}
      </p>

      <PageMeta
        align="center"
        items={[
          { icon: 'layers', label: entry.data.domainLabel },
          { icon: 'package', label: `${itemCount} records`, mono: true },
          {
            icon: 'tag',
            label: entry.data.requiresTags ? 'Tagged Dataset' : 'Tag-Free Vectors',
            mono: true,
          },
          ...(entry.data.timelineEnabled
            ? [{ icon: 'clock' as const, label: 'Timeline Playback', mono: true }]
            : []),
        ]}
        showCopyLink
      />
    </header>

    <!-- Synchronized 3-Tab Showcase Workbench: Preview · Code · Dataset -->
    <div class="relative mt-8">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -inset-x-6 -top-6 h-44 rounded-full bg-cyan-500/[0.05] blur-3xl dark:bg-cyan-400/[0.06]"
      />
      <section
        data-example-workbench
        aria-label="Interactive example workbench"
        class="relative overflow-hidden rounded-2xl border border-slate-300/80 bg-white shadow-lg shadow-slate-950/[0.04] dark:border-slate-700/80 dark:bg-[#0B0F17] dark:shadow-black/45"
      >
        <!-- Full-Width Segmented Tab Bar (Synchronized with Home Hero Atlas) -->
        <div class="border-b border-slate-200/80 bg-slate-100/85 p-1.5 dark:border-slate-800/80 dark:bg-[#0E131D]">
          <div
            role="tablist"
            aria-label="Example views"
            class="grid grid-cols-3 gap-1"
          >
            <button
              type="button"
              role="tab"
              id="tab-example-preview"
              aria-controls="panel-example-preview"
              aria-selected="true"
              data-example-tab="preview"
              data-active="true"
              class="group flex h-9 sm:h-8.5 cursor-pointer items-center justify-center gap-1.5 rounded-lg px-2.5 text-xs font-medium text-slate-600 transition-colors whitespace-nowrap hover:bg-white/60 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 data-[active=true]:bg-white data-[active=true]:font-semibold data-[active=true]:text-slate-950 data-[active=true]:shadow-xs data-[active=true]:hover:bg-white dark:text-slate-400 dark:hover:bg-slate-800/50 dark:hover:text-slate-100 dark:data-[active=true]:bg-[#0B0F17] dark:data-[active=true]:text-cyan-300 dark:data-[active=true]:hover:bg-[#0B0F17]"
            >
              <span>Preview</span>
              <span class="hidden sm:inline font-normal text-slate-400 group-data-[active=true]:text-slate-400 dark:text-slate-500 dark:group-data-[active=true]:text-cyan-400/70">
                · Live
              </span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-example-code"
              aria-controls="panel-example-code"
              aria-selected="false"
              tabindex="-1"
              data-example-tab="code"
              data-active="false"
              class="group flex h-9 sm:h-8.5 cursor-pointer items-center justify-center gap-1.5 rounded-lg px-2.5 text-xs font-medium text-slate-600 transition-colors whitespace-nowrap hover:bg-white/60 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 data-[active=true]:bg-white data-[active=true]:font-semibold data-[active=true]:text-slate-950 data-[active=true]:shadow-xs data-[active=true]:hover:bg-white dark:text-slate-400 dark:hover:bg-slate-800/50 dark:hover:text-slate-100 dark:data-[active=true]:bg-[#0B0F17] dark:data-[active=true]:text-cyan-300 dark:data-[active=true]:hover:bg-[#0B0F17]"
            >
              <span>Code</span>
              <span class="hidden sm:inline font-normal text-slate-400 group-data-[active=true]:text-slate-400 dark:text-slate-500 dark:group-data-[active=true]:text-cyan-400/70">
                · TSX
              </span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-example-dataset"
              aria-controls="panel-example-dataset"
              aria-selected="false"
              tabindex="-1"
              data-example-tab="dataset"
              data-active="false"
              class="group flex h-9 sm:h-8.5 cursor-pointer items-center justify-center gap-1.5 rounded-lg px-2.5 text-xs font-medium text-slate-600 transition-colors whitespace-nowrap hover:bg-white/60 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 data-[active=true]:bg-white data-[active=true]:font-semibold data-[active=true]:text-slate-950 data-[active=true]:shadow-xs data-[active=true]:hover:bg-white dark:text-slate-400 dark:hover:bg-slate-800/50 dark:hover:text-slate-100 dark:data-[active=true]:bg-[#0B0F17] dark:data-[active=true]:text-cyan-300 dark:data-[active=true]:hover:bg-[#0B0F17]"
            >
              <span>Dataset</span>
              <span class="hidden sm:inline font-normal text-slate-400 group-data-[active=true]:text-slate-400 dark:text-slate-500 dark:group-data-[active=true]:text-cyan-400/70">
                · JSON
              </span>
            </button>
          </div>
        </div>

      <!-- Panel 1: Interactive SimplexViz Preview -->
      <div
        role="tabpanel"
        id="panel-example-preview"
        aria-labelledby="tab-example-preview"
        data-example-panel="preview"
      >
        {isLargeCanvasWorkerExample ? (
          <LargeScaleCanvasWorkerAtlas embedded client:load />
        ) : (
          <UseCaseMiniAtlas
            datasetId={datasetId}
            meshStrategy={entry.data.meshStrategy}
            clusteringStrategy={entry.data.clusteringStrategy}
            colorStrategy={entry.data.colorStrategy}
            layoutStrategy={entry.data.layoutStrategy}
            zoomStrategy={entry.data.zoomStrategy}
            nodeView={entry.data.nodeView}
            thumbManifest={thumbManifest}
            timelineEnabled={entry.data.timelineEnabled}
            embedded
            client:load
          />
        )}
      </div>

      <!-- Panel 2: Minimalist TypeScript Code with Top-Right Copy Overlay -->
      <div
        role="tabpanel"
        id="panel-example-code"
        aria-labelledby="tab-example-code"
        data-example-panel="code"
        class="relative"
        hidden
      >
        <div class="pointer-events-none absolute top-3 right-4 z-20">
          <div class="pointer-events-auto rounded-md shadow-xs">
            <button
              type="button"
              data-copy-panel-source
              data-default-label="Copy Snippet"
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-700 dark:bg-[#0B0F17] dark:text-slate-200 dark:hover:bg-slate-800 whitespace-nowrap shrink-0"
            >
              <svg
                class="h-3.5 w-3.5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              <span data-copy-label>Copy Snippet</span>
            </button>
          </div>
        </div>

        <div class="[&_.astro-code]:h-[460px] sm:[&_.astro-code]:h-[540px] [&_.astro-code]:overflow-auto [&_.astro-code]:p-4 sm:[&_.astro-code]:p-5 [&_.astro-code]:pr-36 [&_.astro-code]:text-[13px] [&_.astro-code]:leading-relaxed">
          <Code
            code={codeSnippet}
            lang="tsx"
            themes={{ light: 'github-light', dark: 'github-dark-default' }}
          />
        </div>
      </div>

      <!-- Panel 3: Minimalist Raw Dataset JSON with Top-Right Copy Overlay -->
      <div
        role="tabpanel"
        id="panel-example-dataset"
        aria-labelledby="tab-example-dataset"
        data-example-panel="dataset"
        class="relative"
        hidden
      >
        <div class="pointer-events-none absolute top-3 right-4 z-20">
          <div class="pointer-events-auto rounded-md shadow-xs">
            <button
              type="button"
              data-copy-panel-source
              data-default-label="Copy Dataset"
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-700 dark:bg-[#0B0F17] dark:text-slate-200 dark:hover:bg-slate-800 whitespace-nowrap shrink-0"
            >
              <svg
                class="h-3.5 w-3.5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              <span data-copy-label>Copy Dataset</span>
            </button>
          </div>
        </div>

        <div class="[&_.astro-code]:h-[460px] sm:[&_.astro-code]:h-[540px] [&_.astro-code]:overflow-auto [&_.astro-code]:p-4 sm:[&_.astro-code]:p-5 [&_.astro-code]:pr-36 [&_.astro-code]:text-[13px] [&_.astro-code]:leading-relaxed">
          <Code
            code={datasetJson}
            lang="json"
            themes={{ light: 'github-light', dark: 'github-dark-default' }}
          />
        </div>
      </div>
      </section>
    </div>

    <!-- Concise Centered Architecture Rationale Below Workbench -->
    <article class="mx-auto mt-12 max-w-3xl">
      <div class="sv-prose">
        <Content />
      </div>

      <div class="mt-10 border-t border-slate-200/80 pt-6 flex items-center justify-between gap-4 text-xs dark:border-slate-800/80">
        <a
          href={withBase('/examples')}
          class="font-semibold text-slate-700 hover:text-cyan-700 hover:underline dark:text-slate-300 dark:hover:text-cyan-300 transition-colors"
        >
          ← Back to All Examples
        </a>
      </div>
    </article>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    function initExampleWorkbenches() {
      var roots = document.querySelectorAll('[data-example-workbench]');
      for (var i = 0; i < roots.length; i++) {
        var root = roots[i];
        if (root.getAttribute('data-workbench-ready') === 'true') continue;
        root.setAttribute('data-workbench-ready', 'true');

        (function (wb) {
          var tabs = Array.prototype.slice.call(
            wb.querySelectorAll('[data-example-tab]'),
          );
          var panels = Array.prototype.slice.call(
            wb.querySelectorAll('[data-example-panel]'),
          );

          function activateTab(targetName, focusTab) {
            for (var t = 0; t < tabs.length; t++) {
              var tab = tabs[t];
              var isMatch = tab.getAttribute('data-example-tab') === targetName;
              tab.setAttribute('data-active', isMatch ? 'true' : 'false');
              tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
              tab.setAttribute('tabindex', isMatch ? '0' : '-1');
              if (isMatch && focusTab) {
                tab.focus();
              }
            }
            for (var p = 0; p < panels.length; p++) {
              var panel = panels[p];
              var isPanelMatch =
                panel.getAttribute('data-example-panel') === targetName;
              if (isPanelMatch) {
                panel.removeAttribute('hidden');
              } else {
                panel.setAttribute('hidden', '');
              }
            }
            if (targetName === 'preview') {
              window.requestAnimationFrame(function () {
                window.dispatchEvent(new Event('resize'));
              });
            }
          }

          wb.addEventListener('click', function (ev) {
            var tabBtn =
              ev.target && ev.target.closest
                ? ev.target.closest('[data-example-tab]')
                : null;
            if (tabBtn) {
              var name = tabBtn.getAttribute('data-example-tab');
              if (name) activateTab(name, false);
              return;
            }

            var copyBtn =
              ev.target && ev.target.closest
                ? ev.target.closest('[data-copy-panel-source]')
                : null;
            if (copyBtn && navigator.clipboard) {
              var panel = copyBtn.closest('[data-example-panel]');
              var codeEl = panel ? panel.querySelector('pre code') : null;
              var rawText = codeEl ? codeEl.textContent : '';
              if (!rawText) return;
              var labelEl = copyBtn.querySelector('[data-copy-label]');
              var defaultLabel =
                copyBtn.getAttribute('data-default-label') || 'Copy';
              navigator.clipboard.writeText(rawText).then(function () {
                if (labelEl) {
                  labelEl.textContent = 'Copied ✓';
                  setTimeout(function () {
                    labelEl.textContent = defaultLabel;
                  }, 1500);
                }
              });
            }
          });

          wb.addEventListener('keydown', function (ev) {
            var currentTab =
              ev.target && ev.target.closest
                ? ev.target.closest('[data-example-tab]')
                : null;
            if (!currentTab) return;
            var idx = tabs.indexOf(currentTab);
            if (idx === -1) return;

            var nextIdx = -1;
            if (ev.key === 'ArrowRight') {
              nextIdx = (idx + 1) % tabs.length;
            } else if (ev.key === 'ArrowLeft') {
              nextIdx = (idx - 1 + tabs.length) % tabs.length;
            } else if (ev.key === 'Home') {
              nextIdx = 0;
            } else if (ev.key === 'End') {
              nextIdx = tabs.length - 1;
            }
            if (nextIdx !== -1) {
              ev.preventDefault();
              var nextName = tabs[nextIdx].getAttribute('data-example-tab');
              if (nextName) activateTab(nextName, true);
            }
          });
        })(root);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initExampleWorkbenches);
    } else {
      initExampleWorkbenches();
    }
    document.addEventListener('astro:page-load', initExampleWorkbenches);
  })();
</script>
