---
import { getCollection } from 'astro:content';
import {
  getDatasetItemCount,
  getDatasetSourceInfo,
} from '../../demo/data/multimodalCatalog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStrategySpec } from '../../site/strategies';
import { withBase } from '../../site/url';

const datasets = (await getCollection('datasets')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Interactive Examples"
  description="Explore six interactive SimplexViz examples built on real open-access datasets across tagged repositories, academic preprints, multi-modal cinema vectors, spoken vowel formants, animal trait kernels, and Antarctic morphometrics."
>
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Real Open-Access Datasets · Curated 5-Stage Pipelines
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
          Interactive Domain Examples
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
          Six real-world open datasets paired with their optimal mesh, clustering, OKLab color, collision layout, and drill-down strategies. Want to test your own tagged JSON dataset? Open the standalone{' '}
          <a
            href={withBase('/playground')}
            class="font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
          >
            Playground →
          </a>
        </p>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        datasets.map((ds) => {
          const itemCount = getDatasetItemCount(ds.data.datasetId);
          const source = getDatasetSourceInfo(ds.data.datasetId);
          const pipeline = [
            { stage: '01 Mesh', spec: getStrategySpec(ds.data.meshStrategy) },
            { stage: '02 Cluster', spec: getStrategySpec(ds.data.clusteringStrategy) },
            { stage: '03 Color', spec: getStrategySpec(ds.data.colorStrategy) },
            { stage: '04 Layout', spec: getStrategySpec(ds.data.layoutStrategy) },
            { stage: '05 Zoom', spec: getStrategySpec(ds.data.zoomStrategy) },
          ];
          return (
            <article class="flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-5 sm:p-6 dark:border-slate-800/90 dark:bg-[#0B0F17]">
              <div>
                <p class="text-xs text-slate-500 dark:text-slate-400 tabular-nums">
                  {ds.data.domainLabel} · {itemCount} items · {source.sourceShort}
                </p>

                <h2 class="mt-2 text-lg font-semibold leading-snug text-slate-950 dark:text-white [text-wrap:balance]">
                  <a
                    href={withBase(`/examples/${ds.id}`)}
                    class="hover:text-cyan-700 dark:hover:text-cyan-300 transition-colors"
                  >
                    {ds.data.title}
                  </a>
                </h2>

                <p class="mt-1.5 font-mono text-[11px] text-cyan-700 dark:text-cyan-400">
                  {ds.data.representationLabel} · {source.license}
                </p>

                <p class="mt-2.5 text-xs sm:text-[13px] leading-relaxed text-slate-600 dark:text-slate-300">
                  {ds.data.description}
                </p>

                <dl class="mt-5 space-y-1.5 border-t border-slate-200/70 pt-3.5 text-xs dark:border-slate-800/80">
                  {pipeline.map(({ stage, spec }) => (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="font-mono text-[11px] text-slate-500 dark:text-slate-400 shrink-0">
                        {stage}
                      </dt>
                      <dd class="font-medium text-right text-slate-900 dark:text-slate-100 truncate">
                        <a
                          href={withBase(spec.strategyDocPath)}
                          class="hover:text-cyan-700 hover:underline dark:hover:text-cyan-300 transition-colors"
                        >
                          {spec.name}
                        </a>
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>

              <div class="mt-5 border-t border-slate-200/70 pt-3.5 flex items-center justify-between gap-2 text-xs dark:border-slate-800/80">
                <a
                  href={withBase(`/examples/${ds.id}`)}
                  class="inline-flex items-center font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap"
                >
                  Open Example →
                </a>
                <span class="font-mono text-[11px] text-slate-400 dark:text-slate-500 tabular-nums">
                  {ds.data.readingMinutes} min read
                </span>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
