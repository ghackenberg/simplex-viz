---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NotePreviewCard from '../../components/NotePreviewCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../site/url';

const posts = (await getCollection('notes')).sort((a, b) =>
  b.data.publishedDate.localeCompare(a.data.publishedDate),
);
---

<BaseLayout
  title="Engineering & Research Notes"
  description="Technical deep dives by Dr. Georg Hackenberg on equilateral simplex triangulation, convex SAT collision physics, perceptual OKLab color science, and SimplexViz releases."
>
  <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
    <header class="mx-auto max-w-3xl text-center">
      <Breadcrumbs align="center" items={[{ label: 'Notes' }]} />

      <h1 class="text-3xl sm:text-4xl leading-[1.15] font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
        Engineering &amp; Research Notes
      </h1>
      <p class="mx-auto mt-3.5 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
        Deep dives into equilateral simplex triangulation, overlap-free convex SAT collision physics, perceptual OKLab color mixing, and SimplexViz release milestones. Want to follow new write-ups in your feed reader? Subscribe via the{' '}
        <a
          href={withBase('/rss.xml')}
          class="font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
        >
          RSS Feed →
        </a>
      </p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <NotePreviewCard post={post} headingTag="h2" />)}
    </div>
  </div>
</BaseLayout>
