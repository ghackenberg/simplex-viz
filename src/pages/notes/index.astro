---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../site/url';

const posts = (await getCollection('notes')).sort((a, b) =>
  b.data.publishedDate.localeCompare(a.data.publishedDate),
);
---

<BaseLayout
  title="Engineering & Research Notes"
  description="Technical deep dives by Dr. Georg Hackenberg on equilateral simplex triangulation, convex SAT collision physics, perceptual OKLab color science, and SimplexViz releases."
>
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Mathematical Derivations · Architecture &amp; Release Log
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
          Engineering &amp; Research Notes
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
          Deep dives into equilateral simplex triangulation, overlap-free convex SAT collision physics, perceptual OKLab color mixing, and SimplexViz release milestones. Want to follow new write-ups in your feed reader? Subscribe via the{' '}
          <a
            href={withBase('/rss.xml')}
            class="font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
          >
            RSS Feed →
          </a>
        </p>
      </div>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={withBase(`/notes/${post.id}`)}
            class="group flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-5 sm:p-6 transition-colors hover:border-cyan-500/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60"
          >
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400 tabular-nums">
                {post.data.publishedDate} · {post.data.readingMinutes} min read
              </p>
              <h2 class="mt-2 text-lg font-semibold leading-snug text-slate-950 group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-300 transition-colors [text-wrap:balance]">
                {post.data.title}
              </h2>
              <p class="mt-2.5 text-xs sm:text-[13px] leading-relaxed text-slate-600 dark:text-slate-300">
                {post.data.description}
              </p>
            </div>

            <div class="mt-5 flex items-center justify-between gap-2 border-t border-slate-200/70 pt-3.5 text-xs dark:border-slate-800/80">
              <span class="inline-flex items-center font-semibold text-cyan-700 group-hover:underline dark:text-cyan-300 whitespace-nowrap">
                Read note →
              </span>
              <span class="text-[11px] text-slate-400 dark:text-slate-500 truncate">
                {post.data.author}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
