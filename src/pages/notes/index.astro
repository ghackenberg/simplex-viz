---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_META, withBase } from '../../site/url';

const posts = (await getCollection('notes')).sort((a, b) =>
  b.data.publishedDate.localeCompare(a.data.publishedDate),
);
---

<BaseLayout
  title="Notes"
  description="Technical notes by Dr. Georg Hackenberg on simplex triangulation geometry, convex SAT collision physics, OKLab color science, and SimplexViz releases."
>
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <header>
      <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
        Engineering &amp; Research Log
      </p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-slate-950 dark:text-white">
        Notes
      </h1>
      <p class="mt-2.5 max-w-2xl text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
        Technical notes on equilateral simplex geometry, convex SAT layout guarantees, perceptual OKLab color mixing, and SimplexViz releases.
      </p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Main Chronological Notes Feed -->
      <div class="space-y-5 lg:col-span-8">
        {
          posts.map((post) => (
            <article class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-7 dark:border-slate-800/90 dark:bg-[#0B0F17]">
              <p class="text-xs text-slate-500 dark:text-slate-400 tabular-nums">
                {post.data.publishedDate} · {post.data.readingMinutes} min read · {post.data.author}
              </p>
              <h2 class="mt-2 text-xl sm:text-2xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
                <a
                  href={withBase(`/notes/${post.id}`)}
                  class="hover:text-cyan-700 dark:hover:text-cyan-300 transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2.5 max-w-[68ch] text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
                {post.data.description}
              </p>
              <p class="mt-5 text-xs font-semibold">
                <a
                  href={withBase(`/notes/${post.id}`)}
                  class="text-cyan-700 hover:underline dark:text-cyan-300"
                >
                  Read note →
                </a>
              </p>
            </article>
          ))
        }
      </div>

      <!-- Right Sidebar: Notes-Relevant Author & Archive Cards Only -->
      <aside class="space-y-6 lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
        <!-- Author & Editorial Scope -->
        <section class="rounded-xl border border-slate-200/90 bg-white p-5 dark:border-slate-800/90 dark:bg-[#0B0F17]">
          <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
            Author
          </p>
          <p class="mt-1 text-sm font-semibold text-slate-950 dark:text-white">
            <a
              href={SITE_META.authorUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cyan-700 hover:underline dark:hover:text-cyan-300 transition-colors"
            >
              {SITE_META.authorName}
            </a>
          </p>
          <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Professor of Industrial Informatics at Upper Austria University of Applied Sciences (FH OÖ Campus Wels).
          </p>
          <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            Design notes, mathematical derivations, and release logs accompanying the SimplexViz open-source project.
          </p>
          <a
            href={SITE_META.authorUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3.5 inline-block text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
          >
            hackenberg.tech ↗
          </a>
        </section>

        <!-- Chronological Archive & RSS Syndication -->
        <section class="rounded-xl border border-slate-200/90 bg-white p-5 dark:border-slate-800/90 dark:bg-[#0B0F17]">
          <div class="flex items-baseline justify-between gap-2">
            <p class="text-xs font-semibold text-slate-900 dark:text-slate-100">
              Archive ({posts.length})
            </p>
            <a
              href={withBase('/rss.xml')}
              class="font-mono text-[11px] font-semibold text-cyan-700 hover:underline dark:text-cyan-300"
            >
              RSS Feed (/rss.xml)
            </a>
          </div>
          <ul class="mt-3 divide-y divide-slate-200/70 text-xs dark:divide-slate-800/80">
            {
              posts.map((p) => (
                <li class="py-2.5 first:pt-0 last:pb-0">
                  <a href={withBase(`/notes/${p.id}`)} class="group block">
                    <span class="block font-mono text-[11px] text-slate-400 dark:text-slate-500 tabular-nums">
                      {p.data.publishedDate}
                    </span>
                    <span class="mt-0.5 block font-medium text-slate-800 group-hover:text-cyan-700 dark:text-slate-200 dark:group-hover:text-cyan-300 transition-colors [text-wrap:balance]">
                      {p.data.title}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
