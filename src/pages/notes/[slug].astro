---
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import PageMeta from '../../components/PageMeta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotePreviewSvg } from '../../site/notePreviews';
import { getNoteReadingMinutes } from '../../site/readingTime';
import { SITE_META, withBase } from '../../site/url';

export async function getStaticPaths() {
  const posts = (await getCollection('notes')).sort((a, b) =>
    b.data.publishedDate.localeCompare(a.data.publishedDate),
  );
  return posts.map((post, idx) => {
    getNotePreviewSvg(post.id);
    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost: idx < posts.length - 1 ? posts[idx + 1] : null,
        nextPost: idx > 0 ? posts[idx - 1] : null,
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

const notePreviewPath = `/notes/${post.id}.png`;
const notePreviewUrl = new URL(
  withBase(notePreviewPath),
  SITE_META.canonicalOrigin,
).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  image: notePreviewUrl,
  datePublished: post.data.publishedDate,
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: SITE_META.authorUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_META.name,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={notePreviewPath}
  ogImageAlt={`${post.data.title} — SimplexViz Engineering Note`}
  publishedTime={post.data.publishedDate}
  jsonLd={jsonLd}
>
  <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-3xl">
      <header class="text-center">
        <Breadcrumbs
          align="center"
          items={[
            { label: 'Notes', href: '/notes' },
            { label: post.data.title },
          ]}
        />

        <h1 class="text-3xl sm:text-4xl leading-[1.15] font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
          {post.data.title}
        </h1>
        <p class="mx-auto mt-3.5 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
          {post.data.description}
        </p>

        <PageMeta
          align="center"
          items={[
            {
              icon: 'author',
              label: post.data.author,
              href: SITE_META.authorUrl,
              external: true,
            },
            { icon: 'calendar', label: post.data.publishedDate, mono: true },
            {
              icon: 'clock',
              label: `${getNoteReadingMinutes(post)} min read`,
              mono: true,
            },
          ]}
          showCopyLink
        />
      </header>

      <article class="mt-8">
        <div class="mb-8">
          <KeyTakeaways points={post.data.summaryPoints} />
        </div>

        <div class="sv-prose overflow-x-hidden">
          <Content />
        </div>

        <nav
          aria-label="Note pagination"
          class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2"
        >
          {
            prevPost ? (
              <a
                href={withBase(`/notes/${prevPost.id}`)}
                class="group rounded-xl border border-slate-200/90 bg-white p-4 transition-colors hover:border-cyan-500/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60"
              >
                <span class="block text-xs text-slate-500 dark:text-slate-400">Older Note</span>
                <span class="mt-1 block text-sm font-semibold text-slate-950 group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-300 transition-colors [text-wrap:balance]">
                  ← {prevPost.data.title}
                </span>
              </a>
            ) : (
              <div />
            )
          }

          {
            nextPost && (
              <a
                href={withBase(`/notes/${nextPost.id}`)}
                class="group rounded-xl border border-slate-200/90 bg-white p-4 text-right transition-colors hover:border-cyan-500/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800/90 dark:bg-[#0B0F17] dark:hover:border-cyan-400/60"
              >
                <span class="block text-xs text-slate-500 dark:text-slate-400">Newer Note</span>
                <span class="mt-1 block text-sm font-semibold text-slate-950 group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-300 transition-colors [text-wrap:balance]">
                  {nextPost.data.title} →
                </span>
              </a>
            )
          }
        </nav>
      </article>
    </div>
  </div>
</BaseLayout>
