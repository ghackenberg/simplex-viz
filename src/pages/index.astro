---
import { getCollection } from 'astro:content';
import ExamplePreviewCard from '../components/ExamplePreviewCard.astro';
import HomePipelineShowcase from '../components/HomePipelineShowcase.astro';
import { HeroAtlasIsland } from '../components/islands/HeroAtlasIsland';
import NotePreviewCard from '../components/NotePreviewCard.astro';
import { buildCommonsThumbManifest } from '../demo/commonsThumbs.server';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_META, withBase } from '../site/url';

const thumbManifest = await buildCommonsThumbManifest(['media', 'zoo-species']);

const datasets = (await getCollection('datasets')).sort(
  (a, b) => a.data.order - b.data.order,
);

const latestNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.publishedDate.localeCompare(a.data.publishedDate))
  .slice(0, 3);

const installTargets = [
  {
    id: 'svg',
    label: 'SVG',
    shortCmd: 'npm install @simplex-viz/svg',
    fullCmd: 'npm install @simplex-viz/svg',
    hint: 'Vanilla TS · Vue · Svelte',
  },
  {
    id: 'core',
    label: 'Core',
    shortCmd: 'npm install @simplex-viz/core',
    fullCmd: 'npm install @simplex-viz/core',
    hint: 'Zero-dep · Headless SSR',
  },
  {
    id: 'react',
    label: 'React',
    shortCmd: 'npm install @simplex-viz/react',
    fullCmd: 'npm install @simplex-viz/react',
    hint: 'React 18 & 19 JSX',
  },
] as const;
---

<BaseLayout
  title={SITE_META.defaultTitle}
  description={SITE_META.defaultDescription}
>
  <!-- Section 1: Proportional 5:7 Product Showcase Hero -->
  <section class="relative overflow-hidden border-b border-slate-200/80 bg-white dark:border-slate-800/80 dark:bg-[#0B0F17]">
    <!-- Subtle Geometric Ambient Backdrop -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 overflow-hidden"
    >
      <div class="absolute -top-28 right-[12%] h-[420px] w-[540px] rounded-full bg-cyan-500/[0.06] blur-3xl dark:bg-cyan-400/[0.07]" />
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center lg:gap-10 xl:gap-12">
        <!-- Left 5 Cols: Editorial Typography, Primary CTAs & Sleek Terminal Bar -->
        <div class="mx-auto max-w-xl text-center lg:col-span-5 lg:mx-0 lg:max-w-none lg:text-left">
          <p class="font-mono text-xs font-medium tracking-wide text-cyan-700 dark:text-cyan-400">
            TypeScript · Zero-Dep Math · MIT
          </p>

          <h1 class="mt-3 text-[clamp(2rem,3.1vw,2.85rem)] leading-[1.07] font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
            Overlap-Free 60° Simplex Atlases.
          </h1>

          <p class="mt-3.5 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
            Project embeddings, pairwise similarities, or tagged records onto an equilateral mesh with perceptual OKLab color, 0.0 px collision layout, and conformal 1:4 zoom.
          </p>

          <!-- Primary Action Row -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <a
              href={withBase('/docs/quickstart')}
              class="inline-flex items-center gap-2 rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cyan-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:bg-cyan-400 dark:text-slate-950 dark:hover:bg-cyan-300"
            >
              <span>Get Started</span>
              <span aria-hidden="true">→</span>
            </a>
            <a
              href={withBase('/examples')}
              class="inline-flex items-center gap-2 rounded-lg border border-slate-200/90 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/70 dark:border-slate-800 dark:bg-[#0F1522] dark:text-slate-200 dark:hover:border-slate-700 dark:hover:bg-slate-800/80"
            >
              <span>Explore Examples</span>
            </a>
          </div>

          <!-- Compact Self-Contained Package Install Bar -->
          <div class="mx-auto mt-6 max-w-md overflow-hidden rounded-xl border border-slate-200/90 bg-slate-50/70 text-left lg:mx-0 lg:max-w-none dark:border-slate-800/90 dark:bg-[#07090E]">
            <div class="flex items-center justify-between gap-2 border-b border-slate-200/80 bg-slate-100/85 px-1.5 pt-1.5 dark:border-slate-800/80 dark:bg-[#0E131D]">
              <div role="tablist" aria-label="Choose package layer" class="flex items-center gap-0.5">
                {
                  installTargets.map((target, idx) => (
                    <button
                      type="button"
                      role="tab"
                      aria-selected={idx === 0 ? 'true' : 'false'}
                      data-install-tab={target.id}
                      data-short-cmd={target.shortCmd}
                      data-full-cmd={target.fullCmd}
                      data-install-hint={target.hint}
                      class:list={[
                        'cursor-pointer rounded-t-md px-3 py-1.5 text-xs transition-colors whitespace-nowrap',
                        idx === 0
                          ? 'bg-slate-50 text-slate-950 font-semibold dark:bg-[#07090E] dark:text-cyan-300'
                          : 'font-medium text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-slate-100',
                      ]}
                    >
                      {target.label}
                    </button>
                  ))
                }
              </div>

              <span
                id="sv-hero-install-hint"
                class="hidden sm:inline pr-2.5 pb-1 font-mono text-[11px] text-slate-400 dark:text-slate-500 truncate"
              >
                {installTargets[0].hint}
              </span>
            </div>

            <div class="flex items-center justify-between gap-3 px-3.5 py-2.5 font-mono text-xs text-slate-800 dark:text-slate-200">
              <div class="flex min-w-0 items-center gap-2">
                <span aria-hidden="true" class="text-slate-400 dark:text-slate-600 select-none">$</span>
                <span id="sv-hero-install-text" class="truncate">
                  {installTargets[0].shortCmd}
                </span>
              </div>
              <button
                type="button"
                id="sv-hero-copy-btn"
                data-copy-cmd={installTargets[0].fullCmd}
                class="cursor-pointer rounded px-2 py-0.5 font-sans text-xs font-semibold text-cyan-700 hover:bg-slate-200/70 dark:text-cyan-300 dark:hover:bg-slate-800 transition-colors whitespace-nowrap shrink-0"
              >
                Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Right 7 Cols: Live Interactive Simplex Atlas Instrument -->
        <div class="lg:col-span-7">
          <div class="rounded-2xl shadow-[0_18px_50px_-15px_rgba(8,145,178,0.12)] dark:shadow-[0_20px_60px_-15px_rgba(6,182,212,0.12)]">
            <HeroAtlasIsland thumbManifest={thumbManifest} client:load />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Scroll-Reactive 5-Stage Pipeline Showcase -->
  <HomePipelineShowcase />

  <!-- Section 3: Interactive Domain Examples (Real Open-Access Datasets) -->
  <section class="border-y border-slate-200/80 bg-white dark:border-slate-800/80 dark:bg-[#0B0F17]">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-xl">
          <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
            Real Open-Access Datasets
          </p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
            Explore six domain atlases directly in the browser
          </h2>
        </div>
        <div class="flex items-center gap-5 text-xs font-semibold shrink-0">
          <a
            href={withBase('/playground')}
            class="text-slate-600 hover:text-cyan-700 hover:underline dark:text-slate-300 dark:hover:text-cyan-300 whitespace-nowrap"
          >
            Custom JSON Playground →
          </a>
          <a
            href={withBase('/examples')}
            class="text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap"
          >
            All {datasets.length} examples →
          </a>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          datasets.map((ds) => (
            <ExamplePreviewCard
              dataset={ds}
              headingTag="h3"
              clampDescription
              surface="inset"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 4: Dedicated Latest Notes Section -->
  {
    latestNotes.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div class="max-w-xl">
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
              Latest Notes
            </p>
            <h2 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 dark:text-white [text-wrap:balance]">
              Engineering deep dives &amp; release updates
            </h2>
          </div>
          <a
            href={withBase('/notes')}
            class="text-xs font-semibold text-cyan-700 hover:underline dark:text-cyan-300 whitespace-nowrap shrink-0"
          >
            All notes →
          </a>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {latestNotes.map((note) => (
            <NotePreviewCard post={note} headingTag="h3" clampDescription />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script is:inline>
  (function () {
    var tabs = document.querySelectorAll('[data-install-tab]');
    var cmdText = document.getElementById('sv-hero-install-text');
    var copyBtn = document.getElementById('sv-hero-copy-btn');
    var hintEl = document.getElementById('sv-hero-install-hint');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var shortCmd = tab.getAttribute('data-short-cmd');
        var fullCmd = tab.getAttribute('data-full-cmd');
        var hint = tab.getAttribute('data-install-hint');
        if (cmdText && shortCmd) cmdText.textContent = shortCmd;
        if (copyBtn && fullCmd) copyBtn.setAttribute('data-copy-cmd', fullCmd);
        if (hintEl && hint) hintEl.textContent = hint;

        tabs.forEach(function (other) {
          var isSelected = other === tab;
          other.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          if (isSelected) {
            other.classList.add(
              'bg-slate-50',
              'text-slate-950',
              'font-semibold',
              'dark:bg-[#07090E]',
              'dark:text-cyan-300',
            );
            other.classList.remove(
              'font-medium',
              'text-slate-600',
              'hover:text-slate-950',
              'dark:text-slate-400',
              'dark:hover:text-slate-100',
            );
          } else {
            other.classList.remove(
              'bg-slate-50',
              'text-slate-950',
              'font-semibold',
              'dark:bg-[#07090E]',
              'dark:text-cyan-300',
            );
            other.classList.add(
              'font-medium',
              'text-slate-600',
              'hover:text-slate-950',
              'dark:text-slate-400',
              'dark:hover:text-slate-100',
            );
          }
        });
      });
    });

    document.addEventListener('click', function (ev) {
      var btn = ev.target && ev.target.closest ? ev.target.closest('[data-copy-cmd]') : null;
      if (!btn) return;
      var cmd = btn.getAttribute('data-copy-cmd');
      if (!cmd || !navigator.clipboard) return;
      navigator.clipboard.writeText(cmd).then(function () {
        var original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () {
          btn.textContent = original;
        }, 1400);
      });
    });
  })();
</script>
