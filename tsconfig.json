{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@simplex-viz/core": ["./packages/core/src/index.ts"],
      "@simplex-viz/svg": ["./packages/svg/src/index.ts"],
      "@simplex-viz/canvas": ["./packages/canvas/src/index.ts"],
      "@simplex-viz/react": ["./packages/react/src/index.ts"],
      "@simplex-viz/wc": ["./packages/wc/src/index.ts"],
      "@simplex-viz/wc/define": ["./packages/wc/src/define.ts"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "packages/svg/src",
    "packages/canvas/src",
    "packages/react/src",
    "packages/wc/src",
    "packages/core/src"
  ],
  "exclude": ["dist", "node_modules", "**/dist"]
}
