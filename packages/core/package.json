{
  "name": "@simplex-viz/core",
  "version": "0.8.0",
  "description": "Headless, zero-dependency 60-degree simplex mesh triangulation, representation-agnostic clustering (soft-simplex, embeddings, similarities, or tags), OKLab mixing, composable convex SAT layout solver, hierarchical 1:4 zoom/drill-down, chronological timeline playback, and interruptible spring engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "keywords": [
    "simplex",
    "triangulation",
    "visualization",
    "clustering",
    "embeddings",
    "zoom",
    "drill-down",
    "timeline",
    "convex-hull",
    "collision-detection",
    "oklab",
    "headless"
  ],
  "homepage": "https://hackenberg.tech/simplex-viz/",
  "bugs": {
    "url": "https://github.com/ghackenberg/simplex-viz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghackenberg/simplex-viz.git",
    "directory": "packages/core"
  }
}
