{
  "name": "@simplex-viz/core",
  "version": "0.1.0",
  "description": "Headless, zero-dependency 60-degree simplex mesh triangulation, tag clustering, OKLab mixing, convex SAT collision solver, and interruptible spring engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "keywords": [
    "simplex",
    "triangulation",
    "visualization",
    "clustering",
    "convex-hull",
    "collision-detection",
    "oklab",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghackenberg/simplex-viz.git",
    "directory": "packages/core"
  }
}
