{
  "name": "@simplex-viz/canvas",
  "version": "0.13.0",
  "description": "High-capacity HTML5 Canvas 2D renderer, viewport culling, LOD simplification, hierarchical 1:4 zoom/drill-down, chronological timeline playback, and native PNG export for @simplex-viz/core (2,000–10,000+ items at 60 FPS).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@simplex-viz/core": "workspace:^"
  },
  "keywords": [
    "simplex",
    "canvas",
    "canvas2d",
    "visualization",
    "dataviz",
    "high-capacity",
    "zoom",
    "drill-down",
    "timeline",
    "framework-agnostic"
  ],
  "homepage": "https://hackenberg.tech/simplex-viz/",
  "bugs": {
    "url": "https://github.com/ghackenberg/simplex-viz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghackenberg/simplex-viz.git",
    "directory": "packages/canvas"
  }
}
