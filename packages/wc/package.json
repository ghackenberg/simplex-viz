{
  "name": "@simplex-viz/wc",
  "version": "0.14.0",
  "description": "Framework-agnostic Web Component (<simplex-topic-graph>) with reactive HTML attributes, typed JS properties, standard DOM CustomEvents, and SSR-safe custom element registration for SimplexViz.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@simplex-viz/core": "workspace:^",
    "@simplex-viz/svg": "workspace:^"
  },
  "keywords": [
    "simplex",
    "web-components",
    "custom-elements",
    "svg",
    "visualization",
    "dataviz",
    "framework-agnostic",
    "vue",
    "svelte",
    "angular",
    "astro",
    "typescript"
  ],
  "homepage": "https://hackenberg.tech/simplex-viz/",
  "bugs": {
    "url": "https://github.com/ghackenberg/simplex-viz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghackenberg/simplex-viz.git",
    "directory": "packages/wc"
  }
}
